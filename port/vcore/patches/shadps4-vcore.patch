+static bool AdditionalOrderedReplayInputsSafe(const Shader::Info& cs, u32 additional_pass,
+    const auto& image_bindings, auto& texture_cache, const char** rejection = nullptr) {
+    const auto reject = [&](const char* reason) {
+        if (rejection) *rejection = reason;
+        return false;
+    };
+    const auto additional_kernel=Shader::DreamsCompat::AdditionalOrderedKernelFor(cs.pgm_hash);
+        if (cs.pgm_hash == Shader::DreamsCompat::QueueProducerShader) {
+            if ((cs.buffers.size()!=6 && cs.buffers.size()!=7) || !cs.images.empty() ||
+                cs.flattened_ud_buf.size()<=41 ||
+                std::ranges::any_of(std::span{cs.buffers}.first(5),[](const auto& b){return b.IsSpecial();}) ||
+                cs.buffers[5].buffer_type!=Shader::BufferType::GdsBuffer ||
+                (cs.buffers.size()==7 && cs.buffers[6].buffer_type!=Shader::BufferType::Flatbuf))
+                return reject("primary resource layout changed");
+            const u64 roots=cs.flattened_ud_buf[41];
+            if (!roots || cs.buffers[0].GetSharp(cs).GetSize()<12 ||
+                cs.buffers[1].GetSharp(cs).GetSize()<roots*8 ||
+                cs.buffers[2].GetSharp(cs).GetSize()<roots*432 ||
+                cs.buffers[3].GetSharp(cs).GetSize()<roots*200)
+                return reject("primary record bounds");
+        }
+
+        if (!Shader::DreamsCompat::UseAdditionalExactOrderedCountReplay(cs.pgm_hash))
+            return reject("additional-kernel disabled or not audited");
+        // Every guest input range must be disjoint from every guest output range. GDS and
+        // flattened scalar inputs have separately audited fixed addresses or immutable copies.
+        for (const auto& output : cs.buffers) {
+            if (output.IsSpecial() || !output.is_written) continue;
+            const auto dst = output.GetSharp(cs);
+            if (dst.base_address == 0 || dst.GetSize() == 0) return reject("invalid output descriptor");
+            for (const auto& input : cs.buffers) {
+                if (input.IsSpecial() || input.is_written) continue;
+                const auto in = input.GetSharp(cs);
+                if (in.base_address == 0 || in.GetSize() == 0) return reject("invalid input descriptor");
+                const u64 d = dst.base_address, b = in.base_address;
+                // 4bc's final input is a sixteen-word numeric table. Its raw descriptor
+                // intentionally advertises 0xffffffff bytes with stride zero; that is not
+                // its read footprint. The captured shader masks its only index with 15.
+                const bool short_numeric_table = cs.pgm_hash == 0x4bc902cf &&
+                    cs.buffers.size() == 10 && &input == &cs.buffers[7] && in.stride == 0;
+                const u64 input_bytes = short_numeric_table ? std::min<u64>(in.GetSize(), 64) : in.GetSize();
+                if (d < b ? dst.GetSize() > b - d : input_bytes > d - b)
+                    return reject("input/output buffer alias");
+            }
+        }
+        if (std::ranges::any_of(cs.images, [](const auto& image) { return image.is_written; })) {
+            return reject("written image");
+        }
+        for (const auto& [image_id, image_desc] : image_bindings) {
+            if (!image_id) return reject("unresolved image");
+            const auto& image = texture_cache.GetImage(image_id);
+            for (const auto& output : cs.buffers) {
+                if (output.IsSpecial() || !output.is_written) continue;
+                const auto dst = output.GetSharp(cs);
+                if (image.Overlaps(dst.base_address, dst.GetSize())) return reject("image/output buffer alias");
+            }
+        }
+        if (cs.pgm_hash == 0x4bc902cf || cs.pgm_hash == Shader::DreamsCompat::QueueProducerShader) {
+            u32 outputs=0;
+            for (const auto& first : cs.buffers) {
+                if (first.IsSpecial() || !first.is_written) continue;
+                ++outputs;
+                for (const auto& second : cs.buffers) {
+                    if (&first >= &second || second.IsSpecial() || !second.is_written) continue;
+                    const auto a=first.GetSharp(cs), b=second.GetSharp(cs);
+                    const u64 x=a.base_address,y=b.base_address;
+                    if (x<y ? a.GetSize()>y-x : b.GetSize()>x-y) return reject("stateful output/output alias");
+                }
+            }
+            if (outputs != 3) return reject("stateful output binding count");
+        }
+        if (additional_kernel.radix_pass &&
+            (cs.flattened_ud_buf.size() <= 24 || additional_pass >= 32))
+            return reject("radix pass out of range");
+        return true;
+}
