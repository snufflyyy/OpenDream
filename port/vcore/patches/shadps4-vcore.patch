diff --git a/src/video_core/renderer_vulkan/vk_indirect_clamp.cpp b/src/video_core/renderer_vulkan/vk_indirect_clamp.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..80800a2399feeccdc01c9c20f7d5d32ee2fea4b2
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_indirect_clamp.cpp
@@ -0,0 +1,266 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// vcore: clamp of GPU-supplied indirect arguments. See vk_indirect_clamp.h.
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+
+#include "common/logging/log.h"
+#include "video_core/buffer_cache/buffer.h"
+#include "video_core/host_shaders/vcore_indirect_clamp_comp.h"
+#include "video_core/renderer_vulkan/vk_indirect_clamp.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+#include "video_core/renderer_vulkan/vk_loop_guard.h"
+#include "video_core/renderer_vulkan/vk_platform.h"
+#include "video_core/renderer_vulkan/vk_shader_util.h"
+#include "shader_recompiler/loop_guard.h"
+
+namespace Vulkan::IndirectClamp {
+namespace {
+
+// Total workgroups of one indirect dispatch. A PS4 frame can't afford anywhere near this many
+// (4M workgroups = 268M invocations at 64 lanes); garbage arguments are usually far larger.
+constexpr u32 DefaultMaxGroups = 1u << 22;
+// Draws: vertices/indices per command, instances per command, and their product.
+constexpr u32 MaxElements = 1u << 26;
+constexpr u32 MaxInstances = 1u << 24;
+constexpr u32 MaxDrawTotal = 1u << 28;
+// The ring holds clamped copies; 4 MiB is hundreds of frames of indirect calls, far more than
+// the GPU can be behind, so a slot is never overwritten while a call may still read it.
+constexpr u64 RingBytes = 4ull << 20;
+constexpr u64 RingAlign = 64;
+
+struct PushData {
+    u64 src;
+    u64 dst;
+    u64 report;
+    u32 count;
+    u32 stride;
+    u32 mode;
+    u32 max_x;
+    u32 max_yz;
+    u32 max_total;
+    u32 max_elements;
+    u32 max_instances;
+    u32 tag_lo;
+    u32 tag_hi;
+};
+static_assert(sizeof(PushData) == 64);
+
+u32 EnvU32(const char* name, u32 fallback) {
+    const char* value = std::getenv(name);
+    if (value == nullptr || *value == '\0') {
+        return fallback;
+    }
+    char* end{};
+    const unsigned long long parsed = std::strtoull(value, &end, 0);
+    if (end == value) {
+        return fallback;
+    }
+    return static_cast<u32>(std::min<unsigned long long>(parsed, 0xffffffffull));
+}
+
+u32 MaxGroups() {
+    static const u32 value = std::max(EnvU32("VCORE_INDIRECT_MAX_GROUPS", DefaultMaxGroups), 1u);
+    return value;
+}
+
+} // Anonymous namespace
+
+bool Enabled() {
+    static const bool enabled = EnvU32("VCORE_INDIRECT_CLAMP", 1) != 0;
+    return enabled;
+}
+
+void PollReport(const volatile u32* words, std::array<u32, ReportDwords>& seen) {
+    // seen[0]/[4]: last count read; seen[1]/[5]: count at the last log line. Logs the first clamp
+    // and then whenever the total doubled, with the latest original arguments.
+    const auto due = [&](u32 count, u32 index) {
+        if (count == seen[index]) {
+            return false;
+        }
+        seen[index] = count;
+        if (seen[index + 1] != 0 && count < seen[index + 1] * 2) {
+            return false;
+        }
+        seen[index + 1] = count;
+        return true;
+    };
+    const u32 dispatches = words[0];
+    if (due(dispatches, 0)) {
+        LOG_ERROR(Render_Vulkan,
+                  "vcore indirect clamp: dispatch arguments {}x{}x{} of compute shader {:#x} "
+                  "clamped (max {} workgroups); {} clamped dispatches so far",
+                  words[1], words[2], words[3],
+                  static_cast<u64>(words[8]) | (static_cast<u64>(words[9]) << 32), MaxGroups(),
+                  dispatches);
+    }
+    const u32 draws = words[4];
+    if (due(draws, 4)) {
+        LOG_ERROR(Render_Vulkan,
+                  "vcore indirect clamp: {} draw arguments count={} instances={} (vs {:#x} fs {:#x}) "
+                  "clamped (max count {}, instances {}, product {}); {} clamped draws so far",
+                  words[7] == 2 ? "indexed" : "non-indexed", words[5], words[6], words[10],
+                  words[11], MaxElements, MaxInstances, MaxDrawTotal, draws);
+    }
+}
+
+void ClampHostDispatch(std::array<u32, 3>& dims) {
+    if (!Enabled()) {
+        return;
+    }
+    const u64 budget = MaxGroups();
+    const u64 total = u64{dims[0]} * dims[1] * dims[2];
+    if (total <= budget) {
+        return;
+    }
+    const auto original = dims;
+    dims[0] = static_cast<u32>(std::min<u64>(dims[0], budget));
+    dims[1] = static_cast<u32>(std::min<u64>(dims[1], std::max<u64>(budget / dims[0], 1)));
+    dims[2] = static_cast<u32>(
+        std::min<u64>(dims[2], std::max<u64>(budget / (u64{dims[0]} * dims[1]), 1)));
+    static bool logged{};
+    if (!logged) {
+        logged = true;
+        LOG_ERROR(Render_Vulkan,
+                  "vcore indirect clamp: host-read dispatch {}x{}x{} clamped to {}x{}x{}",
+                  original[0], original[1], original[2], dims[0], dims[1], dims[2]);
+    }
+}
+
+Pass::Pass(const Instance& instance_) : instance{instance_} {
+    if (!Enabled()) {
+        LOG_WARNING(Render_Vulkan, "vcore indirect clamp OFF (VCORE_INDIRECT_CLAMP=0)");
+        return;
+    }
+    if (!instance.IsBufferDeviceAddressSupported()) {
+        LOG_WARNING(Render_Vulkan, "vcore indirect clamp unavailable: no buffer device address");
+        return;
+    }
+    LoopGuard::Init(instance);
+    const auto device = instance.GetDevice();
+    const auto limits = instance.GetPhysicalDevice().getProperties().limits;
+    max_x = limits.maxComputeWorkGroupCount[0];
+    max_yz = std::min(limits.maxComputeWorkGroupCount[1], limits.maxComputeWorkGroupCount[2]);
+
+    ring = std::make_unique<VideoCore::Buffer>(instance, 0, RingBytes,
+                                               VideoCore::MemoryType::DeviceLocal,
+                                               "vcore indirect clamp ring");
+
+    const vk::PushConstantRange push_range{
+        .stageFlags = vk::ShaderStageFlagBits::eCompute,
+        .offset = 0,
+        .size = sizeof(PushData),
+    };
+    layout = Check(device.createPipelineLayoutUnique(vk::PipelineLayoutCreateInfo{
+        .pushConstantRangeCount = 1,
+        .pPushConstantRanges = &push_range,
+    }));
+    const auto module = CompileSPV(VCORE_INDIRECT_CLAMP_COMP, device);
+    pipeline = Check(device.createComputePipelineUnique(
+        {}, vk::ComputePipelineCreateInfo{
+                .stage =
+                    vk::PipelineShaderStageCreateInfo{
+                        .stage = vk::ShaderStageFlagBits::eCompute,
+                        .module = module,
+                        .pName = "main",
+                    },
+                .layout = *layout,
+            }));
+    device.destroyShaderModule(module);
+    SetObjectName(device, *pipeline, "vcore indirect clamp");
+    ready = true;
+    LOG_WARNING(Render_Vulkan,
+                "vcore indirect clamp ON: dispatch <= {} workgroups (x <= {}, y/z <= {}); draw "
+                "count <= {}, instances <= {}, product <= {}",
+                MaxGroups(), max_x, max_yz, MaxElements, MaxInstances, MaxDrawTotal);
+}
+
+Pass::~Pass() = default;
+
+bool DrawExceedsLimits(u32 elements, u32 instances) {
+    return elements > MaxElements || instances > MaxInstances ||
+           u64{elements} * u64{instances} > MaxDrawTotal;
+}
+
+u32 DrawAttributeBudget() {
+    static const u32 value = EnvU32("VCORE_INDIRECT_DRAW_ATTRIBUTE", 0);
+    return value;
+}
+
+Pass& Shared(const Instance& instance) {
+    static Pass* const pass = new Pass(instance);
+    return *pass;
+}
+
+std::pair<vk::Buffer, vk::DeviceSize> Pass::Dispatch(vk::CommandBuffer cmdbuf,
+                                                     const VideoCore::Buffer* src, u64 offset,
+                                                     u64 tag) {
+    return Run(cmdbuf, src, offset, 1, 3 * sizeof(u32), 0, tag);
+}
+
+std::pair<vk::Buffer, vk::DeviceSize> Pass::Draw(vk::CommandBuffer cmdbuf,
+                                                 const VideoCore::Buffer* src, u64 offset,
+                                                 u32 count, u32 stride, bool indexed, u64 tag) {
+    return Run(cmdbuf, src, offset, count, stride, indexed ? 2 : 1, tag);
+}
+
+std::pair<vk::Buffer, vk::DeviceSize> Pass::Run(vk::CommandBuffer cmdbuf,
+                                                const VideoCore::Buffer* src, u64 offset,
+                                                u32 count, u32 stride, u32 mode, u64 tag) {
+    const std::pair<vk::Buffer, vk::DeviceSize> passthrough{src->Handle(), offset};
+    const u64 bytes = static_cast<u64>(count) * stride;
+    if (!ready || count == 0 || stride < 3 * sizeof(u32) || (stride & 3) != 0 ||
+        src->buffer.bda_addr == 0 || bytes > RingBytes / 4) {
+        return passthrough;
+    }
+    if (ring_head + bytes > RingBytes) {
+        ring_head = 0;
+    }
+    const u64 dst_offset = ring_head;
+    ring_head = (ring_head + bytes + RingAlign - 1) & ~(RingAlign - 1);
+
+    // Earlier GPU work (shader stores, copies, fills) wrote the arguments, and earlier indirect
+    // calls may still read this ring slot.
+    const vk::MemoryBarrier2 before{
+        .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .srcAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+        .dstStageMask = vk::PipelineStageFlagBits2::eComputeShader,
+        .dstAccessMask =
+            vk::AccessFlagBits2::eShaderStorageRead | vk::AccessFlagBits2::eShaderStorageWrite,
+    };
+    cmdbuf.pipelineBarrier2(vk::DependencyInfo{.memoryBarrierCount = 1, .pMemoryBarriers = &before});
+
+    const u64 report = LoopGuard::ReportAddress();
+    const PushData push{
+        .src = src->buffer.bda_addr + offset,
+        .dst = ring->BufferDeviceAddress() + dst_offset,
+        .report = report != 0 ? report + Shader::LoopGuard::IndirectReportOffset : 0,
+        .count = count,
+        .stride = stride,
+        .mode = mode,
+        .max_x = max_x,
+        .max_yz = max_yz,
+        .max_total = mode == 0 ? MaxGroups() : MaxDrawTotal,
+        .max_elements = MaxElements,
+        .max_instances = MaxInstances,
+        .tag_lo = static_cast<u32>(tag),
+        .tag_hi = static_cast<u32>(tag >> 32),
+    };
+    cmdbuf.bindPipeline(vk::PipelineBindPoint::eCompute, *pipeline);
+    cmdbuf.pushConstants(*layout, vk::ShaderStageFlagBits::eCompute, 0, sizeof(push), &push);
+    cmdbuf.dispatch((count + 63) / 64, 1, 1);
+
+    const vk::MemoryBarrier2 after{
+        .srcStageMask = vk::PipelineStageFlagBits2::eComputeShader,
+        .srcAccessMask = vk::AccessFlagBits2::eShaderStorageWrite,
+        .dstStageMask = vk::PipelineStageFlagBits2::eDrawIndirect,
+        .dstAccessMask = vk::AccessFlagBits2::eIndirectCommandRead,
+    };
+    cmdbuf.pipelineBarrier2(vk::DependencyInfo{.memoryBarrierCount = 1, .pMemoryBarriers = &after});
+    return {ring->Handle(), dst_offset};
+}
+
+} // namespace Vulkan::IndirectClamp
