+// DREAMS-REBASE: AppendDreamsIndirectArgumentBarrier removed; Runtime tracks the indirect read
+// and aliased shader accesses as byte-range hazards.
+
+void Rasterizer::DispatchIndirect(VAddr address, u32 offset, u32 size) {
+    const auto previous_linear_context = DreamsLinearWrites::current;
+    SCOPE_EXIT { DreamsLinearWrites::current = previous_linear_context; };
+    DreamsLinearWrites::current = {};
+
+    RENDERER_TRACE;
+
+    FlushPeriodically();
+    scheduler.PopPendingOperations();
+
+    const auto& cs_program = liverpool->GetCsRegs();
+    const ComputePipeline* pipeline = pipeline_cache.GetComputePipeline();
+    if (!pipeline) {
+        return;
