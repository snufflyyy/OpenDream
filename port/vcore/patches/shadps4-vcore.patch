+
+void TextureCache::DumpImagesLinear(std::span<const LinearImageDump> dumps) {
+    // Dreams fork diagnostics: download several images linearly, waiting for the GPU once.
+    struct PendingDump {
+        Vulkan::StagingBufferRef download;
+        u64 size;
+        std::filesystem::path path;
+    };
+    std::vector<PendingDump> pending;
+    pending.reserve(dumps.size());
+    for (const auto& dump : dumps) {
+        if (!dump.image_id) {
+            continue;
+        }
+        Image& image = slot_images[dump.image_id];
+        const u32 block = image.info.props.is_block ? 4 : 1;
+        const u32 row_length = Common::AlignUp(image.info.pitch, block);
+        const u32 image_height = Common::AlignUp(image.info.size.height, block);
+        const u64 linear_size = static_cast<u64>(row_length / block) * (image_height / block) *
+                                image.info.size.depth * image.info.resources.layers *
+                                (image.info.num_bits / 8);
+        if (linear_size == 0) {
+            LOG_ERROR(Render_Vulkan, "Cannot dump linear image id={} size={:#x}",
+                      dump.image_id.index, linear_size);
+            continue;
+        }
+        const auto download =
+            runtime.GetStagingPool().Request(linear_size, MemoryType::HostCached, 16, true);
+        const std::array image_download{vk::BufferImageCopy{
+            .bufferOffset = download.offset,
+            .bufferRowLength = row_length,
+            .bufferImageHeight = image_height,
+            .imageSubresource =
+                {
+                    .aspectMask = image.info.props.is_depth ? vk::ImageAspectFlagBits::eDepth
+                                                            : vk::ImageAspectFlagBits::eColor,
+                    .mipLevel = 0,
+                    .baseArrayLayer = 0,
+                    .layerCount = image.info.resources.layers,
+                },
+            .imageOffset = {0, 0, 0},
+            .imageExtent = {image.info.size.width, image.info.size.height, image.info.size.depth},
+        }};
+        runtime.DownloadImage(&image, download.buffer, image_download);
+        pending.push_back({download, linear_size, dump.path});
+    }
+    if (pending.empty()) {
+        return;
+    }
+    runtime.FlushBarriers();
+    scheduler.Finish();
+    for (const auto& dump : pending) {
+        dump.download.Invalidate();
+        std::ofstream stream{dump.path, std::ios::binary | std::ios::trunc};
+        if (!stream) {
+            LOG_ERROR(Render_Vulkan, "Failed to open linear image dump {}", dump.path.string());
+        } else {
+            stream.write(reinterpret_cast<const char*>(dump.download.mapped), dump.size);
+        }
+        runtime.GetStagingPool().FreeDeferred(dump.download);
+    }
+}
