+#pragma once
+#include <algorithm>
+#include <vector>
+#include "shader_recompiler/resource.h"
+#include "video_core/texture_cache/image_info.h"
+
+namespace VideoCore::DreamsPartialRawClear {
+template<class Buffers> inline bool BindingSet(const Buffers& buffers) {
+    return buffers.size()==3 && buffers[0].buffer_type==Shader::BufferType::Guest &&
+        buffers[0].is_written && !buffers[0].is_formatted &&
+        buffers[1].buffer_type==Shader::BufferType::Guest &&
+        !buffers[1].is_written && !buffers[1].is_formatted &&
+        buffers[2].buffer_type==Shader::BufferType::Flatbuf && !buffers[2].is_written;
+}
+// This path handles a complete, dword shader clear of an aligned pixel prefix.
+// Unsupported layouts retain the existing synchronization path.
+inline std::vector<vk::BufferImageCopy> Plan(const ImageInfo& info, u64 bytes) {
+    if (!bytes || bytes > 65536 || bytes % 8 || bytes >= info.guest_size ||
+        info.pixel_format != vk::Format::eR16G16B16A16Sfloat || info.num_bits != 64 ||
+        info.num_samples != 1 || info.resources.levels != 1 || info.resources.layers != 1 ||
+        info.size.depth != 1 || info.props.is_volume || info.props.is_block ||
+        info.props.is_depth || info.props.has_stencil || info.alt_tile || info.bank_swizzle ||
+        !info.size.width || !info.size.height) return {};
+    const auto& mip = info.mips_layout[0];
+    if (mip.offset || mip.pitch < info.size.width || mip.height < info.size.height ||
+        mip.size != info.guest_size || u64(mip.pitch)*mip.height*8 != info.guest_size) return {};
+    const bool linear = !info.props.is_tiled &&
+        info.tile_mode == AmdGpu::TileMode::DisplayLinearAligned;
+    const bool macro = info.props.is_tiled && info.tile_mode == AmdGpu::TileMode::Thin2DThin &&
+        info.array_mode == AmdGpu::ArrayMode::Array2DTiledThin1 &&
+        mip.pitch % 128 == 0 && mip.height % 64 == 0;
+    if (!linear && !macro) return {};
+    std::vector<vk::BufferImageCopy> copies;
+    // A 64 KiB prefix occupies only the first 128x64 macrotile for this layout.
+    const u32 width = macro ? std::min(info.size.width,128u) : info.size.width;
+    const u32 height = macro ? std::min(info.size.height,64u) :
+        std::min(info.size.height,u32((bytes/8+mip.pitch-1)/mip.pitch));
+    for(u32 y=0;y<height;++y) for(u32 x=0;x<width;++x) {
+        u64 offset = (u64(y)*mip.pitch+x)*8;
+        if(macro) {
+            const u32 micro=(x&1)|((y&1)<<1)|((x&2)<<1)|((y&2)<<2)|((x&4)<<2)|((y&4)<<3);
+            const u32 pipe=((x>>3 ^ y>>3 ^ x>>4)&1) |
+                (((x>>4 ^ y>>4)&1)<<1) | (((x>>5 ^ y>>5)&1)<<2);
+            const u32 tx=x/64,ty=y/8;
+            const u32 bank=((tx ^ ty>>3)&1) | (((tx>>1 ^ ty>>2 ^ ty>>3)&1)<<1) |
+                (((tx>>2 ^ ty>>1)&1)<<2) | (((tx>>3 ^ ty)&1)<<3);
+            const u32 element=micro*8;
+            offset=(element&255)|(pipe<<8)|(bank<<11)|((element>>8)<<15);
+        }
+        if(offset+8>bytes) continue;
+        if(!copies.empty()) {
+            auto& last=copies.back();
+            if(last.imageOffset.y==s32(y) && last.imageOffset.x+s32(last.imageExtent.width)==s32(x) &&
+                last.bufferOffset+u64(last.imageExtent.width)*8==offset) {
+                ++last.imageExtent.width;continue;
+            }
+        }
+        copies.push_back(vk::BufferImageCopy{
+            .bufferOffset=offset,
+            .imageSubresource={vk::ImageAspectFlagBits::eColor,0,0,1},
+            .imageOffset={s32(x),s32(y),0},.imageExtent={1,1,1}});
+    }
+    return copies;
+}
+struct Job {ImageId id;u64 uid;std::vector<vk::BufferImageCopy> copies;};
+struct Context {VAddr address{};u64 bytes{};std::vector<Job> jobs;};
+inline thread_local const Context* current{};
+inline u64 applied_images{},applied_bytes{},fallback_images{};
+} // namespace VideoCore::DreamsPartialRawClear
