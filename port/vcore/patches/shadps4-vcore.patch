+            indexed_files.push_back(it->path());
+        }
+        std::ranges::sort(indexed_files, {},
+                          [](const auto& path) { return path.filename().generic_string(); });
+        std::string file_index = "file\tsize\thash\n";
+        bool file_index_ok = !index_error;
+        for (const auto& path : indexed_files) {
+            std::ifstream input(path, std::ios::binary | std::ios::ate);
+            const auto end = input ? input.tellg() : std::streampos{-1};
+            if (end < 0) {
+                file_index_ok = false;
+                break;
+            }
+            const u64 size = static_cast<u64>(end);
+            std::vector<u8> contents(static_cast<size_t>(size));
+            input.seekg(0, std::ios::beg);
+            if (size != 0) {
+                input.read(reinterpret_cast<char*>(contents.data()),
+                           static_cast<std::streamsize>(size));
+            }
+            if (!input) {
+                file_index_ok = false;
+                break;
+            }
+            file_index += fmt::format("{}\t{}\t{:#x}\n", path.filename().generic_string(), size,
+                                      HashDreamsTraceBytes(contents));
+        }
+        const u64 aggregate_sorted_hash = HashDreamsTraceBytes(
+            std::span<const u8>{reinterpret_cast<const u8*>(file_index.data()), file_index.size()});
+        file_index_ok &= WriteDreamsCaptureText(
+            dreams_vs370_pending_capture.occurrence_directory / "files.tsv", file_index);
+        file_index_ok &= AppendDreamsCaptureText(
+            dreams_vs370_pending_capture.occurrence_directory / "manifest.tsv",
+            fmt::format("file_index_entries\t{}\nfiles_tsv_bytes\t{}\nhash_files.tsv\t{:#x}\n"
+                        "aggregate_sorted_hash\t{:#x}\n",
+                        indexed_files.size(), file_index.size(), aggregate_sorted_hash,
+                        aggregate_sorted_hash));
+        files_ok &= file_index_ok;
+
+        auto& capture = g_dreams_vs370_interface_capture;
+        const u32 ordinal = dreams_vs370_pending_capture.ordinal;
+        capture.interface_hashes[ordinal] = interface_hash;
+        capture.validity_complete[ordinal] = invalid_vertices == 0;
+        if (ordinal == 0) {
+            std::ofstream summary(dreams_vs370_pending_capture.output_directory / "summary.tsv",
+                                  std::ios::trunc);
+            summary << "occurrence\tgroup\tinstances\tvs_input_hash\t"
+                       "captured_pipeline_hash\tfixture_hash\tinterface_hash\t"
+                       "validity_hash\tvalidity_complete\tproducer_sequence\tproducer_hash\n";
+            files_ok &= static_cast<bool>(summary);
+        }
+        files_ok &= AppendDreamsCaptureText(
+            dreams_vs370_pending_capture.output_directory / "summary.tsv",
+            fmt::format("{}\t{}\t{}\t{:#x}\t{:#x}\t{:#x}\t{:#x}\t{:#x}\t{}\t{}\t{:#x}\n", ordinal,
+                        dreams_vs370_pending_capture.group, instances,
+                        dreams_vs370_pending_capture.input_hash,
+                        dreams_vs370_pending_capture.captured_pipeline_hash,
+                        dreams_vs370_pending_capture.fixture_hash, interface_hash, validity_hash,
+                        invalid_vertices == 0, dreams_vs370_pending_capture.producer_sequence,
+                        dreams_vs370_pending_capture.producer_hash));
+
+        if (!files_ok) {
+            capture.failed = true;
+            capture.armed = false;
+            LOG_ERROR(Render_Vulkan,
+                      "Dreams VS370 interface capture stopped because output could not be saved");
+        } else {
+            ++capture.captured;
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams VS370 interface capture {}/{} group={} instances={} "
+                        "vs_input_hash={:#x} interface_hash={:#x} validity_complete={} "
+                        "invalid_vertices={} first_invalid={}:{} mask={:#x}",
+                        capture.captured, DreamsVs370InterfaceCaptureOccurrences,
+                        dreams_vs370_pending_capture.group, instances,
+                        dreams_vs370_pending_capture.input_hash, interface_hash,
+                        invalid_vertices == 0, invalid_vertices, first_invalid_instance,
+                        first_invalid_vertex, first_invalid_mask);
+        }
+
+        if (!capture.failed && capture.captured == DreamsVs370InterfaceCaptureOccurrences) {
+            capture.armed = false;
+            capture.complete = true;
+            bool parity_valid = capture.group_count == 1;
+            for (u32 index = 1; index < capture.captured; ++index) {
+                parity_valid &= capture.pass_keys[index] != capture.pass_keys[index - 1];
+                if (index >= 2) {
+                    parity_valid &= capture.pass_keys[index] == capture.pass_keys[index - 2];
+                }
+            }
+
+            std::string analysis;
+            analysis += "key\tvalue\n";
+            analysis += fmt::format("schema\t1\ncaptures\t{}\ngroups\t{}\nparity_valid\t{}\n",
+                                    capture.captured, capture.group_count, parity_valid);
+            for (u32 group = 0; group < capture.group_count; ++group) {
+                u32 first = std::numeric_limits<u32>::max();
+                bool inputs_stable = true;
+                bool interface_stable = true;
+                bool validity_complete = true;
+                u32 members{};
+                for (u32 index = 0; index < capture.captured; ++index) {
+                    if (capture.pass_groups[index] != group) {
+                        continue;
+                    }
+                    ++members;
+                    validity_complete &= capture.validity_complete[index];
+                    if (first == std::numeric_limits<u32>::max()) {
+                        first = index;
+                    } else {
+                        inputs_stable &= capture.input_hashes[index] == capture.input_hashes[first];
+                        interface_stable &=
+                            capture.interface_hashes[index] == capture.interface_hashes[first];
+                    }
+                }
+                const std::string_view classification =
+                    members < 2
+                        ? "insufficient_repeats"
+                        : (!validity_complete
+                               ? "capture_incomplete"
+                               : (!inputs_stable ? "requires_record_aligned_comparison"
+                                                 : (!interface_stable ? "vs_output_nondeterministic"
+                                                                      : "vs_boundary_stable")));
+                analysis += fmt::format("group_{}\tmembers={};inputs_stable={};interface_stable={};"
+                                        "validity_complete={};classification={}\n",
+                                        group, members, inputs_stable, interface_stable,
+                                        validity_complete, classification);
+            }
+            WriteDreamsCaptureText(dreams_vs370_pending_capture.output_directory / "analysis.tsv",
+                                   analysis);
+            WriteDreamsCaptureText(
+                dreams_vs370_pending_capture.output_directory / "complete.txt",
+                "One exact nonzero sculpt draw captured. The offline replay bundle is ready.\n");
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams VS370 interface capture complete captures={} groups={} "
+                        "parity_valid={} directory={}",
+                        capture.captured, capture.group_count, parity_valid,
+                        dreams_vs370_pending_capture.output_directory.string());
+        }
+    }
+
+    if (gpu_profile_ordinal != 0) {
+        scheduler.Finish();
+        u64 vertex_hash{};
+        u64 fragment_hash{};
+        for (const auto* shader : pipeline->GetStages()) {
+            if (shader == nullptr) {
+                continue;
+            }
+            if (shader->sw_stage == Shader::SwStage::Vertex) {
+                vertex_hash = shader->pgm_hash;
+            } else if (shader->sw_stage == Shader::SwStage::Fragment) {
+                fragment_hash = shader->pgm_hash;
+            }
+        }
+        const auto elapsed = std::chrono::duration<double, std::milli>(
+                                 std::chrono::steady_clock::now() - gpu_profile_start)
+                                 .count();
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams GPU profile #{} kind=draw-indirect indexed={} vs={:#x} fs={:#x} "
+                    "max_count={} stride={} elapsed={:.3f}ms",
+                    gpu_profile_ordinal, is_indexed, vertex_hash, fragment_hash, max_count, stride,
+                    elapsed);
+    }
+
+    if (trace_dreams_paint_visibility_indirect) {
+        dump_dreams_paint_visibility_target("after");
+    }
+
+    const bool dreams_visibility_draw =
+        dreams_fragment_hash == 0x2b6d3647 || dreams_fragment_hash == 0xce3b8413;
+    if (dreams_visibility_dump_dir && dreams_visibility_draw &&
+        ++dreams_visibility_dump_draw_count == 3) {
+        const auto dump_target = [&](std::string_view role, VideoCore::ImageId image_id) {
+            if (!image_id) {
+                return;
+            }
+            const auto& image = texture_cache.GetImage(image_id);
+            const auto file =
+                *dreams_visibility_dump_dir /
+                fmt::format("frame{:02}-{}-{:#x}-{}x{}-pitch{}-bits{}.bin",
+                            dreams_visibility_dump_frame_index, role, image.info.guest_address,
+                            image.info.size.width, image.info.size.height, image.info.pitch,
+                            image.info.num_bits);
+            texture_cache.DumpImageLinear(image_id, file);
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams visibility target dumped frame={} role={} id={} guest={:#x} "
+                        "extent={}x{} pitch={} bits={} file={}",
+                        dreams_visibility_dump_frame_index, role, image_id.index,
+                        image.info.guest_address, image.info.size.width, image.info.size.height,
+                        image.info.pitch, image.info.num_bits, file.string());
+        };
+        dump_target("color", cb_descs[0].image_id);
+        dump_target("depth", db_desc.image_id);
+        ++dreams_visibility_dump_frame_index;
+        if (--dreams_visibility_dump_frames_remaining == 0) {
+            dreams_visibility_dump_dir.reset();
+        }
+    }
+
+    CaptureDreamsFramePost();
+    ResetBindings(false);
+}
