+struct DreamsSculptDocCounterSnapshot {
+    bool mapped{};
+    std::array<u32, Shader::DreamsCompat::TraversalOrderedDocCount> b535{};
+    std::array<u32, Shader::DreamsCompat::VisibilityCandidateOrderedPassCount> d8{};
+    std::array<u32, Shader::DreamsCompat::VisibilityListOrderedCounterIndices.size()> list_7aa{};
