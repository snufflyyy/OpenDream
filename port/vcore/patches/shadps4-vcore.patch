+void TextureCache::ApplyDreamsPartialRawClear(const DreamsPartialRawClear::Context& context,
+                                              vk::Buffer source, u64 source_offset) {
+    scheduler.EndRendering();
+    runtime.FlushBarriers();
+    const auto command = scheduler.CommandBuffer();
+    const vk::BufferMemoryBarrier2 before{
+        .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .srcAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+        .dstStageMask = vk::PipelineStageFlagBits2::eCopy,
+        .dstAccessMask = vk::AccessFlagBits2::eTransferRead,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .buffer = source,
+        .offset = source_offset,
+        .size = context.bytes,
+    };
+    command.pipelineBarrier2(vk::DependencyInfo{
+        .bufferMemoryBarrierCount = 1,
+        .pBufferMemoryBarriers = &before,
+    });
+    // Re-enumeration checks live image identity rather than dereferencing a retired slot.
+    ForEachImageInRegion(context.address, 1, [&](ImageId id, Image& image) {
+        for (const auto& job : context.jobs) {
+            if (job.id != id || job.uid != image.image_uid) {
+                continue;
+            }
+            if (!image.HasGpuValidData() || image.backing->num_samples != 1) {
+                image.flags |= ImageFlagBits::GpuDirty;
+                ++DreamsPartialRawClear::fallback_images;
+                return;
+            }
+            auto copies = job.copies;
+            for (auto& copy : copies) {
+                copy.bufferOffset += source_offset;
+            }
+            if (runtime.Transit(&image, vk::ImageLayout::eTransferDstOptimal,
+                                vk::PipelineStageFlagBits2::eCopy,
+                                vk::AccessFlagBits2::eTransferWrite)) {
+                runtime.FlushBarriers();
+            }
+            command.copyBufferToImage(source, image.GetImage(),
+                                      vk::ImageLayout::eTransferDstOptimal, copies);
+            ++DreamsPartialRawClear::applied_images;
+            DreamsPartialRawClear::applied_bytes += context.bytes;
+            if (DreamsPartialRawClear::applied_images <= 8) {
+                LOG_WARNING(Render_Vulkan,
+                            "Dreams bounded partial clear: image={} bytes={} regions={} total={}",
+                            image.image_uid, context.bytes, copies.size(),
+                            DreamsPartialRawClear::applied_images);
+            }
+            return;
+        }
+    });
+    const vk::BufferMemoryBarrier2 after{
+        .srcStageMask = vk::PipelineStageFlagBits2::eCopy,
+        .srcAccessMask = vk::AccessFlagBits2::eTransferRead,
+        .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .buffer = source,
+        .offset = source_offset,
+        .size = context.bytes,
+    };
+    command.pipelineBarrier2(vk::DependencyInfo{
+        .bufferMemoryBarrierCount = 1,
+        .pBufferMemoryBarriers = &after,
+    });
 }
 
