+static bool FinalizeDreamsQueueProducerCapture() {
+    auto& capture = g_dreams_ordered_chain_capture;
+    if (!capture.producer_valid || capture.directory.empty()) {
+        return false;
+    }
+
+    std::error_code request_error;
+    const bool consumed =
+        std::filesystem::remove(capture.directory / "producer.request", request_error);
+    if (request_error || !consumed) {
+        LOG_ERROR(Render_Vulkan, "Dreams 2bf producer capture request could not be consumed: {}",
+                  request_error ? request_error.message() : "request was absent");
+        return false;
+    }
+
+    const std::filesystem::path output = capture.directory / "producer";
+    std::error_code directory_error;
+    std::filesystem::create_directories(output, directory_error);
+    if (directory_error) {
+        LOG_ERROR(Render_Vulkan, "Dreams 2bf producer capture directory failed: {}",
+                  directory_error.message());
+        return false;
+    }
+
+    const auto write_words = [&](std::string_view name, std::span<const u32> words) {
+        u64 ignored_hash{};
+        return WriteDreamsCaptureWords(output / name, words, ignored_hash);
+    };
+    bool files_ok = true;
+    files_ok &= write_words("userdata.bin", capture.producer_userdata);
+    files_ok &= write_words("srt-raw.bin", capture.producer_srt_raw);
+    files_ok &= write_words("srt-flat.bin", capture.producer_srt_flat);
+    files_ok &= write_words("buffer-descriptors.bin", capture.producer_buffer_descriptors);
+    files_ok &= write_words("gds-pre.bin", capture.producer_gds_pre);
+    files_ok &= write_words("gds-post.bin", capture.producer_gds_post);
+    files_ok &= write_words("b0-pre.bin", capture.producer_b0_pre);
+    files_ok &= write_words("b0-post-cpu.bin", capture.producer_b0_post);
+    files_ok &= write_words("b0-post-gpu.bin", capture.producer_b0_gpu_post);
+    files_ok &= write_words("b1-queue-pre.bin", capture.producer_b1_queue_pre);
+    files_ok &= write_words("b1-queue-post-cpu.bin", capture.producer_b1_queue_post);
+    files_ok &= write_words("b1-queue-post-gpu.bin", capture.producer_b1_queue_gpu_post);
+    files_ok &= write_words("b2-pre.bin", capture.producer_b2_pre);
+    files_ok &= write_words("b2-post-cpu.bin", capture.producer_b2_post);
+    files_ok &= write_words("b2-post-gpu.bin", capture.producer_b2_gpu_post);
+    files_ok &= write_words("b3-input.bin", capture.producer_b3_input);
+    files_ok &= write_words("b4-keys.bin", capture.producer_b4_keys);
+    files_ok &= write_words("b4-rows.bin", capture.producer_b4_rows);
+    files_ok &= write_words("store-probe.bin", capture.producer_store_probe);
+
+    const auto gds_word = [&](u32 index, const std::vector<u32>& words) {
+        return index < words.size() ? words[index] : 0;
+    };
+    const std::string summary = fmt::format(
+        "shader\t0x{:016x}\nsequence\t{}\ndims\t{}x{}x{}\nthreads\t{}x{}x{}\n"
+        "start\t{}x{}x{}\nactive_records\t{}\nqueue_begin\t{}\nqueue_end\t{}\n"
+        "gds320_pre\t{}\ngds320_post\t{}\ngds321_pre\t{}\ngds321_post\t{}\n"
+        "gds508_pre\t{}\ngds508_post\t{}\nb0_pre_hash\t0x{:016x}\n"
+        "b0_post_cpu_hash\t0x{:016x}\nb0_post_gpu_hash\t0x{:016x}\n"
+        "b1_post_gpu_hash\t0x{:016x}\nb2_post_gpu_hash\t0x{:016x}\n",
+        Shader::DreamsCompat::QueueProducerShader, capture.producer_sequence,
+        capture.producer_dims[0], capture.producer_dims[1], capture.producer_dims[2],
+        capture.producer_threads[0], capture.producer_threads[1], capture.producer_threads[2],
+        capture.producer_start[0], capture.producer_start[1], capture.producer_start[2],
+        capture.producer_active_records, capture.producer_queue_begin, capture.producer_queue_end,
+        gds_word(320, capture.producer_gds_pre), gds_word(320, capture.producer_gds_post),
+        gds_word(321, capture.producer_gds_pre), gds_word(321, capture.producer_gds_post),
+        gds_word(Shader::DreamsCompat::QueueProducerPrimaryOrderedCounterIndex,
+                 capture.producer_gds_pre),
+        gds_word(Shader::DreamsCompat::QueueProducerPrimaryOrderedCounterIndex,
+                 capture.producer_gds_post),
+        HashDreamsTraceWords(capture.producer_b0_pre),
+        HashDreamsTraceWords(capture.producer_b0_post),
+        HashDreamsTraceWords(capture.producer_b0_gpu_post),
+        HashDreamsTraceWords(capture.producer_b1_queue_gpu_post),
+        HashDreamsTraceWords(capture.producer_b2_gpu_post));
+    files_ok &= WriteDreamsCaptureText(output / "summary.tsv", summary);
+    files_ok &= WriteDreamsCaptureText(
+        output / (files_ok ? "complete.txt" : "failed.txt"),
+        files_ok ? "complete\n" : "one or more producer files could not be written\n");
+    LOG_WARNING(Render_Vulkan,
+                "Dreams 2bf producer-only capture {} sequence={} queue={}..{} directory={}",
+                files_ok ? "complete" : "failed", capture.producer_sequence,
+                capture.producer_queue_begin, capture.producer_queue_end, output.string());
+    return files_ok;
+}
+
+static bool DreamsOrderedChainAllowsVsCapture() {
+    const char* value = DreamsEnvironment<"SHADPS4_DREAMS_ORDERED_CHAIN_CAPTURE_DIR">();
+    if (value == nullptr || value[0] == '\0') {
+        return true;
+    }
+    const auto phase = g_dreams_ordered_chain_capture.phase;
+    return phase == DreamsOrderedChainCaptureState::Phase::WaitingForVs370 ||
+           phase == DreamsOrderedChainCaptureState::Phase::WaitingForVs370Interface;
+}
+
+static void FailDreamsOrderedChainCapture(std::string_view reason) {
+    auto& capture = g_dreams_ordered_chain_capture;
+    if (capture.phase == DreamsOrderedChainCaptureState::Phase::Complete ||
+        capture.phase == DreamsOrderedChainCaptureState::Phase::Failed) {
+        return;
+    }
+    capture.phase = DreamsOrderedChainCaptureState::Phase::Failed;
+    LOG_ERROR(Render_Vulkan, "Dreams ordered-chain capture failed: {}", reason);
+    if (!capture.directory.empty()) {
+        WriteDreamsCaptureText(capture.directory / "failed.txt", fmt::format("{}\n", reason));
+    }
+}
+
+static bool FinalizeDreamsOrderedChainCapture(std::span<const u32> interface_bits,
+                                              std::span<const u32> validity) {
+    auto& capture = g_dreams_ordered_chain_capture;
+    if (capture.phase != DreamsOrderedChainCaptureState::Phase::WaitingForVs370Interface) {
+        return false;
+    }
+    if (!capture.producer_valid || capture.producer_dims != std::array<u32, 3>{1, 1, 1} ||
+        capture.producer_threads != std::array<u32, 3>{64, 1, 1} ||
+        capture.producer_start != std::array<u32, 3>{0, 0, 0} ||
+        capture.producer_queue_end < capture.producer_queue_begin ||
+        capture.producer_b3_input.empty() || capture.producer_b0_gpu_post.empty() ||
+        capture.producer_b1_queue_gpu_post.empty() || capture.producer_b2_gpu_post.empty() ||
+         capture.producer_store_probe.empty() || !capture.traversal_pass0_valid ||
+         capture.traversal_pass0_queue.empty() || capture.traversal_pass0_b2_rows.empty() ||
+         capture.traversal_pass0_b4_rows.empty()) {
+        FailDreamsOrderedChainCapture(
+            "aligned 2bf producer snapshot is missing or is not one Liverpool wave");
+        return false;
+    }
+    constexpr u32 Vertices = Shader::DreamsCompat::Vs370InterfaceCaptureVertices;
+    constexpr u32 Attributes = Shader::DreamsCompat::Vs370InterfaceCaptureAttributes;
+    const u32 instances = capture.draw[1];
+    const u64 expected_interface_words = u64{instances} * Vertices * Attributes *
+                                         Shader::DreamsCompat::Vs370InterfaceCaptureComponents;
+    const u64 expected_validity_words = u64{instances} * Vertices;
+    if (interface_bits.size() != expected_interface_words ||
+        validity.size() != expected_validity_words ||
+        capture.candidate_records.size() != u64{instances} * 2) {
+        FailDreamsOrderedChainCapture("VS370 interface dimensions do not match the aligned draw");
+        return false;
+    }
+    for (const u32 mask : validity) {
+        if (mask != 0x0001ffffU) {
+            FailDreamsOrderedChainCapture("VS370 interface contains an incomplete vertex");
+            return false;
+        }
+    }
+    for (const u32 bits : interface_bits) {
+        if (!std::isfinite(std::bit_cast<float>(bits))) {
+            FailDreamsOrderedChainCapture("VS370 interface contains NaN or infinity");
+            return false;
+        }
+    }
+
+    struct FileEntry {
+        std::string name;
+        u64 bytes{};
+        std::string sha256;
+    };
+    std::vector<FileEntry> files;
+    const auto write_bytes = [&](std::string_view name, std::span<const u8> bytes) {
+        u64 ignored_hash{};
+        const std::filesystem::path path = capture.directory / name;
+        if (!WriteDreamsCaptureBytes(path, bytes, ignored_hash)) {
+            return false;
+        }
+        files.push_back({std::string{name}, bytes.size(), Sha256DreamsCapture(bytes)});
+        return true;
+    };
+    const auto write_words = [&](std::string_view name, std::span<const u32> words) {
+        return write_bytes(name, std::span<const u8>{reinterpret_cast<const u8*>(words.data()),
+                                                     words.size_bytes()});
+    };
+
+    std::string producer_store_report;
+    if (capture.producer_store_probe.size() ==
+        Shader::DreamsCompat::QueueProducerCapture::DwordCount) {
+        namespace ProducerProbe = Shader::DreamsCompat::QueueProducerCapture;
+        constexpr std::array<u32, ProducerProbe::B2Sites> B2Widths{4, 3, 4, 4, 4};
+        const auto probe_word = [&](u32 absolute_dword) {
+            return capture.producer_store_probe[absolute_dword - ProducerProbe::BaseDword];
+        };
+        const u32 magic = probe_word(ProducerProbe::MagicDword);
+        const u32 schema = probe_word(ProducerProbe::SchemaDword);
+        const u32 lanes = probe_word(ProducerProbe::LanesDword);
+        const u32 sites = probe_word(ProducerProbe::SitesDword);
+        const u32 seen0 = probe_word(ProducerProbe::SeenMask0Dword);
+        const u32 seen1 = probe_word(ProducerProbe::SeenMask1Dword);
+        const bool header_valid = magic == ProducerProbe::Magic &&
+                                  schema == ProducerProbe::Schema &&
+                                  lanes == ProducerProbe::Lanes && sites == ProducerProbe::B2Sites;
+        const u32 b1_window_base = capture.producer_queue_begin * 2;
+        u32 b1_valid_count{};
+        u32 b1_match_count{};
+        std::array<u32, ProducerProbe::B2Sites> b2_valid_counts{};
+        std::array<u32, ProducerProbe::B2Sites> b2_match_counts{};
+        std::string rows =
+            "kind\tlane\tsite\taddress_dword\twidth\tgpu_in_range\tgpu_match\tdata0\tdata1\tdata2\tdata3\n";
+        for (u32 lane = 0; lane < ProducerProbe::Lanes; ++lane) {
+            const u32 b1_record = ProducerProbe::B1RecordDword(lane, 0);
+            if (probe_word(b1_record + ProducerProbe::B1Valid) != 0) {
+                ++b1_valid_count;
+                const u32 address = probe_word(b1_record + ProducerProbe::B1Address);
+                const bool in_range = address >= b1_window_base &&
+                                      address - b1_window_base <=
+                                          capture.producer_b1_queue_gpu_post.size() &&
+                                      2 <= capture.producer_b1_queue_gpu_post.size() -
+                                               (address - b1_window_base);
+                bool match = in_range;
+                if (match) {
+                    const u32 offset = address - b1_window_base;
+                    match = capture.producer_b1_queue_gpu_post[offset] ==
+                                probe_word(b1_record + ProducerProbe::B1Data0) &&
+                            capture.producer_b1_queue_gpu_post[offset + 1] ==
+                                probe_word(b1_record + ProducerProbe::B1Data1);
+                }
+                b1_match_count += match ? 1 : 0;
+                rows += fmt::format("b1\t{}\t-1\t{}\t2\t{}\t{}\t0x{:08x}\t0x{:08x}\t"
+                                    "0x00000000\t0x00000000\n",
+                                    lane, address, in_range, match,
+                                    probe_word(b1_record + ProducerProbe::B1Data0),
+                                    probe_word(b1_record + ProducerProbe::B1Data1));
+            }
+            for (u32 site = 0; site < ProducerProbe::B2Sites; ++site) {
+                const u32 record = ProducerProbe::B2RecordDword(lane, site, 0);
+                if (probe_word(record + ProducerProbe::B2Valid) == 0) {
+                    continue;
+                }
+                ++b2_valid_counts[site];
+                const u32 address = probe_word(record + ProducerProbe::B2Address);
+                const u32 width = B2Widths[site];
+                const bool in_range = address <= capture.producer_b2_gpu_post.size() &&
+                                      width <= capture.producer_b2_gpu_post.size() - address;
+                bool match = in_range;
+                for (u32 component = 0; component < width && match; ++component) {
+                    match &= capture.producer_b2_gpu_post[address + component] ==
+                             probe_word(record + ProducerProbe::B2Data0 + component);
+                }
+                b2_match_counts[site] += match ? 1 : 0;
+                rows += fmt::format(
+                    "b2\t{}\t{}\t{}\t{}\t{}\t{}\t0x{:08x}\t0x{:08x}\t0x{:08x}\t"
+                    "0x{:08x}\n",
+                    lane, site, address, width, in_range, match,
+                    probe_word(record + ProducerProbe::B2Data0),
+                    probe_word(record + ProducerProbe::B2Data1),
+                    probe_word(record + ProducerProbe::B2Data2),
+                    probe_word(record + ProducerProbe::B2Data3));
+            }
+        }
+        producer_store_report = fmt::format(
+            "magic=0x{:08x}\nschema={}\nlanes={}\nsites={}\nheader_valid={}\n"
+            "seen_mask=0x{:08x},0x{:08x}\nb1_valid={}\nb1_gpu_match={}\n"
+            "b2_valid={},{},{},{},{}\nb2_gpu_match={},{},{},{},{}\n\n{}",
+            magic, schema, lanes, sites, header_valid, seen0, seen1, b1_valid_count,
+            b1_match_count, b2_valid_counts[0], b2_valid_counts[1], b2_valid_counts[2],
+            b2_valid_counts[3], b2_valid_counts[4], b2_match_counts[0], b2_match_counts[1],
+            b2_match_counts[2], b2_match_counts[3], b2_match_counts[4], rows);
+    }
+
+    const auto descriptor_matches = [](std::span<const u32> lhs, u32 lhs_binding,
+                                       std::span<const u32> rhs, u32 rhs_binding) {
+        const u32 lhs_offset = lhs_binding * 4;
+        const u32 rhs_offset = rhs_binding * 4;
+        return lhs_offset + 4 <= lhs.size() && rhs_offset + 4 <= rhs.size() &&
+               std::ranges::equal(lhs.subspan(lhs_offset, 4), rhs.subspan(rhs_offset, 4));
+    };
+    const bool b535_queue_descriptor_matches = descriptor_matches(
+        capture.producer_buffer_descriptors, 1,
+        capture.traversal_pass0_buffer_descriptors, 6);
+    const bool b535_b2_descriptor_matches = descriptor_matches(
+        capture.producer_buffer_descriptors, 2,
+        capture.traversal_pass0_buffer_descriptors, 8);
+    const bool b535_queue_matches =
+        capture.producer_b1_queue_gpu_post == capture.traversal_pass0_queue;
+    std::string traversal_handoff_report =
+        fmt::format("queue_descriptor_match={}\nb2_descriptor_match={}\nqueue_gpu_match={}\n"
+                    "producer_queue_words={}\nb535_queue_words={}\n",
+                    b535_queue_descriptor_matches, b535_b2_descriptor_matches,
+                    b535_queue_matches, capture.producer_b1_queue_gpu_post.size(),
+                    capture.traversal_pass0_queue.size());
+    constexpr u32 B2StrideDwords = 108;
+    for (u32 row = 0; row < capture.traversal_pass0_b2_keys.size(); ++row) {
+        const u32 object = capture.traversal_pass0_b2_keys[row];
+        const u64 producer_offset = u64{object} * B2StrideDwords;
+        const u64 traversal_offset = u64{row} * B2StrideDwords;
+        const bool in_range = producer_offset + B2StrideDwords <=
+                                  capture.producer_b2_gpu_post.size() &&
+                              traversal_offset + B2StrideDwords <=
+                                  capture.traversal_pass0_b2_rows.size();
+        const bool match =
+            in_range &&
+            std::ranges::equal(
+                std::span<const u32>{capture.producer_b2_gpu_post}.subspan(producer_offset,
+                                                                          B2StrideDwords),
+                std::span<const u32>{capture.traversal_pass0_b2_rows}.subspan(
+                    traversal_offset, B2StrideDwords));
+        traversal_handoff_report += fmt::format(
+            "b2_object{}=producer_in_range:{},gpu_match:{}\n", object, in_range, match);
+    }
+
+    bool files_ok = true;
+    files_ok &= write_words("2bf-userdata.bin", capture.producer_userdata);
+    files_ok &= write_words("2bf-srt-raw.bin", capture.producer_srt_raw);
+    files_ok &= write_words("2bf-srt-flat.bin", capture.producer_srt_flat);
+    files_ok &=
+        write_words("2bf-buffer-descriptors.bin", capture.producer_buffer_descriptors);
+    files_ok &= write_words("2bf-gds-pre.bin", capture.producer_gds_pre);
+    files_ok &= write_words("2bf-gds-post.bin", capture.producer_gds_post);
+    files_ok &= write_words("2bf-b0-pre.bin", capture.producer_b0_pre);
+    files_ok &= write_words("2bf-b0-post.bin", capture.producer_b0_post);
+    files_ok &= write_words("2bf-b1-queue-pre.bin", capture.producer_b1_queue_pre);
+    files_ok &= write_words("2bf-b1-queue-post.bin", capture.producer_b1_queue_post);
+    files_ok &= write_words("2bf-b2-pre.bin", capture.producer_b2_pre);
+    files_ok &= write_words("2bf-b2-post.bin", capture.producer_b2_post);
+    files_ok &= write_words("2bf-b0-gpu-post.bin", capture.producer_b0_gpu_post);
+    files_ok &=
+        write_words("2bf-b1-queue-gpu-post.bin", capture.producer_b1_queue_gpu_post);
+    files_ok &= write_words("2bf-b2-gpu-post.bin", capture.producer_b2_gpu_post);
+    files_ok &= write_words("2bf-store-probe.bin", capture.producer_store_probe);
+    files_ok &= write_bytes(
+        "2bf-store-verification.txt",
+        std::span<const u8>{reinterpret_cast<const u8*>(producer_store_report.data()),
+                            producer_store_report.size()});
+    files_ok &= write_words("2bf-b3-input.bin", capture.producer_b3_input);
+    files_ok &= write_words("2bf-b4-keys.bin", capture.producer_b4_keys);
+    files_ok &= write_words("2bf-b4-rows.bin", capture.producer_b4_rows);
+    files_ok &= write_words("b535-pass0-buffer-descriptors.bin",
+                            capture.traversal_pass0_buffer_descriptors);
+    files_ok &= write_words("b535-pass0-gds.bin", capture.traversal_pass0_gds);
+    files_ok &= write_words("b535-pass0-queue-gpu.bin", capture.traversal_pass0_queue);
+    files_ok &= write_words("b535-pass0-b2-keys.bin", capture.traversal_pass0_b2_keys);
+    files_ok &= write_words("b535-pass0-b2-rows-gpu.bin", capture.traversal_pass0_b2_rows);
+    files_ok &= write_words("b535-pass0-b4-keys.bin", capture.traversal_pass0_b4_keys);
+    files_ok &= write_words("b535-pass0-b4-rows-gpu.bin", capture.traversal_pass0_b4_rows);
+    files_ok &= write_bytes(
+        "b535-pass0-handoff-verification.txt",
+        std::span<const u8>{reinterpret_cast<const u8*>(traversal_handoff_report.data()),
+                            traversal_handoff_report.size()});
+    files_ok &= write_words("gds-pre.bin", capture.gds_pre);
+    files_ok &= write_words("d8-input.bin", capture.d8_input);
+    files_ok &= write_words("d8-output-selectors.bin", capture.d8_output_selectors);
+    files_ok &= write_words("gds-post-d8.bin", capture.gds_post_d8);
+    files_ok &= write_words("7aa-lookup.bin", capture.lookup);
+    files_ok &= write_words("7aa-output.bin", capture.list_output);
+    files_ok &= write_words("gds-post-7aa.bin", capture.gds_post_list);
+    files_ok &= write_words("draw-indirect.bin", capture.draw);
+    files_ok &= write_bytes("indices.bin", capture.indices);
+    files_ok &= write_words("valid-reference-ids.bin", capture.valid_reference_ids);
+    files_ok &= write_words("candidate-records.bin", capture.candidate_records);
+    files_ok &= write_words("candidate-interface.bin", interface_bits);
+    files_ok &= write_words("vs370-interface.bin", interface_bits);
+    files_ok &= write_words("vs370-validity.bin", validity);
+
+    // These supplemental banks do not pretend that an unseen record has captured geometry. They
+    // preserve its exact VS370 inputs so a later exact replay can produce that geometry honestly.
+    files_ok &= write_words("raw-candidate-records.bin", capture.raw_candidate_records);
+    files_ok &= write_words("raw-candidate-b1-id-a.bin", capture.raw_candidate_b1);
+    files_ok &= write_words("raw-candidate-b2-id-b.bin", capture.raw_candidate_b2);
+    files_ok &= write_words("raw-candidate-b4-id-record.bin", capture.raw_candidate_b4);
+    files_ok &= write_words("raw-candidate-b0-object-keys.bin", capture.raw_candidate_b0_keys);
+    files_ok &= write_words("raw-candidate-b0-objects.bin", capture.raw_candidate_b0_objects);
+    files_ok &= write_words("vs-buffer-descriptors.bin", capture.vs_buffer_descriptors);
+    files_ok &= write_words("vs-userdata-raw.bin", capture.vs_userdata_raw);
+    files_ok &= write_words("vs-userdata-effective.bin", capture.vs_userdata_effective);
+    files_ok &= write_words("vs-srt-raw.bin", capture.vs_srt_raw);
+    files_ok &= write_words("vs-srt-flat.bin", capture.vs_srt_flat);
+    files_ok &= write_words("vs-transform.bin", capture.vs_transform);
+    std::string upstream_dispatches = "sequence\tage\tshader_hash\tdim_x\tdim_y\tdim_z\n";
+    for (u32 index = 0; index < capture.upstream_dispatches.size(); ++index) {
+        const auto& dispatch = capture.upstream_dispatches[index];
+        const u64 age = capture.upstream_dispatches.size() - index;
+        upstream_dispatches +=
+            fmt::format("{}\t{}\t0x{:016x}\t{}\t{}\t{}\n", capture.d8_start_sequence - age, age,
+                        dispatch.hash, dispatch.dim_x, dispatch.dim_y, dispatch.dim_z);
