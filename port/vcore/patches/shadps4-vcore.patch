+    if (!data || (size != 4 && size != 8 && size != 16 && size != 32) ||
+        address % alignment != 0 || size > 4096 - (address & 4095) ||
+        address >= (u64{1} << 40) || !IsRegionRegistered(address, size) ||
+        !IsRegionGpuModified(address, size) || IsRegionCpuModified(address, size) ||
+        IsRegionGpuModifiedExact(address, size) || texture_cache.HasImageInRange(address, size)) {
+        return false;
+    }
+    const u64 block = address >> block_shift;
+    const Buffer* arena = GetArena(block, block);
+    if (!arena->IsInBounds(address, size) || !memory->TryStoreBacking(address, data, size)) {
+        return false;
+    }
+    // This records a small, ordered transfer; it does not wait for GPU completion.
+    // Keep CPU-page state and the exact GPU dirty ranges unchanged. A later broad
+    // upload of stale backing bytes would destroy neighboring GPU results.
+    WriteArenaData(arena, address, data, size);
+    return true;
