+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Version-independent matching of Dreams shaders to the Dreams-ShadPS4 fork's routes.
+// See dreams_route_match.h and port/docs/dreams/VERSIONS.md. The signature definitions here
+// must stay identical to port/tools/dreams_shader_routes.py, which generates the table.
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <initializer_list>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+#include <fmt/format.h>
+#include <xxhash.h>
+
+#include "common/dreams_title.h"
+#include "common/elf_info.h"
+#include "common/logging/log.h"
+#include "shader_recompiler/dreams_route_match.h"
+#include "shader_recompiler/frontend/decode.h"
+
+namespace Shader::DreamsRoute {
+namespace {
+
+struct Route {
+    u64 fork_hash;
+    std::string_view name;
+    // DS_ORDERED_COUNT signature; empty for routes without DOC.
+    std::string_view doc;
+    // The signature is unique among routes, so it may identify code that differs from every
+    // recorded build (rule 3).
+    bool shape_match;
+    std::vector<u64> code_hashes;
+    std::vector<u64> guest_hashes;
+};
+
+const std::vector<Route>& Routes() {
+    static const std::vector<Route> routes{
+#include "shader_recompiler/dreams_route_table.inc"
+    };
+    return routes;
+}
+
+bool EnvEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_SIGNATURE_MATCH");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled;
+}
+
+constexpr u32 M0 = 124;
+
+bool IsScalarSource(const Gcn::InstOperand& op) {
+    return op.field == Gcn::OperandField::ScalarGPR || op.field == Gcn::OperandField::VccLo ||
+           op.field == Gcn::OperandField::VccHi || op.field == Gcn::OperandField::M0;
+}
+
+// Scalar register number written by a SOP1/SOP2/SOPK instruction, or nullopt.
+std::optional<u32> ScalarDestination(const Gcn::GcnInst& inst) {
+    using Gcn::InstEncoding;
+    if (inst.encoding != InstEncoding::SOP1 && inst.encoding != InstEncoding::SOP2 &&
+        inst.encoding != InstEncoding::SOPK) {
+        return std::nullopt;
+    }
+    if (inst.dst_count == 0) {
+        return std::nullopt;
+    }
+    // Raw operand codes: s0-s103, vcc_lo 106, vcc_hi 107, m0 124 (the decoder keeps them).
+    const auto& dst = inst.dst[0];
+    return IsScalarSource(dst) ? std::optional<u32>{dst.code} : std::nullopt;
+}
+
+struct DecodedProgram {
+    std::vector<Gcn::GcnInst> insts;
+    std::vector<std::optional<u32>> sdst;
+};
+
+std::optional<u32> BaseFrom(const DecodedProgram& p, size_t def, u32 depth);
+
+std::optional<size_t> LastDefinition(const DecodedProgram& p, u32 reg, size_t before) {
+    for (size_t i = before; i-- > 0;) {
+        if (p.sdst[i] && *p.sdst[i] == reg) {
+            return i;
+        }
+    }
+    return std::nullopt;
+}
+
+// First literal whose low half is zero (an M0 GDS base in bytes << 16), following scalar sources
+// through up to four definitions. Identical to dreams_shader_routes.py base_from().
+std::optional<u32> BaseFrom(const DecodedProgram& p, size_t def, u32 depth) {
+    if (depth > 4) {
+        return std::nullopt;
+    }
+    const auto& inst = p.insts[def];
+    for (u32 i = 0; i < inst.src_count; ++i) {
+        const auto& src = inst.src[i];
+        if (src.field == Gcn::OperandField::LiteralConst && src.code != 0 &&
+            (src.code & 0xffff) == 0) {
+            return src.code >> 16;
+        }
+    }
+    for (u32 i = 0; i < inst.src_count; ++i) {
+        const auto& src = inst.src[i];
+        if (!IsScalarSource(src) || src.field == Gcn::OperandField::M0) {
+            continue;
+        }
+        if (const auto prior = LastDefinition(p, src.code, def)) {
+            if (const auto base = BaseFrom(p, *prior, depth + 1)) {
+                return base;
+            }
+        }
+    }
+    return std::nullopt;
+}
+
+std::string DocSignature(std::span<const u32> code, bool& decoded) {
+    DecodedProgram p;
+    decoded = false;
+    Gcn::GcnCodeSlice slice(code.data(), code.data() + code.size());
+    Gcn::GcnDecodeContext decoder;
+    while (!slice.atEnd()) {
+        p.insts.emplace_back(decoder.decodeInstruction(slice));
+        p.sdst.emplace_back(ScalarDestination(p.insts.back()));
+    }
+    decoded = true;
+    std::string signature;
+    for (size_t i = 0; i < p.insts.size(); ++i) {
+        const auto& inst = p.insts[i];
+        if (inst.opcode != Gcn::Opcode::DS_ORDERED_COUNT) {
+            continue;
+        }
+        const u32 offset0 = inst.control.ds.offset0;
+        const u32 offset1 = inst.control.ds.offset1;
+        const u32 control = ((offset1 >> 4) & 0x3) | ((offset1 & 0x3) << 2) | (offset0 << 8);
+        std::optional<u32> base;
+        if (const auto def = LastDefinition(p, M0, i)) {
+            base = BaseFrom(p, *def, 0);
+        }
+        if (!signature.empty()) {
+            signature += ',';
+        }
+        signature += base ? fmt::format("{:04x}@{:x}", control, ((*base & 0xfffc) + offset0) >> 2)
+                          : fmt::format("{:04x}@?", control);
+    }
+    return signature;
+}
+
+struct Decision {
+    u64 hash;
+    const char* how;
+};
+
+} // Anonymous namespace
+
+bool Enabled() {
+    return EnvEnabled() && Common::IsDreamsSerial(Common::ElfInfo::Instance().GameSerial());
+}
+
+bool IsMatchCandidate(u64 guest_hash, bool uses_ordered_count) {
+    if (!Enabled()) {
+        return false;
+    }
+    if (uses_ordered_count) {
+        return true;
+    }
+    return std::ranges::any_of(Routes(), [guest_hash](const Route& route) {
+        return std::ranges::find(route.guest_hashes, guest_hash) != route.guest_hashes.end();
+    });
+}
+
+namespace {
+std::mutex mutex;
+std::unordered_map<u64, u64> decided;
+std::unordered_map<u64, std::string> refused;
+
+std::optional<u64> HexEnv(const char* name) {
+    const char* value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return std::nullopt;
+    }
+    return std::strtoull(value, nullptr, 16);
+}
+} // Anonymous namespace
+
+void Refuse(u64 guest_hash, u64 route_hash, std::string_view reason) {
+    std::scoped_lock lock{mutex};
+    decided[guest_hash] = guest_hash;
+    refused.emplace(guest_hash, std::string{reason});
+    LOG_WARNING(Render_Recompiler,
+                "Dreams route: guest {:#010x} -> {:#010x} REFUSED, using the generic path: {}",
+                guest_hash, route_hash, reason);
+}
+
+bool IsRefused(u64 guest_hash) {
+    std::scoped_lock lock{mutex};
+    return refused.contains(guest_hash);
+}
+
+bool ForceRefuse(u64 route_hash) {
+    static const auto target = HexEnv("SHADPS4_DREAMS_ROUTE_FORCE_REFUSE");
+    return target && *target == route_hash;
+}
+
+bool DumpIr(u64 route_hash, bool alias) {
+    static const auto target = HexEnv("SHADPS4_DREAMS_ROUTE_IR_DUMP");
+    return alias && target && *target == route_hash;
+}
+
+u64 Resolve(std::span<const u32> code, u64 guest_hash) {
+    if (!Enabled() || code.empty()) {
+        return guest_hash;
+    }
+    {
+        std::scoped_lock lock{mutex};
+        if (const auto it = decided.find(guest_hash); it != decided.end()) {
+            return it->second;
+        }
+    }
+
+    const auto& routes = Routes();
+    const Route* match = nullptr;
+    const char* how = "none";
+    std::string doc;
+    u64 code_hash = XXH64(code.data(), code.size_bytes(), 0);
+    if (const auto native = std::ranges::find(routes, guest_hash, &Route::fork_hash);
+        native != routes.end()) {
+        match = &*native;
+        how = "native";
+    } else if (const auto by_code = std::ranges::find_if(
+                   routes,
+                   [code_hash](const Route& r) {
+                       return std::ranges::find(r.code_hashes, code_hash) != r.code_hashes.end();
+                   });
+               by_code != routes.end()) {
+        match = &*by_code;
+        how = "code";
+    } else {
+        bool decoded = false;
+        doc = DocSignature(code, decoded);
+        if (!doc.empty()) {
+            const Route* candidate = nullptr;
+            u32 equal = 0;
+            for (const auto& route : routes) {
+                if (route.doc == doc) {
+                    ++equal;
+                    candidate = &route;
+                }
+            }
+            if (equal == 1 && candidate->shape_match) {
+                match = candidate;
+                how = "doc-shape";
+            } else if (equal > 0) {
+                how = equal > 1 ? "ambiguous doc-shape (code hash required)"
+                                : "doc-shape needs code hash";
+            }
+        }
+    }
+
+    const u64 result = match ? match->fork_hash : guest_hash;
+    if (match) {
+        LOG_WARNING(Render_Recompiler,
+                    "Dreams route: guest {:#010x} -> {:#010x} {} via {} (code {:#018x}{}{})",
+                    guest_hash, match->fork_hash, match->name, how, code_hash,
+                    doc.empty() ? "" : " doc ", doc);
+    } else if (!doc.empty()) {
+        // Unmatched ordered-count kernels keep the generic atomic path; say why.
+        LOG_WARNING(Render_Recompiler,
+                    "Dreams route: guest {:#010x} DOC kernel has no route ({}; code {:#018x} "
+                    "doc {})",
+                    guest_hash, how, code_hash, doc);
+    }
+    std::scoped_lock lock{mutex};
+    // A concurrent Refuse() wins over this decision.
+    return decided.emplace(guest_hash, result).first->second;
+}
+
+} // namespace Shader::DreamsRoute
