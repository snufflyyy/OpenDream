+                                const u64 offset = u64{keys[n]} * stride;
+                                if (!sharp.base_address || offset > sharp.GetSize() ||
+                                    stride > sharp.GetSize() - offset || offset > logical_size ||
+                                    stride > logical_size - offset) {
+                                    ++out_of_range;
+                                    continue;
+                                }
+                                regions.push_back({source, adjustment + offset,
+                                    std::span<u8>{bytes}.subspan(n * stride, stride)});
+                            }
+                            metadata += fmt::format("{}_binding\t{};guest={:#x};stride={};logical_bytes={};alignment_adjustment={};out_of_range={}\n",
+                                label, binding, sharp.base_address, stride, logical_size, adjustment, out_of_range);
+                            if (!ReadDreamsBoundBufferRegionsForCapture(scheduler, buffer_cache, regions)) return false;
+                            const bool saved = WriteDreamsCaptureWords(output / fmt::format("{}-keys.bin", label), keys, hash) &&
+                                WriteDreamsCaptureBytes(output / fmt::format("{}-records.bin", label), bytes, hash);
+                            return saved && out_of_range == 0;
+                        };
+                        ok &= save_records(0, 432, objects, "objects");
+                        ok &= save_records(1, 128, records, "secondary");
