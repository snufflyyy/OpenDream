+inline bool CaptureGatherFocusTrace() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_GATHER_FOCUS_TRACE");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled;
+}
+
+constexpr bool IsB1WriterProvenanceShader(u64 hash) {
+    return hash == B1SeedWriterShader || hash == GatherVoxelsShader ||
+           hash == B1TransformWriterShader;
+}
+
+inline bool IsCaptureInstrumentedShader(u64 hash) {
+    return (CaptureVs370Interface() && hash == Vs370InterfaceCaptureShader) ||
+           (CaptureCe3ReadConst() && hash == Ce3ReadConstCaptureShader) ||
+           (CaptureCe3FleckTrace() && hash == Ce3ReadConstCaptureShader) ||
+           (CaptureB535Membership() && hash == TraversalShader) ||
+           (CaptureOrderedChain() && hash == QueueProducerShader) ||
+           (CaptureB1WriterProvenance() && IsB1WriterProvenanceShader(hash)) ||
+           (CaptureA3LookupProducerTrace() && hash == A3LookupProducerShader) ||
+           ((CaptureGatherStageTrace() || CaptureGatherFocusTrace()) &&
+            hash == GatherVoxelsShader) ||
+           CaptureImageGather3D();
+}
+
+constexpr bool IsSpriteCullShader(u64 hash) {
+    return hash == SpriteCullShader || hash == SpriteCullShaderAlt ||
+           hash == SpriteCullShaderCusa04301;
+}
+
+constexpr bool NeedsBranchlessOrderedCountAdd(u64 hash) {
+    return hash == TraversalShader || hash == QueueProducerShader ||
+           hash == QueueProducerShaderAlt || hash == IndirectArgsShader ||
+           hash == VisibilityCandidateCompactShader || hash == GatherInputCompactShader ||
+           hash == VisibilityListCompactShader || hash == VisibilityListCompactShaderAlt ||
+           hash == SceneCompactShader;
+}
+
+constexpr bool UsesAlwaysExactOrderedCountReplay(u64 hash) {
+    return hash == TraversalShader || hash == QueueProducerShaderAlt ||
+           hash == B1SeedWriterShader || hash == SculptVolumeWriterShader ||
+           hash == SculptSurfaceCompactShader ||
+           hash == SculptSurfaceFinalizeShader || hash == IndirectArgsShader ||
+           hash == VisibilityCandidateCompactShader || hash == GatherInputCompactShader ||
+           hash == VisibilityListCompactShader || hash == VisibilityListCompactShaderAlt;
+}
+
+inline bool UseSceneCompactExactOrderedCountReplay() {
+    const char* value = std::getenv("SHADPS4_DREAMS_SCENE_COMPACT_EXACT_DOC");
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+}
+
+inline bool UseSelectionListExactOrderedCountReplay() {
+    const char* value = std::getenv("SHADPS4_DREAMS_SELECTION_LIST_EXACT_DOC");
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+}
+
+// Audited, side-effect-free-before-DOC compaction kernels, opt-in as a group.
+struct AdditionalOrderedKernel {
+    u32 docs;
+    u32 counter_base;
+    bool radix_pass;
+};
+constexpr AdditionalOrderedKernel AdditionalOrderedKernelFor(u64 hash) {
+    switch (hash) {
+    case 0x252ccde6: case 0xfff20d00: return {1, 0x400, false};
+    case QueueProducerShader: return {1, 322, false};
+    case 0x6f408bbc: return {4, 0xe4, false};
+    case 0xa25580f7: return {4, 0xe8, false};
+    case 0xbce8c0fe: return {1, 0xda, true};
+    case 0xcbac06d2: return {2, 0x2e0, false};
+    case 0xd4532ff4: return {1, 0x1e8, true};
+    case 0x4bc902cf: return {2, 0x200, false};
+    default: return {};
+    }
+}
+constexpr bool IsStatefulOrderedKernel(u64 hash) {
+    return hash == 0xd4532ff4 || hash == 0x4bc902cf;
+}
+// Reuse the existing private checkpoint allocation, without growing GDS. Two input record
+// words and two queue-header words per lane; separate dispatches serialize reuse with barriers.
+constexpr u32 StatefulOrderedCacheBase = SculptOrderedStateBaseDword;
+constexpr u32 StatefulOrderedCacheWordsPerGroup = 4 * 64;
+constexpr u32 StatefulOrderedMaxGroups = SculptOrderedStateDwords / StatefulOrderedCacheWordsPerGroup;
+static_assert(StatefulOrderedCacheBase + StatefulOrderedMaxGroups *
+                  StatefulOrderedCacheWordsPerGroup <= SculptOrderedStateBaseDword + SculptOrderedStateDwords);
+inline bool UseAdditionalExactOrderedCountReplay(u64 hash) {
+    if (AdditionalOrderedKernelFor(hash).docs == 0) return false;
+    const char* value = std::getenv(IsStatefulOrderedKernel(hash)
+        ? "SHADPS4_DREAMS_STATEFUL_EXACT_DOC" : "SHADPS4_DREAMS_ADDITIONAL_EXACT_DOC");
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+}
+constexpr u32 AdditionalOrderedCacheRevision = 1;
+
+inline bool UsesExactOrderedCountReplay(u64 hash) {
+    return UsesAlwaysExactOrderedCountReplay(hash) ||
+           (hash == SceneCompactShader && UseSceneCompactExactOrderedCountReplay()) ||
+           (hash == SelectionListCompactShader && UseSelectionListExactOrderedCountReplay()) ||
+           UseAdditionalExactOrderedCountReplay(hash);
+}
+static_assert(NeedsBranchlessOrderedCountAdd(QueueProducerShader));
+static_assert(!UsesAlwaysExactOrderedCountReplay(QueueProducerShader));
+
+inline bool UseSculptOrderedCountLeaderBarrier(u64 hash) {
+    if (hash != SculptVolumeWriterShader) {
+        return false;
+    }
+    const char* value = std::getenv("SHADPS4_DREAMS_SCULPT_LEADER_BARRIER");
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+}
+
+constexpr bool NeedsLdsMemoryBarrier(u64 hash) {
+    return hash == TemporalResolveShader;
+}
+
+constexpr bool NeedsPostFillLdsControlBarrier(u64 hash) {
+    return hash == SpatialReconstructionPrepareShader || hash == SpatialReconstructionShader;
+}
+
+constexpr bool NeedsGatherVoxelsLdsPhaseBarriers(u64 hash) {
+    return hash == GatherVoxelsShader;
+}
+
+constexpr bool NeedsDreamsLdsBarrier(u64 hash) {
+    return NeedsLdsMemoryBarrier(hash) || NeedsPostFillLdsControlBarrier(hash) ||
+           NeedsGatherVoxelsLdsPhaseBarriers(hash);
+}
+
+} // namespace Shader::DreamsCompat
diff --git a/src/shader_recompiler/dreams_gpu_scalar_read.h b/src/shader_recompiler/dreams_gpu_scalar_read.h
new file mode 100644
index 0000000000000000000000000000000000000000..87fcd3903b0663aa601c799d95f5017912ae3ff6
--- /dev/null
+++ b/src/shader_recompiler/dreams_gpu_scalar_read.h
@@ -0,0 +1,157 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <map>
+#include <optional>
+#include <vector>
+
+#include "shader_recompiler/ir/program.h"
+
+namespace Shader::Optimization {
+
+inline bool DreamsGpuScalarTablesEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_GPU_NUMERIC_TABLE");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+using DreamsGpuScalarTableKey = std::array<u32, 2>; // root SGPR, parent word (or direct)
+constexpr u32 DreamsDirectScalarTable = ~u32{0};
+
+inline std::optional<u32> ScalarTableRoot(const IR::Inst* pointer) {
+    if (!pointer || pointer->GetOpcode() != IR::Opcode::CompositeConstructU32x2)
+        return {};
+    const auto* low = pointer->Arg(0).TryInst();
+    const auto* high = pointer->Arg(1).TryInst();
+    if (!low || !high || low->GetOpcode() != IR::Opcode::GetUserData ||
+        high->GetOpcode() != IR::Opcode::GetUserData)
+        return {};
+    const u32 root = static_cast<u32>(low->Arg(0).ScalarReg());
+    if (root >= NUM_USER_DATA_REGS - 1 ||
+        static_cast<u32>(high->Arg(0).ScalarReg()) != root + 1)
+        return {};
+    return root;
+}
+
+// Keep separate leaves separate: the two captured compute shaders read several
+// numeric tables, including the same camera data through a nested SRT pointer.
+// Candidate matching is independent of the read index and its uses, so a mixed
+// or dynamically indexed table can be rejected as a whole.
+inline std::optional<DreamsGpuScalarTableKey> GetDreamsGpuScalarTableKey(
+    const Info& info, const IR::Inst& inst) {
+    if (inst.GetOpcode() != IR::Opcode::ReadConst)
+        return {};
+    const auto* pointer = inst.Arg(0).TryInst();
+    if (!pointer || pointer->GetOpcode() != IR::Opcode::CompositeConstructU32x2)
+        return {};
+    const bool first = info.sw_stage == SwStage::Compute && info.pgm_hash == 0xbb773aed;
+    const bool second = info.sw_stage == SwStage::Compute && info.pgm_hash == 0x80aed032;
+    if (info.sw_stage != SwStage::Compute &&
+        info.sw_stage != SwStage::Vertex && info.sw_stage != SwStage::Fragment)
+        return {};
+    if (const auto root = ScalarTableRoot(pointer)) {
+        if (*root == 2 && !first && !second)
+            return DreamsGpuScalarTableKey{*root, DreamsDirectScalarTable};
+        return {};
+    }
+    if (!first && !second)
+        return {};
+    const auto* low = pointer->Arg(0).TryInst();
+    const auto* high = pointer->Arg(1).TryInst();
+    if (!low || !high || low->GetOpcode() != IR::Opcode::ReadConst ||
+        high->GetOpcode() != IR::Opcode::ReadConst || !low->Arg(1).IsImmediate() ||
+        !high->Arg(1).IsImmediate() || low->Arg(1).U32() >= 4096 ||
+        high->Arg(1).U32() != low->Arg(1).U32() + 1)
+        return {};
+    const auto root = ScalarTableRoot(low->Arg(0).TryInst());
+    if (!root || root != ScalarTableRoot(high->Arg(0).TryInst()) ||
+        (*root != 0 && !(first && *root == 2)))
+        return {};
+    return DreamsGpuScalarTableKey{*root, low->Arg(1).U32()};
+}
+
+inline bool IsDreamsGpuScalarTableRead(const Info& info, const IR::Inst& inst) {
+    return GetDreamsGpuScalarTableKey(info, inst).has_value();
+}
+
+inline bool ScalarReadHasOnlyFloatUses(const IR::Inst& inst, u32 depth = 0) {
+    if (depth > 16)
+        return false;
+    for (const auto& use : inst.Uses()) {
+        const auto opcode = use.user->GetOpcode();
+        if ((opcode == IR::Opcode::SetScalarRegister || opcode == IR::Opcode::SetVectorRegister) &&
+            !use.user->HasUses()) {
+            // SSA has already forwarded register reads to their definitions.
+            // These unused assignments remain until the later dead-code pass;
+            // they do not consume a value at runtime.
+            continue;
+        }
+        // Upstream removed Opcode::Identity; SSA values are used directly.
+        if (use.user->GetOpcode() != IR::Opcode::BitCastF32U32) {
+            // Includes descriptor composites, integer data, and nested pointers.
+            return false;
+        }
+    }
+    return true;
+}
+
+inline bool ScalarReadHasFloatUses(const IR::Inst& inst, u32 depth = 0) {
+    if (depth > 16)
+        return false;
+    for (const auto& use : inst.Uses()) {
+        if (use.user->GetOpcode() == IR::Opcode::BitCastF32U32) {
+            return true;
+        }
+    }
+    return false;
+}
+
+struct DreamsGpuScalarTable {
+    DreamsGpuScalarTableKey key;
+    std::vector<IR::Inst*> reads;
+};
+
+inline std::vector<DreamsGpuScalarTable> FindDreamsGpuScalarTables(const IR::Program& program) {
+    struct Candidate {
+        bool valid = true;
+        bool has_float = false;
+        std::vector<IR::Inst*> reads;
+    };
+    std::map<DreamsGpuScalarTableKey, Candidate> candidates;
+    constexpr u32 max_index = 63;
+    for (auto* block : program.post_order_blocks) {
+        for (auto& inst : *block) {
+            const auto key = GetDreamsGpuScalarTableKey(program.info, inst);
+            if (!key)
+                continue;
+            auto& candidate = candidates[*key];
+            if (!inst.Arg(1).IsImmediate() || inst.Arg(1).U32() > max_index ||
+                !ScalarReadHasOnlyFloatUses(inst))
+                candidate.valid = false;
+            candidate.has_float |= ScalarReadHasFloatUses(inst);
+            candidate.reads.push_back(&inst);
+        }
+    }
+    std::vector<DreamsGpuScalarTable> tables;
+    for (auto& [key, candidate] : candidates) {
+        if (candidate.valid && candidate.has_float)
+            tables.push_back({key, std::move(candidate.reads)});
+    }
+    return tables;
+}
+
+inline std::vector<IR::Inst*> FindDreamsGpuScalarTable(const IR::Program& program) {
+    std::vector<IR::Inst*> reads;
+    for (const auto& table : FindDreamsGpuScalarTables(program))
+        reads.insert(reads.end(), table.reads.begin(), table.reads.end());
+    return reads;
+}
+
+} // namespace Shader::Optimization
