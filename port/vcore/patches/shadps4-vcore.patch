+Rasterizer::Rasterizer(const Instance& instance_, Scheduler& scheduler_, Runtime& runtime_,
+                       AmdGpu::Liverpool* liverpool_)
+    : instance{instance_}, scheduler{scheduler_}, runtime{runtime_}, page_manager{this},
+      buffer_cache{instance, scheduler, runtime, liverpool_, texture_cache, page_manager},
+      texture_cache{instance, scheduler, runtime, liverpool_, buffer_cache, page_manager},
+      liverpool{liverpool_}, memory{Core::Memory::Instance()},
+      pipeline_cache{instance, scheduler, liverpool, buffer_cache.GetSparsePageShift()},
+      host_markers_enabled{EmulatorSettings.IsVkHostMarkersEnabled()},
+      guest_markers_enabled{EmulatorSettings.IsVkGuestMarkersEnabled()},
+      submit_draw_interval{EmulatorSettings.GetSubmitDrawInterval()} {
+    g_dreams_fill_scheduler = &scheduler;
+    // Same size as the fork's former BufferCache download utility buffer.
+    dreams_download_buffer = std::make_unique<VideoCore::StreamBuffer>(
+        instance, scheduler, VideoCore::MemoryType::HostCached, 32_MB);
+    g_dreams_download_buffer = dreams_download_buffer.get();
+    if (!EmulatorSettings.IsNullGPU()) {
+        dreams_ordered_prefix_pass.Create(instance.GetDevice());
+        if (const auto* native = DreamsEnvironment<"SHADPS4_DREAMS_NATIVE_VOLUME">();
+            native && std::string_view{native} == "1" && instance.MaxPushDescriptors() >= 7) {
+            dreams_native_volume_pass = std::make_unique<HostPasses::DreamsNativeVolumePass>(instance);
+            LOG_WARNING(Render_Vulkan, "Private native volume renderer enabled: opaque roots, capacity 64x8192");
+        }
+        dreams_performance_profiler =
+            std::make_unique<DreamsPerformanceProfiler>(instance, scheduler);
+        liverpool->BindRasterizer(this);
+    }
+    memory->SetRasterizer(this);
+
+    scheduler.SetSubmitCallback([this](Vulkan::SubmitInfo& info) {
+        runtime.FlushBarriers();
+        buffer_cache.SubmitPendingArenaBinds(info);
+    });
+}
