+void Image::MarkGpuModified() {
+    // Dreams fork: record the CPU baseline of each mip when the image becomes GPU-owned, so a
+    // later refresh can keep GPU-written mips whose guest bytes the CPU did not change.
+    // A definite CPU write selects the only mip of a single-level image.
+    // There are no other mip levels to preserve by comparing CPU snapshots.
+    // Shared-page uncertainty is resolved separately by MarkAsMaybeDirty.
+    if ((False(flags & ImageFlagBits::GpuModified) ||
+         True(flags & (ImageFlagBits::CpuDirty | ImageFlagBits::MaybeCpuDirty))) &&
+        info.guest_address != 0 && info.num_samples == 1 && info.resources.levels > 1) {
+        const auto* address = std::bit_cast<const u8*>(info.guest_address);
+        for (u32 mip = 0; mip < info.resources.levels; ++mip) {
+            const auto& layout = info.mips_layout[mip];
+            mip_hashes[mip] = XXH3_64bits(address + layout.offset, layout.size);
+        }
+    }
+    flags |= ImageFlagBits::GpuModified;
+}
