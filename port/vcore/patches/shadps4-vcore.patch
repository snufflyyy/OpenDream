diff --git a/src/shader_recompiler/backend/spirv/dreams_stateful_order.h b/src/shader_recompiler/backend/spirv/dreams_stateful_order.h
new file mode 100644
index 0000000000000000000000000000000000000000..a1c71e8a24a2978d12a65c3578513db8542bae95
--- /dev/null
+++ b/src/shader_recompiler/backend/spirv/dreams_stateful_order.h
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "shader_recompiler/backend/spirv/spirv_emit_context.h"
+#include "shader_recompiler/dreams_compat.h"
+
+namespace Shader::Backend::SPIRV {
+inline u32 DreamsAdditionalIndirectMaxGroups(u64 hash) {
+    switch (hash) {
+    case 0x4bc902cf: return DreamsCompat::StatefulOrderedMaxGroups;
+    case 0xfff20d00: // Captured indirect one-counter compaction
+    case 0xbce8c0fe: // SunShadowSortDrawKeys
+    case 0x6f408bbc: // SunShadowPartitionByCascade
+    case 0xa25580f7: // SunShadowPartitionByCascadeSecondPass
+        return DreamsCompat::MaxTraversalWorkgroups;
+    default: return 0;
+    }
+}
+inline Id DreamsStatefulShapeValid(EmitContext& ctx) {
+    const Id dims=ctx.OpLoad(ctx.U32[3],ctx.num_workgroups_id);
+    const Id x=ctx.OpCompositeExtract(ctx.U32[1],dims,0);
+    const Id y=ctx.OpCompositeExtract(ctx.U32[1],dims,1);
+    const Id z=ctx.OpCompositeExtract(ctx.U32[1],dims,2);
+    return ctx.OpLogicalAnd(ctx.U1[1],
+        ctx.OpULessThanEqual(ctx.U1[1],x,ctx.ConstU32(DreamsAdditionalIndirectMaxGroups(ctx.info.pgm_hash))),
+        ctx.OpLogicalAnd(ctx.U1[1],ctx.OpIEqual(ctx.U1[1],y,ctx.u32_one_value),
+                         ctx.OpIEqual(ctx.U1[1],z,ctx.u32_one_value)));
+}
+inline Id DreamsStatefulPhase(EmitContext& ctx) {
+    if(!DreamsAdditionalIndirectMaxGroups(ctx.info.pgm_hash)) return ctx.dreams_ordered_phase;
+    // Unsupported indirect dimensions execute the original shader once, during Replay.
+    // Its Collect dispatch exits at entry and the cleared scan count remains zero.
+    return ctx.OpSelect(ctx.U32[1],DreamsStatefulShapeValid(ctx),ctx.dreams_ordered_phase,
+                        ctx.ConstU32(DreamsCompat::OrderedPhaseNative));
+}
+inline void EmitDreamsStatefulCollectGate(EmitContext& ctx) {
+    if(!DreamsAdditionalIndirectMaxGroups(ctx.info.pgm_hash) ||
+       !DreamsCompat::UseAdditionalExactOrderedCountReplay(ctx.info.pgm_hash)) return;
+    const Id valid=DreamsStatefulShapeValid(ctx);
+    const Id collect=ctx.OpIEqual(ctx.U1[1],ctx.dreams_ordered_phase,
+                                  ctx.ConstU32(DreamsCompat::OrderedPhaseCollect));
+    const Id skip=ctx.OpLogicalAnd(ctx.U1[1],collect,ctx.OpLogicalNot(ctx.U1[1],valid));
+    const Id return_label=ctx.OpLabel(),after_gate=ctx.OpLabel();
+    ctx.OpSelectionMerge(after_gate,spv::SelectionControlMask::MaskNone);
+    ctx.OpBranchConditional(skip,return_label,after_gate);
+    ctx.AddLabel(return_label);ctx.OpReturn();ctx.AddLabel(after_gate);
+    const Id local=ctx.OpCompositeExtract(ctx.U32[1],ctx.OpLoad(ctx.U32[3],ctx.local_invocation_id),0);
+    const Id first=ctx.OpLogicalAnd(ctx.U1[1],ctx.OpIEqual(ctx.U1[1],local,ctx.u32_zero_value),
+        ctx.OpIEqual(ctx.U1[1],ctx.workgroup_index_id,ctx.u32_zero_value));
+    const Id publish=ctx.OpLogicalAnd(ctx.U1[1],collect,ctx.OpLogicalAnd(ctx.U1[1],valid,first));
+    const auto gds=std::ranges::find(ctx.buffers,BufferType::GdsBuffer,&EmitContext::BufferDefinition::buffer_type);
+    ASSERT_MSG(gds!=ctx.buffers.end(),"Dreams additional indirect count has no GDS buffer");
