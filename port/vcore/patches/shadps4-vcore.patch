+    files_ok &= write_bytes(
+        "b535-b4-writers.tsv",
+        std::span<const u8>{reinterpret_cast<const u8*>(b535_b4_writers.data()),
+                            b535_b4_writers.size()});
+    std::string writer_catalog =
+        "first_sequence\tlast_sequence\tfirst_dispatch\tlast_dispatch\tcount\tshader_hash\t"
+        "stage\tkind\tbinding\tdeclared_write\tbase\tsize\tstride\tsource\n";
+    for (const auto& entry : capture.traversal_pass0_writer_catalog) {
