+            VAddr start = std::max<VAddr>(device_addr, backing.start << block_shift);
+            const VAddr stop = std::min<VAddr>(end, backing.end << block_shift);
+            // Never let one read span two VA arena pages.
+            while (start < stop) {
+                const VAddr page_end = Common::AlignDown(start, ARENA_PAGE_SIZE) + ARENA_PAGE_SIZE;
