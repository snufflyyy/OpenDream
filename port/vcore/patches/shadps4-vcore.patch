diff --git a/src/video_core/renderer_vulkan/vk_loop_guard.cpp b/src/video_core/renderer_vulkan/vk_loop_guard.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..73c7bb087913d85615d037a146d52b1d2870ef1a
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_loop_guard.cpp
@@ -0,0 +1,132 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// vcore: host side of the GPU hang guard. See shader_recompiler/loop_guard.h.
+
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include "common/logging/log.h"
+#include "shader_recompiler/loop_guard.h"
+#include "video_core/buffer_cache/buffer.h"
+#include "video_core/renderer_vulkan/vk_indirect_clamp.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+#include "video_core/renderer_vulkan/vk_loop_guard.h"
+
+namespace Vulkan::LoopGuard {
+namespace {
+
+namespace Guard = Shader::LoopGuard;
+
+std::once_flag g_init_flag;
+// Never destroyed: it would outlive the device at exit. The monitor thread keeps reading it.
+VideoCore::Buffer* g_report_buffer{};
+u64 g_report_address{};
+vk::SpecializationMapEntry g_address_entry{
+    .constantID = Guard::AddressSpecId,
+    .offset = 0,
+    .size = sizeof(u64),
+};
+vk::SpecializationInfo g_address_only{};
+
+u32 ReadWord(const volatile u32* words, u32 index) {
+    return words[index];
+}
+
+// Polls the report buffer (device-local host-visible memory, coherent) and logs new trips.
+// Reads are uncached but the buffer is 64 KiB and polled twice a second.
+void MonitorThread(const volatile u32* words) {
+    std::array<u32, Guard::SlotCount> seen{};
+    std::array<std::chrono::steady_clock::time_point, Guard::SlotCount> last_log{};
+    std::array<u32, IndirectClamp::ReportDwords> seen_indirect{};
+    using namespace std::chrono_literals;
+    for (;;) {
+        std::this_thread::sleep_for(500ms);
+        if (!g_report_buffer->is_coherent) {
+            g_report_buffer->Invalidate(0, Guard::ReportBufferBytes);
+        }
+        const auto now = std::chrono::steady_clock::now();
+        for (u32 slot = 0; slot < Guard::SlotCount; ++slot) {
+            const u32 base = slot * Guard::SlotDwords;
+            const u32 count = ReadWord(words, base);
+            if (count == seen[slot]) {
+                continue;
+            }
+            const bool first = seen[slot] == 0;
+            if (!first && now - last_log[slot] < 10s) {
+                continue;
+            }
+            const u64 hash = static_cast<u64>(ReadWord(words, base + 1)) |
+                             (static_cast<u64>(ReadWord(words, base + 2)) << 32);
+            LOG_ERROR(Render_Vulkan,
+                      "vcore loop guard: {} in shader {:#x} ({} loop exits forced so far, limit "
+                      "{} iterations; slot {})",
+                      first ? "TRIPPED" : "still tripping", hash, count, Guard::Limit(), slot);
+            seen[slot] = count;
+            last_log[slot] = now;
+        }
+        IndirectClamp::PollReport(words + Guard::IndirectReportOffset / sizeof(u32),
+                                  seen_indirect);
+    }
+}
+
+} // Anonymous namespace
+
+void Init(const Instance& instance) {
+    std::call_once(g_init_flag, [&] {
+        const u32 limit = Guard::Limit();
+        const bool clamp = IndirectClamp::Enabled();
+        if (limit == 0) {
+            LOG_WARNING(Render_Vulkan, "vcore loop guard OFF (VCORE_LOOP_GUARD=0)");
+        }
+        if (limit == 0 && !clamp) {
+            return;
+        }
+        if (!instance.IsBufferDeviceAddressSupported()) {
+            LOG_WARNING(Render_Vulkan, "vcore loop guard: no buffer device address, guard runs "
+                                       "without trip reports");
+            return;
+        }
+        g_report_buffer = new VideoCore::Buffer(
+            instance, 0, Guard::ReportBufferBytes, VideoCore::MemoryType::Stream,
+            "vcore loop guard reports");
+        if (g_report_buffer->mapped_data.size() < Guard::ReportBufferBytes) {
+            LOG_WARNING(Render_Vulkan, "vcore loop guard: report buffer is not host visible, "
+                                       "guard runs without trip reports");
+            g_report_buffer = nullptr; // leaked on purpose, see above
+            return;
+        }
+        std::memset(g_report_buffer->mapped_data.data(), 0, Guard::ReportBufferBytes);
+        if (!g_report_buffer->is_coherent) {
+            g_report_buffer->Flush(0, Guard::ReportBufferBytes);
+        }
+        g_report_address = g_report_buffer->BufferDeviceAddress();
+        g_address_only = vk::SpecializationInfo{
+            .mapEntryCount = 1,
+            .pMapEntries = &g_address_entry,
+            .dataSize = sizeof(g_report_address),
+            .pData = &g_report_address,
+        };
+        const auto* words =
+            reinterpret_cast<const volatile u32*>(g_report_buffer->mapped_data.data());
+        std::thread{MonitorThread, words}.detach();
+        LOG_WARNING(Render_Vulkan,
+                    "vcore loop guard {}: {} iterations per outermost loop entry; indirect clamp "
+                    "{}; report buffer {:#x} (coherent={})",
+                    limit ? "ON" : "OFF", limit, clamp ? "ON" : "OFF", g_report_address,
+                    g_report_buffer->is_coherent);
+    });
+}
+
+u64 ReportAddress() noexcept {
+    return g_report_address;
+}
+
+const vk::SpecializationInfo* AddressOnlySpecialization() noexcept {
+    return g_report_address != 0 && Guard::Limit() != 0 ? &g_address_only : nullptr;
+}
+
+} // namespace Vulkan::LoopGuard
