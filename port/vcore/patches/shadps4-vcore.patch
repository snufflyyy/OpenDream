+void Rasterizer::EliminateFastClear() {
+    auto& col_buf = liverpool->regs.color_buffers[0];
+    TraceDreamsResetEvent("fast-clear-request", 0, col_buf.Address(), col_buf.CmaskAddress(),
+                         col_buf.info.fast_clear ? 1 : 0);
+    if (!col_buf || !col_buf.info.fast_clear) {
+        TraceDreamsResetEvent("fast-clear-disabled", 0, col_buf.Address(), col_buf.CmaskAddress());
+        return;
+    }
+    VideoCore::TextureCache::ImageDesc desc(col_buf, liverpool->last_cb_extent[0]);
+    const auto image_id = texture_cache.FindImage(desc);
+    const auto& image_view = texture_cache.FindRenderTarget(image_id, desc);
+    if (!texture_cache.IsMetaCleared(col_buf.CmaskAddress(), col_buf.view.slice_start)) {
+        TraceDreamsResetEvent("fast-clear-unmarked", 0, col_buf.Address(), col_buf.CmaskAddress(),
+                             col_buf.view.slice_start);
+        return;
+    }
+    for (u32 slice = col_buf.view.slice_start; slice <= col_buf.view.slice_max; ++slice) {
+        texture_cache.TouchMeta(col_buf.CmaskAddress(), slice, false);
+    }
+    auto& image = texture_cache.GetImage(image_id);
+    const auto clear_value = LiverpoolToVK::ColorBufferClearValue(col_buf);
+
+    ScopeMarkerBegin(fmt::format("EliminateFastClear:MRT={:#x}:M={:#x}", col_buf.Address(),
+                                 col_buf.CmaskAddress()));
+    runtime.ClearImage(&image, desc.view_info.range, clear_value);
+    TraceDreamsResetEvent("fast-clear-executed", 0, col_buf.Address(), image.info.guest_size,
+                         col_buf.view.slice_start);
+    ScopeMarkerEnd();
+}
