+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <span>
+#include <string_view>
+
+#include "common/types.h"
+
+namespace Shader::DreamsRoute {
+
+// Version-independent identification of the Dreams-ShadPS4 fork's shader routes.
+//
+// The fork keys its Dreams fixes on the hash embedded in the guest shader binary (pgm_hash) of
+// Dreams v2.64 (CUSA04301). Every game build embeds different hashes, even for identical code, so
+// on any other version the fixes stay off. With SHADPS4_DREAMS_SIGNATURE_MATCH=1 (and a Dreams
+// title, Common::IsDreamsSerial), Resolve() maps a guest program to the fork route it implements
+// and returns that route's v2.64 hash, which then becomes Info::pgm_hash so every existing
+// hash-gated path engages unchanged:
+//   1. pgm_hash is a fork route hash (v2.64)          -> unchanged ("native")
+//   2. XXH64 of the code span equals a code hash      -> route ("code": byte-identical code
+//      recorded for that route on a known version     to an identified build)
+//   3. DS_ORDERED_COUNT signature equals exactly one  -> route ("doc-shape": same ordered-count
+//      route whose signature is unique among routes      controls and GDS counters; code differs)
+// The table (dreams_route_table.inc) is generated by port/tools/dreams_shader_routes.py. Each
+// decision is logged once per guest hash ("Dreams route: ..."). See port/docs/dreams/VERSIONS.md.
+u64 Resolve(std::span<const u32> code, u64 guest_hash);
+
+// True when signature matching is enabled for this process (env + Dreams title).
+bool Enabled();
+
+// A cached stage compiled for `guest_hash` must not be preloaded while matching is on: it may have
+// been compiled without its route (by an older build or with matching off).
+bool IsMatchCandidate(u64 guest_hash, bool uses_ordered_count);
+
+// Fail-safe. Route-specific lowering asserts on the exact IR shape it was written for. A routed
+// program is compiled inside a Common::RecoverableAssertScope (vk_pipeline_cache.cpp
+// CompileModule); if any assertion fires, the route is refused for that guest hash: the program
+// is recompiled with its own hash (generic path) and later Resolve() calls return the guest hash.
+void Refuse(u64 guest_hash, u64 route_hash, std::string_view reason);
+bool IsRefused(u64 guest_hash);
+
+// Test switch SHADPS4_DREAMS_ROUTE_FORCE_REFUSE=<hex route hash>: refuse that route at its first
+// compile (exercises the fallback deterministically).
+bool ForceRefuse(u64 route_hash);
+
+// Diagnostics switch SHADPS4_DREAMS_ROUTE_IR_DUMP=<hex route hash>: dump the IR of that routed
+// program at several stages, file names prefixed with the process id (shader dump dir).
+bool DumpIr(u64 route_hash, bool alias);
+
+} // namespace Shader::DreamsRoute
