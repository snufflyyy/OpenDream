index 0000000000000000000000000000000000000000..de0fa12823f9a67096b2adafcae7932a27cd1595
--- /dev/null
+++ b/src/video_core/host_shaders/dreams_ordered_prefix.comp
@@ -0,0 +1,89 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(std430, binding = 0) buffer global_data_share {
+    uint gds[];
+};
+
+layout(push_constant) uniform push_constants {
+    uvec4 streams[5];
+    uint stream_count;
+    uint entry_stride;
+    uint group_count_from_gds_mask;
+    uint matrix_group_count;
+    uint matrix_stream_count;
+    uint matrix_counter_base;
+    uint matrix_counter_row_stride;
+    uint matrix_counter_columns;
+    uint matrix_scratch_base;
+    uint matrix_scratch_stream_stride;
+};
+
+shared uint partial[128];
+shared uint initial;
+
+void main() {
+    const bool matrix_mode = matrix_stream_count != 0;
+    const uint stream_index =
+        gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x;
+    const uint active_stream_count = matrix_mode ? matrix_stream_count : stream_count;
+    if (stream_index >= active_stream_count) {
+        return;
+    }
+
+    uvec4 stream;
+    uint count;
+    if (matrix_mode) {
+        const uint row = stream_index / matrix_counter_columns;
+        const uint column = stream_index % matrix_counter_columns;
+        stream = uvec4(matrix_group_count,
+                       matrix_counter_base + row * matrix_counter_row_stride + column,
+                       matrix_scratch_base + stream_index * matrix_scratch_stream_stride, 0);
+        count = matrix_group_count;
+    } else {
+        stream = streams[stream_index];
+        const bool group_count_from_gds =
+            (group_count_from_gds_mask & (1u << stream_index)) != 0;
+        count = group_count_from_gds ? min(gds[stream.w], stream.x) : stream.x;
+    }
+
+    const uint lane=gl_LocalInvocationID.x;
+    if(count<=8u) {
+        if(lane==0u) {
+            uint running=gds[stream.y];
+            for(uint i=0;i<count;++i) {
+                uint entry=stream.z+i*entry_stride;
+                uint value=gds[entry];gds[entry+1]=running;running+=value;
+            }
+            gds[stream.y]=running;
+        }
+        return;
+    }
+    // Adjacent ranges in guest order, exclusive prefix with uint32 wraparound.
+    // One group owns a stream; there are no cross-workgroup waits or counters.
+    const uint per_lane=(count+127u)/128u;
+    const uint first=min(count,lane*per_lane);
+    const uint last=min(count,first+per_lane);
+    uint total=0;
+    for(uint i=first;i<last;++i)total+=gds[stream.z+i*entry_stride];
+    if(lane==0)initial=gds[stream.y];
+    partial[lane]=total;
+    barrier();
+    for(uint distance=1;distance<128;distance*=2) {
+        uint addend=lane>=distance?partial[lane-distance]:0;
+        barrier();
+        partial[lane]+=addend;
+        barrier();
+    }
+    uint running=initial+(lane==0?0:partial[lane-1]);
+    for(uint i=first;i<last;++i) {
+        const uint entry=stream.z+i*entry_stride;
+        const uint value=gds[entry];
+        gds[entry+1]=running;running+=value;
+    }
+    if(lane==0)gds[stream.y]=initial+partial[127];
+}
