+        const u64 overlap_size = overlap_end > overlap_base ? overlap_end - overlap_base : 0;
+        const std::string_view kind = writer.kind == DreamsBufferWriter::Kind::Shader
+                                          ? "shader"
+                                      : writer.kind == DreamsBufferWriter::Kind::Copy ? "copy"
+                                                                                      : "fill";
+        b535_b4_writers += fmt::format(
+            "{}\t{}\t{}\t{}\t0x{:016x}\t{}\t{}\t{}\t{}\t0x{:x}\t0x{:x}\t{}\t"
+            "0x{:x}\t0x{:x}\t0x{:x}\t{}\t{}\t0x{:016x}\t{}\n",
+            rank, writer.sequence, writer.dispatch_sequence,
+            capture.traversal_pass0_sequence - writer.dispatch_sequence, writer.shader_hash,
+            static_cast<u32>(writer.stage), kind, writer.binding_index, writer.declared_write,
+            writer.base, writer.size, writer.stride, writer.source, overlap_base, overlap_size,
+            writer.base == capture.traversal_pass0_b4_base,
