+struct IndirectUserDataLocation {
+    Shader::HwStage stage;
+    u32 register_index;
+};
+
+static std::optional<IndirectUserDataLocation> DecodeIndirectUserDataLocation(u32 location) {
+    // GNM encodes a physical shader-stage register base plus the local user-SGPR number.
+    // A zero location disables the corresponding command-processor write.
+    static constexpr std::array StageBases{
+        std::pair{0x4cU, Shader::HwStage::Vertex},
+        std::pair{0xccU, Shader::HwStage::Export},
+        std::pair{0x14cU, Shader::HwStage::Local},
+    };
+    if (location == 0) {
+        return std::nullopt;
+    }
+    for (const auto& [base, stage] : StageBases) {
+        if (location >= base && location < base + Shader::NUM_USER_DATA_REGS) {
+            return IndirectUserDataLocation{stage, location - base};
+        }
+    }
+    return std::nullopt;
+}
