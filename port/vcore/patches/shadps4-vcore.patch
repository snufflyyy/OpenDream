+static bool TraceDreamsFleckRendering() {
+    static bool enabled = [] {
+        const char* value = DreamsEnvironment<"SHADPS4_DREAMS_FLECK_TRACE">();
+        return value != nullptr && std::string_view{value} == "1";
+    }();
+    if (!enabled) {
+        const char* trigger_file = static_cast<const char*>(nullptr) /* release: FLECK_TRACE_TRIGGER_FILE disabled */;
+        if (trigger_file != nullptr && trigger_file[0] != '\0') {
+            std::error_code error;
+            if (std::filesystem::remove(trigger_file, error)) {
+                enabled = true;
+                LOG_WARNING(Render_Vulkan, "Dreams fleck trace armed from trigger file");
+            }
+        }
+    }
+    return enabled && Common::ElfInfo::Instance().GameSerial() == ::Common::DreamsTitleId{};
+}
