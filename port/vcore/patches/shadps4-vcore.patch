@@ -0,0 +1,90 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// vcore: clamp of GPU-supplied indirect dispatch/draw arguments (GPU hang guard).
+//
+// Indirect arguments live in guest memory and are usually written by earlier GPU work, so the
+// host can't check them without a stall. Before an indirect call, a one-workgroup compute pass
+// (host_shaders/vcore_indirect_clamp.comp) copies the commands into a device-local ring with the
+// sizes clamped, and the call reads the copy. A clamp is reported through the loop guard report
+// buffer and logged once (vk_loop_guard.cpp).
+
+#pragma once
+
+#include <array>
+#include <memory>
+#include <utility>
+#include "common/types.h"
+#include "video_core/renderer_vulkan/vk_common.h"
+
+namespace VideoCore {
+struct Buffer;
+}
+
+namespace Vulkan {
+
+class Instance;
+class Scheduler;
+
+namespace IndirectClamp {
+
+constexpr u32 ReportDwords = 8;
+
+/// VCORE_INDIRECT_CLAMP=0 disables the clamp (default on).
+bool Enabled();
+
+/// Logs new clamp reports found in the report area (called by the loop guard monitor thread).
+void PollReport(const volatile u32* words, std::array<u32, ReportDwords>& seen);
+
+/// Clamps dispatch dimensions the host read from guest memory (same limits as the GPU pass).
+void ClampHostDispatch(std::array<u32, 3>& dims);
+
+/// True when the GPU pass would change this draw command (per-command count, instance and product
+/// limits). A count-buffer draw executes only the commands below the GPU-written count, so entries
+/// above it can exceed these limits without ever being drawn.
+bool DrawExceedsLimits(u32 elements, u32 instances);
+
+/// VCORE_INDIRECT_DRAW_ATTRIBUTE=<n>: attribute the next n indirect draws with a host readback of
+/// the GPU-written draw count, i.e. say how many commands the draw executes and whether any of them
+/// exceeds the clamp limits. The readback stalls the GPU, so 0 (default) keeps it off.
+u32 DrawAttributeBudget();
+
+class Pass {
+public:
+    explicit Pass(const Instance& instance);
+    ~Pass();
+
+    /// Records the clamp of one dispatch command at src+offset into `cmdbuf` (outside rendering)
+    /// and returns the buffer/offset the indirect dispatch must read. Returns the source when the
+    /// clamp is disabled or unavailable.
+    /// `tag` names the caller in the clamp log (compute shader hash).
+    std::pair<vk::Buffer, vk::DeviceSize> Dispatch(vk::CommandBuffer cmdbuf,
+                                                   const VideoCore::Buffer* src, u64 offset,
+                                                   u64 tag);
+
+    /// Same for `count` draw commands of `stride` bytes (indexed or not); `tag` = vs hash (low
+    /// 32 bits) | fs hash << 32.
+    std::pair<vk::Buffer, vk::DeviceSize> Draw(vk::CommandBuffer cmdbuf,
+                                               const VideoCore::Buffer* src, u64 offset,
+                                               u32 count, u32 stride, bool indexed, u64 tag);
+
+private:
+    std::pair<vk::Buffer, vk::DeviceSize> Run(vk::CommandBuffer cmdbuf,
+                                              const VideoCore::Buffer* src, u64 offset, u32 count,
+                                              u32 stride, u32 mode, u64 tag);
+
+    const Instance& instance;
+    std::unique_ptr<VideoCore::Buffer> ring;
+    u64 ring_head{};
+    vk::UniquePipelineLayout layout;
+    vk::UniquePipeline pipeline;
+    u32 max_x{};
+    u32 max_yz{};
+    bool ready{};
+};
+
+/// The process-wide pass, created on first use and never destroyed (it would outlive the device).
+Pass& Shared(const Instance& instance);
+
+} // namespace IndirectClamp
+} // namespace Vulkan
