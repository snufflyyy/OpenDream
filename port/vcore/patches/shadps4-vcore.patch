+    b535_b4_writers += fmt::format(
+        "# b535_binding9_base=0x{:x}\tb535_binding9_size=0x{:x}\t"
+        "b535_binding9_stride={}\tb535_dispatch_sequence={}\toverlapping_prior_writers={}\n",
+        capture.traversal_pass0_b4_base, capture.traversal_pass0_b4_size,
