+inline bool CaptureOrderedChain() {
+    static const bool enabled = [] {
+        const char* ordered_chain = std::getenv("SHADPS4_DREAMS_ORDERED_CHAIN_CAPTURE_DIR");
+        return ordered_chain != nullptr && ordered_chain[0] != '\0';
