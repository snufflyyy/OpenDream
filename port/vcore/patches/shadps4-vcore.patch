+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// vcore: bounded-iteration guard for translated loops (see shader_recompiler/loop_guard.h).
+
+#pragma once
+
+#include <vector>
+#include <sirit/sirit.h>
+#include "common/types.h"
+
+namespace Shader::Backend::SPIRV {
+
+class EmitContext;
+using Sirit::Id;
+
+/// Decides whether the shader gets guarded loops (guard enabled and `has_loops`) and declares what
+/// the guard needs (addressing model, capabilities, the report-address specialization constant).
+/// Returns true when loops must be guarded.
+bool PrepareLoopGuard(EmitContext& ctx, bool has_loops);
+
+/// Declares the per-invocation counter. Must be called right after the entry block's label.
+void DeclareLoopGuardCounter(EmitContext& ctx);
+
+/// Resets the counter (first instruction of an outermost loop's merge block).
+void ResetLoopGuardCounter(EmitContext& ctx);
+
+/// Emits the counter step for a back edge whose "repeat" condition is `repeat_cond` and returns
+/// the guarded condition (repeat && budget left). May add labels (the trip report branch); the
+/// caller must refresh first_to_last_label_map for the current block afterwards.
+Id GuardLoopBackEdge(EmitContext& ctx, Id repeat_cond);
+
+/// Turns the address constant into an OpSpecConstant after assembly (Sirit has no
+/// OpSpecConstant), like the Dreams ordered-phase constant.
+void PatchLoopGuardSpecConstant(EmitContext& ctx, std::vector<u32>& spirv);
+
+} // namespace Shader::Backend::SPIRV
