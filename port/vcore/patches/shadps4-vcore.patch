+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include "shader_recompiler/ir/ir_emitter.h"
+
+namespace Shader::IR {
+
+// GCN CLASS selects any of ten IEEE classes. Bits above bit 9 are ignored.
+// Keep common predicates compact; classify the remaining masks from the bits so
+// signed zero, subnormals, and signaling/quiet NaNs remain distinguishable.
+inline U1 LowerFloatClass32(IREmitter& ir, const F32& value, const U32& mask) {
+    if (mask.IsImmediate()) {
+        switch (mask.U32() & 0x3ffU) {
+        case 0:
+            return ir.Imm1(false);
+        case 0x3ff:
+            return ir.Imm1(true);
+        case 3:
+            return ir.FPIsNan(value);
+        case 516:
+            return ir.FPIsInf(value);
+        case 60: {
+            const U32 bits{ir.BitCast<U32>(value)};
+            const U1 sign = ir.INotEqual(ir.BitwiseAnd(bits, ir.Imm32(0x80000000u)),
+                                         ir.Imm32(0));
+            return ir.LogicalAnd(sign, ir.LogicalNot(ir.FPIsNan(value)));
+        }
+        case 504:
+            return ir.LogicalNot(ir.LogicalOr(ir.FPIsNan(value), ir.FPIsInf(value)));
+        }
+    }
+    const U32 bits{ir.BitCast<U32>(value)};
+    const U32 exponent{ir.BitwiseAnd(bits, ir.Imm32(0x7f800000U))};
+    const U32 fraction{ir.BitwiseAnd(bits, ir.Imm32(0x007fffffU))};
+    const U1 sign = ir.INotEqual(ir.BitwiseAnd(bits, ir.Imm32(0x80000000U)), ir.Imm32(0));
+    const U1 exponent_zero = ir.IEqual(exponent, ir.Imm32(0));
+    const U1 exponent_full = ir.IEqual(exponent, ir.Imm32(0x7f800000U));
+    const U1 fraction_zero = ir.IEqual(fraction, ir.Imm32(0));
+    const U1 quiet = ir.INotEqual(ir.BitwiseAnd(fraction, ir.Imm32(0x00400000U)), ir.Imm32(0));
+    const U32 normal_class{ir.Select(sign, ir.Imm32(3), ir.Imm32(8))};
+    const U32 subnormal_class{ir.Select(sign, ir.Imm32(4), ir.Imm32(7))};
+    const U32 zero_class{ir.Select(sign, ir.Imm32(5), ir.Imm32(6))};
+    const U32 infinity_class{ir.Select(sign, ir.Imm32(2), ir.Imm32(9))};
+    const U32 nan_class{ir.Select(quiet, ir.Imm32(1), ir.Imm32(0))};
+    const U32 low_exponent_class{ir.Select(fraction_zero, zero_class, subnormal_class)};
+    const U32 high_exponent_class{ir.Select(fraction_zero, infinity_class, nan_class)};
+    const U32 finite_class{ir.Select(exponent_zero, low_exponent_class, normal_class)};
+    const U32 selected_class{ir.Select(exponent_full, high_exponent_class, finite_class)};
+    const U32 class_bit{ir.ShiftLeftLogical(ir.Imm32(1), selected_class)};
+    return ir.INotEqual(ir.BitwiseAnd(mask, class_bit), ir.Imm32(0));
+}
+
