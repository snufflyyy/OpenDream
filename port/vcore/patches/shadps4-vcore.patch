+int RunMaterialResourceCheck(const Instance& instance, const std::filesystem::path& path) {
+    std::string error;
+    const auto fail = [&](std::string_view message) {
+        WriteStatus(path, "material_resource_check", message);
+        return 3;
+    };
+    auto manifest = ReadKeyValues(path / "manifest.tsv", error);
+    if (!manifest || manifest->at("inputs_complete") != "true") {
+        return fail("material input capture is incomplete");
+    }
+    std::vector<AllocatedBuffer> buffers;
+    std::vector<u8> buffer_chunk(4 * 1024 * 1024);
+    for (u32 index = 0; index < 5; ++index) {
+        const auto filename = path / fmt::format("stage-0-buffer{}.bin", index);
+        std::error_code size_error;
+        const u64 size = std::filesystem::file_size(filename, size_error);
+        std::ifstream input(filename, std::ios::binary);
+        if (size_error || !input || !size) return fail("missing material buffer file");
+        auto buffer = CreateBuffer(instance, size,
+            vk::BufferUsageFlagBits::eStorageBuffer | vk::BufferUsageFlagBits::eTransferSrc |
+            vk::BufferUsageFlagBits::eTransferDst, {}, true, error);
+        if (!buffer) return fail(error);
+        for (u64 offset = 0; offset < size; offset += buffer_chunk.size()) {
+            const auto count = static_cast<size_t>(std::min<u64>(buffer_chunk.size(), size - offset));
+            input.read(reinterpret_cast<char*>(buffer_chunk.data()), count);
+            if (input.gcount() != static_cast<std::streamsize>(count))
+                return fail("short material buffer read");
+            if (!WriteMappedBuffer(instance.GetDevice(), *buffer, offset,
+                std::span<const u8>{buffer_chunk}.first(count), error)) return fail(error);
+        }
+        buffers.push_back(std::move(*buffer));
+    }
+    std::vector<vk::UniqueShaderModule> material_modules;
+    for (const char* name : {"vs.spv", "fs.spv"}) {
+        auto bytes = ReadBytes(path / name, error);
+        if (!bytes || bytes->size() % 4) return fail("invalid material shader bytecode");
+        std::vector<u32> words(bytes->size() / 4);
+        std::memcpy(words.data(), bytes->data(), bytes->size());
+        auto [result, shader] = instance.GetDevice().createShaderModuleUnique(
+            vk::ShaderModuleCreateInfo{.codeSize=bytes->size(), .pCode=words.data()});
+        if (result != vk::Result::eSuccess) return fail("material shader module creation failed");
+        material_modules.push_back(std::move(shader));
+    }
+    const std::array formats{vk::Format::eBc3UnormBlock, vk::Format::eD32Sfloat,
+        vk::Format::eR32G32Uint, vk::Format::eR8Unorm,
+        vk::Format::eR32G32Uint, vk::Format::eD32Sfloat};
+    std::vector<AllocatedImage> images;
+    for (u32 index = 0; index < formats.size(); ++index) {
+        const bool volume = index == 0 || index == 3;
+        const bool depth = index == 1 || index == 5;
+        const vk::Extent3D extent = volume ? vk::Extent3D{2048,2048,128} : vk::Extent3D{1360,768,1};
+        const u64 expected = volume ? 536870912 : (depth ? 4177920 : 8355840);
+        if (std::filesystem::file_size(path / fmt::format("image{}.bin",index)) != expected)
+            return fail("material texture size differs from its captured dimensions");
+        auto image = CreateImage(instance, volume ? vk::ImageType::e3D : vk::ImageType::e2D,
+            volume ? vk::ImageViewType::e3D : vk::ImageViewType::e2D, formats[index], extent, 1,
+            vk::ImageUsageFlagBits::eSampled | vk::ImageUsageFlagBits::eTransferDst |
+                vk::ImageUsageFlagBits::eTransferSrc,
+            depth ? vk::ImageAspectFlagBits::eDepth : vk::ImageAspectFlagBits::eColor,
+            {vk::ComponentSwizzle::eIdentity, vk::ComponentSwizzle::eIdentity,
+             vk::ComponentSwizzle::eIdentity, vk::ComponentSwizzle::eIdentity}, error);
+        if (!image) return fail(error);
+        images.push_back(std::move(*image));
+    }
+    const auto device = instance.GetDevice();
+    const auto add_buffer = [&](std::span<const u8> data, u64 size, bool address = false) {
+        auto value = CreateBuffer(instance, size, vk::BufferUsageFlagBits::eStorageBuffer |
+            vk::BufferUsageFlagBits::eTransferSrc | vk::BufferUsageFlagBits::eTransferDst,
+            data, address, error);
+        if (!value) return false;
+        buffers.push_back(std::move(*value));
+        return true;
+    };
+    auto srt = ReadBytes(path / "stage-0-srt.bin", error);
+    if (!srt || !add_buffer(*srt, srt->size())) return fail(error);
+    // Rebase the single sixteen-byte constant record into a local 16 KiB page.
+    auto constants = ReadBytes(path / "material-dynamic-constants.bin", error);
+    auto address = RequiredInteger<u64>(*manifest, "material_dynamic_constants_address", error);
+    if (!constants || constants->size() != 16 || !address) return fail("missing dynamic constants");
+    std::vector<u8> constant_page(16384);
+    const u64 page_offset = *address & 16383;
+    if (page_offset + 16 > constant_page.size()) return fail("constant record crosses page boundary");
+    std::memcpy(constant_page.data() + page_offset, constants->data(), 16);
+    auto page = CreateBuffer(instance, 16384, vk::BufferUsageFlagBits::eStorageBuffer,
+        constant_page, true, error);
+    if (!page) return fail(error);
+    std::vector<u64> page_table(u64{1} << 26);
+    page_table[(*address & ((u64{1} << 40) - 1)) >> 14] = page->address;
+    if (!add_buffer(ByteSpan<u64>(page_table), page_table.size() * 8) ||
+        !add_buffer({}, (u64{1} << 26) / 8) || !add_buffer({}, 128)) return fail(error);
+    auto key_bytes = ReadBytes(path / "graphics-key.bin", error);
+    GraphicsPipelineKey key;
+    if (!key_bytes || !CopyExact(*key_bytes, key, "graphics-key.bin", error)) return fail(error);
+    std::vector<vk::Format> target_formats;
+    std::vector<AllocatedImage> targets;
+    std::vector<AllocatedBuffer> readbacks;
+    for (u32 index = 0; index < key.num_color_attachments; ++index) {
+        const auto& color = key.color_buffers[index];
+        const auto format = instance.GetSupportedFormat(
+            LiverpoolToVK::SurfaceFormat(color.data_format, color.num_format),
+            vk::FormatFeatureFlagBits2::eColorAttachment);
+        auto target = CreateImage(instance, vk::ImageType::e2D, vk::ImageViewType::e2D,
+            format, {1360,768,1}, 1, vk::ImageUsageFlagBits::eColorAttachment |
+                vk::ImageUsageFlagBits::eTransferSrc, vk::ImageAspectFlagBits::eColor,
+            {vk::ComponentSwizzle::eIdentity,vk::ComponentSwizzle::eIdentity,
+             vk::ComponentSwizzle::eIdentity,vk::ComponentSwizzle::eIdentity}, error);
+        if (!target) return fail(error);
+        target_formats.push_back(format);
+        targets.push_back(std::move(*target));
+        auto readback = CreateBuffer(instance, 1360 * 768 * 16,
+            vk::BufferUsageFlagBits::eTransferDst, {}, false, error);
+        if (!readback) return fail(error);
+        readbacks.push_back(std::move(*readback));
+    }
+    std::array<vk::DescriptorSetLayoutBinding,16> bindings;
+    for (u32 index = 0; index < bindings.size(); ++index) {
+        bindings[index] = {.binding=index,
+            .descriptorType=index < 8 || index == 15 ? vk::DescriptorType::eStorageBuffer :
+                index == 14 ? vk::DescriptorType::eSampler : vk::DescriptorType::eSampledImage,
+            .descriptorCount=1,.stageFlags=vk::ShaderStageFlagBits::eVertex | vk::ShaderStageFlagBits::eFragment};
+    }
+    auto [layout_result, layout] = device.createDescriptorSetLayoutUnique({
+        .flags=vk::DescriptorSetLayoutCreateFlagBits::ePushDescriptorKHR,
+        .bindingCount=16,.pBindings=bindings.data()});
+    if (layout_result != vk::Result::eSuccess) return fail("material descriptor layout failed");
+    const auto layout_handle = *layout;
+    const vk::PushConstantRange push_range{.stageFlags=AllGraphicsStageBits,.offset=0,.size=128};
+    auto [pipeline_layout_result, pipeline_layout] = device.createPipelineLayoutUnique({
+        .setLayoutCount=1,.pSetLayouts=&layout_handle,.pushConstantRangeCount=1,.pPushConstantRanges=&push_range});
+    if (pipeline_layout_result != vk::Result::eSuccess) return fail("material pipeline layout failed");
+    std::vector<vk::PipelineShaderStageCreateInfo> shader_stages{
+        vk::PipelineShaderStageCreateInfo{.stage=vk::ShaderStageFlagBits::eVertex,.module=*material_modules[0],.pName="main"},
+        vk::PipelineShaderStageCreateInfo{.stage=vk::ShaderStageFlagBits::eFragment,.module=*material_modules[1],.pName="main"}};
+    const bool rect_list=key.prim_type==AmdGpu::PrimitiveType::RectList;
+    if (rect_list) {
+        // This captured material FS has no interpolated vertex attributes.
+        Shader::HwFragmentRuntimeInfo fs_runtime{};
+        using Shader::Backend::SPIRV::AuxShaderType;
+        for (const auto type : {AuxShaderType::RectListTCS, AuxShaderType::PassthroughTES}) {
+            const auto words=Shader::Backend::SPIRV::EmitAuxilaryTessShader(type,fs_runtime,1);
+            auto [result,module]=device.createShaderModuleUnique({
+                .codeSize=words.size()*sizeof(u32),.pCode=words.data()});
+            if (result!=vk::Result::eSuccess) return fail("rectangle expansion shader creation failed");
+            shader_stages.push_back({.stage=type==AuxShaderType::RectListTCS ?
+                vk::ShaderStageFlagBits::eTessellationControl : vk::ShaderStageFlagBits::eTessellationEvaluation,
+                .module=*module,.pName="main"});
+            material_modules.push_back(std::move(module));
+        }
+    }
+    const vk::PipelineTessellationStateCreateInfo tessellation{.patchControlPoints=3};
+    const vk::PipelineVertexInputStateCreateInfo vertex_input{};
+    const vk::PipelineInputAssemblyStateCreateInfo assembly{.topology=LiverpoolToVK::PrimitiveType(key.prim_type)};
+    // The translated VS maps guest viewport coordinates into a fixed 16K viewport.
+    const vk::Viewport viewport{0,0,16384,16384,0,1};
+    const vk::Rect2D scissor{{0,0},{1360,768}};
+    const vk::PipelineViewportStateCreateInfo viewport_state{.viewportCount=1,.pViewports=&viewport,.scissorCount=1,.pScissors=&scissor};
+    const vk::PipelineRasterizationStateCreateInfo raster{.polygonMode=vk::PolygonMode::eFill,.cullMode=vk::CullModeFlagBits::eNone,.lineWidth=1};
+    const vk::PipelineMultisampleStateCreateInfo multisample{.rasterizationSamples=vk::SampleCountFlagBits::e1};
+    std::vector<vk::PipelineColorBlendAttachmentState> blends(targets.size());
+    for (u32 index=0; index<blends.size(); ++index) blends[index].colorWriteMask=key.write_masks[index];
+    const vk::PipelineColorBlendStateCreateInfo blend{.attachmentCount=static_cast<u32>(blends.size()),.pAttachments=blends.data()};
+    const vk::PipelineRenderingCreateInfo rendering_formats{.colorAttachmentCount=static_cast<u32>(target_formats.size()),.pColorAttachmentFormats=target_formats.data()};
+    auto [pipeline_result,pipeline] = device.createGraphicsPipelineUnique({}, {
+        .pNext=&rendering_formats,.stageCount=static_cast<u32>(shader_stages.size()),.pStages=shader_stages.data(),
+        .pVertexInputState=&vertex_input,.pInputAssemblyState=&assembly,
+        .pTessellationState=rect_list ? &tessellation : nullptr,.pViewportState=&viewport_state,
+        .pRasterizationState=&raster,.pMultisampleState=&multisample,.pColorBlendState=&blend,.layout=*pipeline_layout});
+    if (pipeline_result != vk::Result::eSuccess) return fail("material graphics pipeline failed: " + vk::to_string(pipeline_result));
+    auto [pool_result,pool] = device.createCommandPoolUnique({
+        .flags=vk::CommandPoolCreateFlagBits::eResetCommandBuffer,
+        .queueFamilyIndex=instance.GetGraphicsQueueFamilyIndex()});
+    if (pool_result != vk::Result::eSuccess) return fail("material command pool failed");
+    const vk::CommandBufferAllocateInfo command_info{.commandPool=*pool,.level=vk::CommandBufferLevel::ePrimary,.commandBufferCount=1};
+    vk::CommandBuffer command;
+    if (device.allocateCommandBuffers(&command_info,&command) != vk::Result::eSuccess) return fail("material command allocation failed");
+    if (command.begin({.flags=vk::CommandBufferUsageFlagBits::eOneTimeSubmit}) != vk::Result::eSuccess)
+        return fail("material command begin failed");
+    constexpr u64 TextureUploadChunk = 4 * 1024 * 1024;
+    auto staging = CreateBuffer(instance,TextureUploadChunk,
+        vk::BufferUsageFlagBits::eTransferSrc,{},false,error);
+    if (!staging) return fail(error);
+    std::vector<u8> texture_chunk(TextureUploadChunk);
+    const std::array<u32,6> bytes_per_block{16,4,8,1,8,4};
+    for (u32 index=0; index<images.size(); ++index) {
+        std::ifstream input(path / fmt::format("image{}.bin",index),std::ios::binary);
+        if (!input) return fail("missing material texture file");
+        const auto aspect=index==1 || index==5 ? vk::ImageAspectFlagBits::eDepth : vk::ImageAspectFlagBits::eColor;
+        auto barrier=ImageBarrier(*images[index].image,aspect,vk::ImageLayout::eUndefined,
+            vk::ImageLayout::eTransferDstOptimal,{},vk::AccessFlagBits::eTransferWrite);
+        command.pipelineBarrier(vk::PipelineStageFlagBits::eTopOfPipe,vk::PipelineStageFlagBits::eTransfer,{}, {},{},barrier);
+        const u32 block = index==0 ? 4 : 1;
+        const auto extent=images[index].extent;
+        const u64 row_bytes=u64{(extent.width+block-1)/block}*bytes_per_block[index];
+        const u32 rows_per_chunk=static_cast<u32>(TextureUploadChunk/row_bytes)*block;
+        if (!rows_per_chunk) return fail("material texture row exceeds upload budget");
+        for (u32 slice=0;slice<extent.depth;++slice) {
+            for (u32 row=0;row<extent.height;row+=rows_per_chunk) {
+                const u32 height=std::min(rows_per_chunk,extent.height-row);
+                const u64 count=row_bytes*((height+block-1)/block);
+                input.read(reinterpret_cast<char*>(texture_chunk.data()),count);
+                if (input.gcount()!=static_cast<std::streamsize>(count)) return fail("short material texture read");
+                if (!WriteMappedBuffer(device,*staging,0,
+                    std::span<const u8>{texture_chunk}.first(count),error)) return fail(error);
+                command.copyBufferToImage(*staging->buffer,*images[index].image,vk::ImageLayout::eTransferDstOptimal,
+                    vk::BufferImageCopy{.imageSubresource={aspect,0,0,1},
+                        .imageOffset={0,static_cast<s32>(row),static_cast<s32>(slice)},
+                        .imageExtent={extent.width,height,1}});
+                if (command.end()!=vk::Result::eSuccess ||
+                    instance.GetGraphicsQueue().submit(vk::SubmitInfo{.commandBufferCount=1,.pCommandBuffers=&command})!=vk::Result::eSuccess ||
+                    instance.GetGraphicsQueue().waitIdle()!=vk::Result::eSuccess)
+                    return fail("material texture upload failed");
+                // Reuse staging bytes only after this upload has completed.
+                if (command.reset({})!=vk::Result::eSuccess ||
+                    command.begin({.flags=vk::CommandBufferUsageFlagBits::eOneTimeSubmit})!=vk::Result::eSuccess)
+                    return fail("material upload command reset failed");
+            }
+        }
+        barrier=ImageBarrier(*images[index].image,aspect,vk::ImageLayout::eTransferDstOptimal,
+            vk::ImageLayout::eShaderReadOnlyOptimal,vk::AccessFlagBits::eTransferWrite,vk::AccessFlagBits::eShaderRead);
+        command.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer,vk::PipelineStageFlagBits::eFragmentShader,{}, {},{},barrier);
+    }
+    std::vector<vk::RenderingAttachmentInfo> attachments;
+    for (auto& target:targets) {
+        auto barrier=ImageBarrier(*target.image,vk::ImageAspectFlagBits::eColor,vk::ImageLayout::eUndefined,
+            vk::ImageLayout::eColorAttachmentOptimal,{},vk::AccessFlagBits::eColorAttachmentWrite);
+        command.pipelineBarrier(vk::PipelineStageFlagBits::eTopOfPipe,vk::PipelineStageFlagBits::eColorAttachmentOutput,{}, {},{},barrier);
+        attachments.push_back({.imageView=*target.view,.imageLayout=vk::ImageLayout::eColorAttachmentOptimal,
+            .loadOp=vk::AttachmentLoadOp::eClear,.storeOp=vk::AttachmentStoreOp::eStore});
+    }
+    AmdGpu::Sampler sampler_state{};
+    auto sampler_bytes=ReadBytes(path / "stage-0-sampler0.bin",error);
+    if (!sampler_bytes || !CopyExact(*sampler_bytes,sampler_state,"sampler",error)) return fail(error);
+    VideoCore::Sampler sampler{instance,sampler_state,{},false};
+    std::array<vk::DescriptorBufferInfo,9> buffer_infos;
+    for (u32 index=0;index<9;++index) buffer_infos[index]={*buffers[index].buffer,0,buffers[index].size};
+    std::array<vk::DescriptorImageInfo,7> image_infos;
+    for (u32 index=0;index<6;++index) image_infos[index]={.imageView=*images[index].view,.imageLayout=vk::ImageLayout::eShaderReadOnlyOptimal};
+    image_infos[6]={.sampler=sampler.Handle()};
+    std::array<vk::WriteDescriptorSet,16> writes;
+    for (u32 index=0;index<16;++index) {
+        writes[index]={.dstBinding=index,.descriptorCount=1,.descriptorType=bindings[index].descriptorType};
+        if (index<8 || index==15) writes[index].pBufferInfo=&buffer_infos[index==15 ? 8 : index];
+        else writes[index].pImageInfo=&image_infos[index-8];
+    }
+    auto push=ReadBytes(path / "push-data.bin",error);
+    if (!push || push->size()!=128) return fail("invalid captured push constants");
+    Shader::PushData replay_push;
+    std::memcpy(&replay_push,push->data(),sizeof(replay_push));
+    // Captured buffers start at the guest descriptor address, so the emulator's
+    // alignment adjustments no longer apply to the standalone allocations.
+    replay_push.buf_offsets.fill(0);
+    auto regs_bytes=ReadBytes(path / "gpu-regs.bin",error);
+    AmdGpu::Regs captured_regs;
+    if (!regs_bytes || !CopyExact(*regs_bytes,captured_regs,"gpu-regs.bin",error)) return fail(error);
+    command.beginRendering({.renderArea=scissor,.layerCount=1,
+        .colorAttachmentCount=static_cast<u32>(attachments.size()),.pColorAttachments=attachments.data()});
+    command.bindPipeline(vk::PipelineBindPoint::eGraphics,*pipeline);
+    command.pushDescriptorSetKHR(vk::PipelineBindPoint::eGraphics,*pipeline_layout,0,writes);
+    command.pushConstants(*pipeline_layout,AllGraphicsStageBits,0,128,&replay_push);
+    command.draw(captured_regs.num_indices,captured_regs.num_instances.NumInstances(),0,0);
+    command.endRendering();
+    for (u32 index=0;index<targets.size();++index) {
+        auto barrier=ImageBarrier(*targets[index].image,vk::ImageAspectFlagBits::eColor,
+            vk::ImageLayout::eColorAttachmentOptimal,vk::ImageLayout::eTransferSrcOptimal,
+            vk::AccessFlagBits::eColorAttachmentWrite,vk::AccessFlagBits::eTransferRead);
+        command.pipelineBarrier(vk::PipelineStageFlagBits::eColorAttachmentOutput,vk::PipelineStageFlagBits::eTransfer,{}, {},{},barrier);
+        command.copyImageToBuffer(*targets[index].image,vk::ImageLayout::eTransferSrcOptimal,*readbacks[index].buffer,
+            vk::BufferImageCopy{.imageSubresource={vk::ImageAspectFlagBits::eColor,0,0,1},.imageExtent={1360,768,1}});
+    }
+    if (command.end()!=vk::Result::eSuccess) return fail("material command end failed");
+    if (instance.GetGraphicsQueue().submit(vk::SubmitInfo{.commandBufferCount=1,.pCommandBuffers=&command}) != vk::Result::eSuccess ||
+        instance.GetGraphicsQueue().waitIdle()!=vk::Result::eSuccess) return fail("material GPU submission failed");
+    std::string target_metadata;
+    for (u32 index=0;index<readbacks.size();++index) {
+        auto bytes=ReadMappedBuffer(device,readbacks[index],error);
+        if (!bytes || !WriteBinary(path / fmt::format("material-output{}.bin",index),*bytes)) return fail("material output readback failed");
+        target_metadata += fmt::format("output{}\t{}\n",index,vk::to_string(target_formats[index]));
+    }
+    std::ofstream(path / "material-outputs.tsv") << target_metadata;
+    WriteStatus(path, "material_draw_executed", "Diagnostic material draw executed; captured depth/blending state and output parity remain unverified.");
+    LOG_INFO(Render_Vulkan, "Standalone material resources verified on {}", instance.GetModelName());
+    return 0;
+}
+
+int Run(const std::filesystem::path& bundle_path,
+        const std::optional<std::filesystem::path>& candidate_directory) {
+    if (!std::filesystem::is_directory(bundle_path)) {
+        LOG_ERROR(Render_Vulkan, "Dreams replay bundle is not a directory: {}",
+                  bundle_path.string());
+        return 2;
+    }
+
+    LOG_INFO(Render_Vulkan, "Starting offline Dreams draw replay from {}", bundle_path.string());
+    std::string phase_error;
+    const auto phase_manifest = ReadKeyValues(bundle_path / "manifest.tsv", phase_error);
+    if (phase_manifest && phase_manifest->contains("phase") &&
+        phase_manifest->at("phase") == "material-inputs") {
+        // Small CPU-only metadata audit remains available even for rejected captures.
+        std::string audit_error;
+        auto saved_regs=ReadBytes(bundle_path / "gpu-regs.bin",audit_error);
+        auto saved_key=ReadBytes(bundle_path / "graphics-key.bin",audit_error);
+        auto saved_push=ReadBytes(bundle_path / "push-data.bin",audit_error);
+        AmdGpu::Regs audit_regs;
+        GraphicsPipelineKey audit_key;
+        Shader::PushData audit_push;
+        if (saved_regs && saved_key && saved_push &&
+            CopyExact(*saved_regs,audit_regs,"regs",audit_error) &&
+            CopyExact(*saved_key,audit_key,"key",audit_error) &&
+            CopyExact(*saved_push,audit_push,"push",audit_error)) {
+            std::ofstream audit(bundle_path / "material-cpu-audit.tsv");
+            audit << fmt::format("vertices\t{}\ninstances\t{}\nprimitive\t{}\n"
+                "viewport_offset\t{},{}\nviewport_scale\t{},{}\n",
+                audit_regs.num_indices,audit_regs.num_instances.NumInstances(),
+                static_cast<u32>(audit_key.prim_type),audit_push.xoffset,audit_push.yoffset,
+                audit_push.xscale,audit_push.yscale);
+            for (u32 index=0;index<audit_key.num_color_attachments;++index)
+                audit << fmt::format("target{}_write_mask\t{}\n",index,
+                    static_cast<VkColorComponentFlags>(audit_key.write_masks[index]));
+            for (u32 index=0;index<16;++index)
+                audit << fmt::format("buffer{}_offset\t{}\n",index,audit_push.buf_offsets[index]);
+            if (audit_key.prim_type==AmdGpu::PrimitiveType::RectList) {
+                Shader::HwFragmentRuntimeInfo fs_runtime{};
+                using Shader::Backend::SPIRV::AuxShaderType;
+                const auto control=Shader::Backend::SPIRV::EmitAuxilaryTessShader(
+                    AuxShaderType::RectListTCS,fs_runtime,1);
+                const auto evaluation=Shader::Backend::SPIRV::EmitAuxilaryTessShader(
+                    AuxShaderType::PassthroughTES,fs_runtime,1);
+                WriteBinary(bundle_path / "rectangle-control.spv",ByteSpan<u32>(control));
+                WriteBinary(bundle_path / "rectangle-evaluation.spv",ByteSpan<u32>(evaluation));
+            }
+        }
+        // Full sculpt atlases caused severe host stalls during exploratory replay.
+        // Check only file metadata here, before creating any Vulkan device. Large
+        // captures require a sparse replay implementation, not an override.
+        constexpr u64 MaterialInputBudget = 256ULL * 1024 * 1024;
+        u64 input_bytes = 0;
+        std::error_code size_error;
+        for (const auto& entry : std::filesystem::directory_iterator(bundle_path)) {
+            const auto name = entry.path().filename().string();
+            if (!name.starts_with("image") && !name.starts_with("stage-0-buffer")) continue;
+            if (entry.path().extension() != ".bin") continue;
+            const auto size = entry.file_size(size_error);
+            if (size_error || size > MaterialInputBudget ||
+                input_bytes > MaterialInputBudget - size) {
+                WriteStatus(bundle_path, "material_budget_rejected",
+                    "Material inputs exceed the 256 MiB replay limit. No GPU device was created. Sparse texture and buffer replay is required.");
+                return 2;
+            }
+            input_bytes += size;
+        }
+        Instance material_instance{HeadlessDevice, EmulatorSettings.GetGpuId(),
+            EmulatorSettings.IsVkValidationEnabled(), EmulatorSettings.IsVkCrashDiagnosticEnabled()};
+        return RunMaterialResourceCheck(material_instance, bundle_path);
+    }
+    auto loaded = LoadBundle(bundle_path);
+    if (!loaded.bundle) {
+        WriteStatus(bundle_path, loaded.stage, loaded.error, loaded.missing_files);
+        LOG_ERROR(Render_Vulkan, "Dreams replay rejected bundle at {}: {}", loaded.stage,
+                  loaded.error);
+        return 2;
+    }
+
+    Instance instance{HeadlessDevice, EmulatorSettings.GetGpuId(),
+                      EmulatorSettings.IsVkValidationEnabled(),
+                      EmulatorSettings.IsVkCrashDiagnosticEnabled()};
+    if (candidate_directory) {
+        return RunCandidateBatch(instance, *loaded.bundle, bundle_path, *candidate_directory);
+    }
+    const ReplayOptions options{.output_directory = bundle_path};
+    auto replay = RunExactReplay(instance, *loaded.bundle, options);
+    if (!replay.completed) {
+        WriteStatus(bundle_path, "draw_execution", replay.error);
+        LOG_ERROR(Render_Vulkan, "Offline Dreams replay execution failed on {}: {}",
+                  instance.GetModelName(), replay.error);
+        return 3;
+    }
+    if (!replay.parity) {
+        WriteStatus(bundle_path, "oracle_compare", replay.error);
+        LOG_ERROR(Render_Vulkan, "Offline Dreams replay did not match the capture on {}: {}",
+                  instance.GetModelName(), replay.error);
+        return 4;
+    }
+    WriteStatus(bundle_path, "parity_verified", {}, {}, true);
+    LOG_INFO(Render_Vulkan, "Offline Dreams replay exactly matched color/depth on {}",
+             instance.GetModelName());
+    return 0;
+}
+
+} // namespace Vulkan::DreamsDrawReplay
