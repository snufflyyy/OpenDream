new file mode 100644
index 0000000000000000000000000000000000000000..4dccd4af0b6726af99a7906c16ec56939d13d395
--- /dev/null
+++ b/src/shader_recompiler/loop_guard.h
@@ -0,0 +1,74 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// vcore: GPU hang guard shared by the SPIR-V backend and the Vulkan renderer.
+//
+// Translated guest loops get a bounded iteration budget (see emit_spirv_loop_guard.cpp): a loop
+// whose exit depends on data (list/tree walks, spin waits) would otherwise run forever on
+// inconsistent data and hang the GPU ring, which makes amdgpu reset the whole GPU. When a guard
+// trips, the shader reports it into a small host-visible buffer through a buffer device address
+// passed as a specialization constant, so the SPIR-V itself stays address independent and can be
+// cached. The renderer polls that buffer and logs the shader hash.
+
+#pragma once
+
+#include <cstdlib>
+#include <cstring>
+#include "common/types.h"
+
+namespace Shader::LoopGuard {
+
+/// Specialization constant id of the report buffer address (u64). Unused ids are ignored by
+/// Vulkan, so pipelines pass it to every stage.
+constexpr u32 AddressSpecId = 0x4c47; // 'LG'
+/// Default value of the address constant in the SPIR-V. Its high word marks "no report buffer"
+/// (pipelines created without the specialization, e.g. fork replay pipelines).
+constexpr u64 AddressSentinel = 0x4c4f4f5047554152ULL;
+constexpr u32 AddressSentinelHigh = static_cast<u32>(AddressSentinel >> 32);
+
+/// Report buffer layout: SlotCount slots of SlotDwords dwords:
+///   [0] trip count (atomic add), [1] pgm_hash low, [2] pgm_hash high, [3] reserved.
+/// Followed by the indirect-argument clamp report area (vk_indirect_clamp.cpp).
+constexpr u32 SlotCount = 4096;
+constexpr u32 SlotDwords = 4;
+constexpr u32 SlotBytes = SlotDwords * sizeof(u32);
+constexpr u32 IndirectReportOffset = SlotCount * SlotBytes;
+constexpr u32 IndirectReportBytes = 256;
+constexpr u32 ReportBufferBytes = IndirectReportOffset + IndirectReportBytes;
+
+constexpr u32 DefaultLimit = 1u << 20;
+constexpr u32 MinLimit = 16;
+constexpr u32 MaxLimit = 1u << 30;
+
+/// Back-edge budget per invocation and outermost loop entry (nested loops share it).
+/// VCORE_LOOP_GUARD=<n>: 0 or "off" disables the guard; unset uses DefaultLimit.
+inline u32 Limit() {
+    static const u32 limit = [] {
+        const char* value = std::getenv("VCORE_LOOP_GUARD");
+        if (value == nullptr || *value == '\0') {
+            return DefaultLimit;
+        }
+        if (std::strcmp(value, "off") == 0) {
+            return 0u;
+        }
+        char* end{};
+        const unsigned long long parsed = std::strtoull(value, &end, 0);
+        if (end == value) {
+            return DefaultLimit;
+        }
+        if (parsed == 0) {
+            return 0u;
+        }
+        if (parsed < MinLimit) {
+            return MinLimit;
+        }
+        return parsed > MaxLimit ? MaxLimit : static_cast<u32>(parsed);
+    }();
+    return limit;
+}
+
+constexpr u32 SlotOf(u64 pgm_hash) {
+    return static_cast<u32>((pgm_hash * 0x9e3779b97f4a7c15ULL) >> 52) & (SlotCount - 1);
+}
+
+} // namespace Shader::LoopGuard
