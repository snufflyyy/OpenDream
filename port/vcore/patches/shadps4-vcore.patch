+static bool TraceDreamsResetEnabled() {
+    return static_cast<const char*>(nullptr) /* release: DIAG_RESET_DIR disabled */ &&
+           Common::ElfInfo::Instance().GameSerial() == ::Common::DreamsTitleId{};
