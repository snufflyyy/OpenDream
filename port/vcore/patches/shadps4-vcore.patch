+// DREAMS-REBASE: AppendDreamsDynamicReadBarrier removed; dynamic reads are tracked through
+// bound_buffers/Runtime in Rasterizer::BindResources.
+
+static bool NeedsShaderWriteRefresh(const Pipeline* pipeline,
+                                    const VideoCore::BufferCache& cache,
+                                    Core::MemoryManager* memory);
+
+// DREAMS-REBASE: FinalizeDreamsDynamicReads removed (see BindResources).
+
+void Rasterizer::Draw(bool is_indexed, u32 index_offset) {
+    RENDERER_TRACE;
+
+    FlushPeriodically();
+    scheduler.PopPendingOperations();
+
+    if (!FilterDraw()) {
+        return;
+    }
+
+    const auto& regs = liverpool->regs;
+    if (is_indexed) {
+        const u32 index_size = regs.index_buffer_type.index_type == AmdGpu::IndexType::Index16
+                                   ? sizeof(u16)
+                                   : sizeof(u32);
+        LogDreamsF030ArenaAccess(
+            "draw-index", regs.index_base_address.Address<VAddr>() + u64{index_offset} * index_size,
+            u64{regs.num_indices} * index_size);
+    }
+    const GraphicsPipeline* pipeline = pipeline_cache.GetGraphicsPipeline();
+    if (!pipeline) {
+        return;
+    }
+    if (ApplyDreamsCe3SrtRefresh(pipeline, memory, buffer_cache)) {
+        pipeline = pipeline_cache.GetGraphicsPipeline();
+        if (!pipeline) {
+            return;
+        }
+    }
+    LogDreamsF030VertexInputs(*pipeline, regs, "draw-direct");
+
+    const u32 gpu_profile_ordinal = ConsumeDreamsGpuProfileEvent();
+    if (gpu_profile_ordinal != 0) {
+        scheduler.Finish();
+    }
+    const auto gpu_profile_start = std::chrono::steady_clock::now();
+
+    TraceDreamsGraphicsPipeline(false, is_indexed, pipeline, regs, regs.num_indices,
+                                regs.num_instances.NumInstances(), 0, 0, 0, 0);
+
+    PrepareRenderState(pipeline);
+    ApplyDreamsDccBdaPrewarm(pipeline, memory, buffer_cache);
+    ApplyDreamsCe3BdaPrewarm(pipeline, memory, buffer_cache);
+    if (!BindResources(pipeline)) {
+        return;
+    }
+    CaptureDreamsMaterialInputs(pipeline, is_indexed, index_offset);
+    if (dreams_frame_capture_active) RefreshBufferResources(pipeline);
+    if (g_dreams_terminal_consumer_trace_active) {
+        bool found{};
+        for (const auto* stage : pipeline->GetStages()) {
+            if (stage != nullptr) {
+                found |= LogDreamsTerminalShaderOverlaps("draw-direct", g_compute_dispatch_sequence,
+                                                         *stage);
+            }
+        }
+        if (found) {
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams terminal bound draw direct indexed={} indices={} instances={} "
+                        "index_offset={}",
+                        is_indexed, regs.num_indices, regs.num_instances.NumInstances(),
+                        index_offset);
+            g_dreams_terminal_consumer_trace_active = false;
+            LOG_WARNING(Render_Vulkan, "Dreams terminal consumer trace complete");
+        }
+    }
+    const auto state = BeginRendering(pipeline);
+
+    TraceDreamsSceneGraphicsDraw(false, is_indexed, pipeline, regs, state, regs.num_indices,
+                                 regs.num_instances.NumInstances(), 0, 0, 0, 0);
+
+    static u32 dreams_fleck_direct_trace_count{};
+    if (IsDreamsFleckPipeline(pipeline) && dreams_fleck_direct_trace_count < 32) {
+        const u32 ordinal = ++dreams_fleck_direct_trace_count;
+        LogDreamsRenderPipeline("decoder", ordinal, false, is_indexed, pipeline, regs, state);
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams decoder direct args #{} vertices_or_indices={} instances={} "
+                    "index_offset={}",
+                    ordinal, regs.num_indices, regs.num_instances.NumInstances(), index_offset);
+    }
+    static u32 dreams_visibility_direct_trace_count{};
+    if (IsDreamsVisibilityPipeline(pipeline) && dreams_visibility_direct_trace_count < 64) {
+        const u32 ordinal = ++dreams_visibility_direct_trace_count;
+        LogDreamsRenderPipeline("visibility", ordinal, false, is_indexed, pipeline, regs, state);
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams visibility direct args #{} vertices_or_indices={} instances={} "
+                    "index_offset={}",
+                    ordinal, regs.num_indices, regs.num_instances.NumInstances(), index_offset);
+    }
+    static u32 dreams_sprite_geometry_direct_trace_count{};
+    if (IsDreamsSpriteGeometryPipeline(pipeline) &&
+        dreams_sprite_geometry_direct_trace_count < 64) {
+        const u32 ordinal = ++dreams_sprite_geometry_direct_trace_count;
+        LogDreamsRenderPipeline("sprite-geometry", ordinal, false, is_indexed, pipeline, regs,
+                                state);
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams sprite geometry direct args #{} vertices_or_indices={} instances={} "
+                    "index_offset={}",
+                    ordinal, regs.num_indices, regs.num_instances.NumInstances(), index_offset);
+    }
+
+    const bool stabilize_graphics_buffers = StabilizeDreamsGraphicsBuffers();
+    if (stabilize_graphics_buffers) {
+        // BeginRendering and the graphics-only ranges can grow cache buffers after shader
+        // descriptors were first resolved. Settle those ranges without changing access state,
+        // then refresh only the shader buffer descriptors against the final cache union.
+        BindVertexBuffers(pipeline, true);
+        if (is_indexed) {
+            BindIndexBuffer(index_offset, false, true);
+        }
+        const u32 changed_handles = RefreshBufferResources(pipeline, true);
+        static u32 dreams_graphics_stabilize_direct_log_count{};
+        if ((changed_handles != 0 || dreams_graphics_stabilize_direct_log_count == 0) &&
+            dreams_graphics_stabilize_direct_log_count++ < 64) {
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams graphics stabilization direct indexed={} changed_handles={}",
+                        is_indexed, changed_handles);
+        }
+    }
+
+    BindVertexBuffers(pipeline);
+    if (is_indexed) {
+        BindIndexBuffer(index_offset);
+    }
+
+    const auto& vs_info = pipeline->GetStage(Shader::SwStage::Vertex);
+    const auto& fetch_shader = pipeline->GetFetchShader();
+    const auto [vertex_offset, instance_offset] = GetDrawOffsets(regs, vs_info, fetch_shader);
+
+    // Target preparation can read back aliased buffer bytes after BindResources
+    // announced this draw's writes. Re-establish only lost declarations before
+    // execution; otherwise the subsequent CPU access can see stale backing data.
+    if (NeedsShaderWriteRefresh(pipeline, buffer_cache, memory)) {
+        RefreshBufferResources(pipeline);
+        static u32 write_refresh_reports{};
+        if (write_refresh_reports++ < 4) {
+            LOG_WARNING(Render_Vulkan, "Restored pending shader writes after target readback");
+        }
+    }
+    // DREAMS-REBASE: FinalizeDreamsDynamicReads is replaced by tracking the resolved dynamic
+    // read ranges in BindResources (bound_buffers + runtime hazard tracking).
+    if (needs_barrier) {
+        runtime.FlushBarriers();
+    }
+
+    BindPipelineResources(pipeline, set_writes, buffer_barriers, push_data);
+    if (stabilize_graphics_buffers) {
+        ApplyDreamsGraphicsBufferBarrier(scheduler);
+    }
+    UpdateDynamicState(pipeline, is_indexed);
+    scheduler.BeginRendering(state);
+
+    const auto cmdbuf = scheduler.CommandBuffer();
+    cmdbuf.bindPipeline(vk::PipelineBindPoint::eGraphics, pipeline->Handle());
+
+    u64 vertex_hash{};
+    u64 fragment_hash{};
+    for (const auto* shader : pipeline->GetStages()) {
+        if (shader == nullptr) {
+            continue;
+        }
+        if (shader->sw_stage == Shader::SwStage::Vertex) {
+            vertex_hash = shader->pgm_hash;
+        } else if (shader->sw_stage == Shader::SwStage::Fragment) {
+            fragment_hash = shader->pgm_hash;
+        }
+    }
+    const auto draw_profile =
+        dreams_performance_profiler
+            ? dreams_performance_profiler->BeginDraw(cmdbuf, vertex_hash, fragment_hash, false,
+                                                     is_indexed, regs.num_indices,
+                                                     regs.num_instances.NumInstances(), 1, false)
+            : DreamsPerformanceProfiler::DrawToken{};
+    if (is_indexed) {
+        cmdbuf.drawIndexed(regs.num_indices, regs.num_instances.NumInstances(), 0,
+                           s32(vertex_offset), instance_offset);
+    } else {
+        cmdbuf.draw(regs.num_indices, regs.num_instances.NumInstances(), vertex_offset,
+                    instance_offset);
+    }
+    if (dreams_performance_profiler) {
+        dreams_performance_profiler->EndDraw(cmdbuf, draw_profile);
+    }
+    DebugState.IncDrawCall();
+    if (dreams_performance_profiler) {
+        dreams_performance_profiler->CountDraw();
+    }
+
+    // One-shot material inspection. The private surface-layer mode captures both
+    // depth/ID pairs and only their referenced records, never whole sculpt atlases.
+    // It has its own throttled trigger, independent of the per-dispatch recorder.
+    if (fragment_hash == 0xdcc325c2 &&
+        Common::ElfInfo::Instance().GameSerial() == ::Common::DreamsTitleId{}) {
+        const char* surface_root = DreamsEnvironment<"SHADPS4_DREAMS_SURFACE_LAYER_CAPTURE_DIR">();
+        const char* root = surface_root ? surface_root
+            : DreamsEnvironment<"SHADPS4_DREAMS_CANDIDATE_SHADER_DIR">();
+        static bool surface_capture_consumed{};
+        static std::chrono::steady_clock::time_point surface_next_poll{};
+        bool poll_surface = root != nullptr;
+        if (surface_root) {
+            const auto now = std::chrono::steady_clock::now();
+            poll_surface = !surface_capture_consumed && now >= surface_next_poll;
+            if (poll_surface) surface_next_poll = now + std::chrono::milliseconds{500};
+        }
+        if (poll_surface) {
+            const std::filesystem::path output = std::filesystem::path{root} / "material-gpu-output";
+            std::error_code error;
+            if (dreams_material_fragment_image_bindings.size() >= 6 &&
+                cb_descs[2].image_id && cb_descs[3].image_id &&
+                std::filesystem::exists(output / "capture.trigger", error) &&
+                std::filesystem::remove(output / "capture.trigger", error)) {
+                if (surface_root) surface_capture_consumed = true;
+                scheduler.EndRendering();
+                std::string metadata{"schema\t2\nphase\tmaterial-live-gpu-output\n"
+                    "additional_draws\t0\nvolume_downloads\t0\n"
+                    "same_capture_as_old_cpu_reference\tfalse\n"};
+                const u32 material_present_counter = DebugState.GetFrameNum();
+                metadata += fmt::format("presentation_counter\t{}\n", material_present_counter);
+                // The paired request is created only after the selected sculpt input capture.
+                // A present counter is asynchronous: record it as context, not proof that
+                // every captured resource belongs to one complete GPU frame.
+                u32 geometry_present_begin{}, geometry_present_end{};
+                u64 geometry_color_address{};
+                std::ifstream pair(std::filesystem::path{root} / "paired-geometry.txt");
+                if (pair >> geometry_present_begin >> geometry_present_end >> std::hex >> geometry_color_address) {
+                    const auto input_id = dreams_material_fragment_image_bindings[4].image_id;
+                    const VAddr input_address = input_id ? texture_cache.GetImage(input_id).info.guest_address : 0;
+                    metadata += fmt::format("ordered_after_geometry_capture\ttrue\n"
+                        "geometry_presentation_begin\t{}\ngeometry_presentation_end\t{}\n"
+                        "geometry_color0_address\t{:#x}\nmaterial_ids_address\t{:#x}\n"
+                        "geometry_target_matches_material_ids\t{}\n",
+                        geometry_present_begin, geometry_present_end, geometry_color_address,
+                        input_address, geometry_color_address != 0 && geometry_color_address == input_address);
+                }
+                bool ok = true;
+                u64 hash{};
+                std::vector<u8> primary_ids, secondary_ids;
+                const auto capture = [&](const char* role, VideoCore::ImageId id,
+                                         std::vector<u8>* retained_ids = nullptr) {
+                    if (!id) return false;
+                    auto& image = texture_cache.GetImage(id);
+                    const u64 bytes = u64{image.info.size.width} * image.info.size.height *
+                                      image.info.num_bits / 8;
+                    if (!bytes || bytes > 16_MB || image.info.props.is_block ||
+                        image.info.size.depth != 1 || image.info.resources.layers != 1 ||
+                        image.info.resources.levels != 1 || image.info.num_samples != 1 ||
+                        (retained_ids && image.info.pixel_format != vk::Format::eR32G32Uint)) return false;
+                    auto& download = DreamsDownloadBuffer();
+                    const auto [data, offset] = download.Map(bytes, 4);
+                    if (!data) return false;
+                    download.Commit();
+                    const auto saved = image.backing->state;
+                    const auto saved_subresources = image.backing->subresource_states;
+                    const std::array copies{vk::BufferImageCopy{
+                        .bufferOffset = offset,
+                        .imageSubresource = {image.info.props.is_depth ? vk::ImageAspectFlagBits::eDepth
+                                                                    : vk::ImageAspectFlagBits::eColor,
+                                             0, 0, 1},
+                        .imageExtent = {image.info.size.width, image.info.size.height, 1}}};
+                    DreamsDownloadImage(image, copies, download, offset, bytes);
+                    const auto restore = [&](const auto& saved_state, auto range) {
+                        const auto barriers = DreamsImageBarriers(image, saved_state.layout,
+                            saved_state.access_mask, saved_state.pl_stage, range);
+                        if (!barriers.empty()) scheduler.CommandBuffer().pipelineBarrier2(
+                            vk::DependencyInfo{.imageMemoryBarrierCount = static_cast<u32>(barriers.size()),
+                                               .pImageMemoryBarriers = barriers.data()});
+                    };
+                    if (saved_subresources.empty()) {
+                        restore(saved, std::optional<VideoCore::SubresourceRange>{});
+                    } else {
+                        restore(saved_subresources[0], std::optional{VideoCore::SubresourceRange{
+                            .base = {.level = 0, .layer = 0}, .extent = {.levels = 1, .layers = 1}}});
+                    }
+                    image.backing->state = saved;
+                    image.backing->subresource_states = saved_subresources;
+                    scheduler.Finish();
+                    download.InvalidateMappedRange(offset, bytes);
+                    const bool written = WriteDreamsCaptureBytes(output / fmt::format("{}.bin", role),
+                        std::span<const u8>{data, static_cast<size_t>(bytes)}, hash);
+                    metadata += fmt::format("{}\t{}x{};format={};bytes={};hash={:#x};guest={:#x}\n", role,
+                        image.info.size.width, image.info.size.height,
+                        vk::to_string(image.info.pixel_format), bytes, hash, image.info.guest_address);
+                    if (retained_ids) retained_ids->assign(data, data + bytes);
+                    return written;
+                };
+                ok &= capture("gpu-albedo", cb_descs[2].image_id);
+                ok &= capture("gpu-normal", cb_descs[3].image_id);
+                ok &= capture("input-ids", dreams_material_fragment_image_bindings[4].image_id,
+                    surface_root ? &primary_ids : nullptr);
+                ok &= capture("input-depth", dreams_material_fragment_image_bindings[5].image_id);
+                if (surface_root) {
+                    ok &= capture("input-secondary-ids", dreams_material_fragment_image_bindings[2].image_id,
+                        &secondary_ids);
+                    ok &= capture("input-secondary-depth", dreams_material_fragment_image_bindings[1].image_id);
+                    // The images belong to this executed material draw. Visibility IDs count
+                    // only rasterized records, not every generated or occluded fleck.
+                    metadata += "surface_layers\tprimary=images4,5;secondary=images2,1\n"
+                        "record_scope\tonly IDs present in the two input images\n"
+                        "trigger_consumed\ttrue;no further surface polls this process\n";
+                    const Shader::Info* material{};
+                    u32 material_buffer_base{};
+                    for (const auto* stage : pipeline->GetStages()) {
+                        if (!stage) continue;
+                        if (stage->sw_stage == Shader::SwStage::Fragment) {
+                            material = stage;
+                            break;
+                        }
+                        material_buffer_base += stage->buffers.size();
+                    }
+                    const bool bindings_valid = material && material->pgm_hash == 0xdcc325c2 &&
+                        material->buffers.size() >= 2 &&
+                        material_buffer_base + material->buffers.size() <= buffer_infos.size();
+                    ok &= bindings_valid;
+                    if (bindings_valid) {
+                        ok &= WriteDreamsCaptureWords(output / "fs-srt.bin", material->flattened_ud_buf, hash);
+                        ok &= WriteDreamsCaptureWords(output / "fs-user-data.bin", material->user_data, hash);
+                        ok &= WriteDreamsCaptureBytes(output / "push-data.bin",
+                            std::span<const u8>{reinterpret_cast<const u8*>(&push_data), sizeof(push_data)}, hash);
+                        ok &= WriteDreamsCaptureBytes(output / "gpu-regs.bin",
+                            std::span<const u8>{reinterpret_cast<const u8*>(&regs), sizeof(regs)}, hash);
+                        std::vector<u32> objects, records;
+                        const auto collect = [&](std::span<const u8> bytes) {
+                            for (size_t at = 0; at + 8 <= bytes.size(); at += 8) {
+                                std::array<u32, 2> id{};
+                                std::memcpy(id.data(), bytes.data() + at, sizeof(id));
+                                const u32 tag = id[1] >> 30;
+                                if (tag == 1 || tag == 2) objects.push_back(id[0] >> 16);
+                                // Original dcc325c2 extracts bits 8..30, then indexes a
+                                // 32-dword record. Tag 2's bit 30 is zero.
+                                if (tag == 2) records.push_back((id[1] >> 8) & 0x7fffff);
+                            }
+                        };
+                        collect(primary_ids);
+                        collect(secondary_ids);
+                        metadata += fmt::format("contains_surface_ids\t{}\n", !objects.empty());
+                        ok &= !objects.empty();
+                        const auto save_records = [&](u32 binding, u32 stride,
+                                                      std::vector<u32>& keys, const char* label) {
+                            std::ranges::sort(keys);
+                            keys.erase(std::unique(keys.begin(), keys.end()), keys.end());
+                            metadata += fmt::format("{}_visible_keys\t{}\n", label, keys.size());
+                            // Bound memory and command count even if the capture is armed
+                            // in a larger scene. A rejected capture is reported incomplete.
+                            if (keys.size() > 65536 || u64{keys.size()} * stride > 8_MB ||
+                                material->buffers[binding].IsSpecial()) return false;
+                            const auto sharp = material->buffers[binding].GetSharp(*material);
+                            if (sharp.stride != stride) return false;
+                            const u64 logical_size = ResolveGuestBufferBindingSize(
+                                memory, *material, binding, material->buffers[binding], sharp);
