diff --git a/src/video_core/renderer_vulkan/alias252_proof.h b/src/video_core/renderer_vulkan/alias252_proof.h
new file mode 100644
index 0000000000000000000000000000000000000000..c2fc40023fc350f22fa92a02b5725400bb23a994
--- /dev/null
+++ b/src/video_core/renderer_vulkan/alias252_proof.h
@@ -0,0 +1,79 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <span>
+
+namespace Alias252 {
+using U64 = uint64_t;
+struct Range { U64 base{}, bytes{}, bound{}; uint32_t stride{}; };
+struct Input {
+    std::array<Range, 4> buffers;
+    uint32_t groups{}, roots{}, divisor{}, counter{};
+    std::span<const uint8_t> source_records;
+};
+struct Result {
+    bool safe{};
+    const char* reason{"unproved"};
+    U64 output_begin{}, output_end{}, maximum_records{}, lookup_hash{};
+    uint32_t valid_roots{};
+};
+inline bool Disjoint(U64 a, U64 n, U64 b, U64 m) {
+    return a < b ? n <= b-a : m <= a-b;
+}
+inline Result Check(const Input& in) {
+    Result result;
+    const auto reject=[&](const char* why) {result.reason=why;return result;};
+    constexpr U64 Limit=U64{1}<<40;
+    if (!in.groups || in.groups>65536 || !in.roots ||
+        (in.divisor!=3 && in.divisor!=6)) return reject("unsupported scalar domain");
+    const auto& b=in.buffers;
+    if (b[0].stride!=8 || b[1].stride!=72 || b[2].stride!=168 || b[3].stride!=0)
+        return reject("descriptor layout");
+    for (const auto& r:b) if (!r.base || !r.bytes || r.base>=Limit || r.bytes>Limit-r.base)
+        return reject("guest address overflow");
+    const U64 n=U64{in.groups}*64;
+    const U64 q_limit=std::min<U64>(in.roots,(n+in.divisor-1)/in.divisor);
+    if (U64{in.roots}*72>b[1].bytes || q_limit*72>b[1].bound ||
+        q_limit*72>in.source_records.size()) return reject("missing source records");
+    std::array<uint32_t,24575> indices{};
+    if(q_limit>indices.size()) return reject("root proof capacity");
+    result.lookup_hash=14695981039346656037ull;
+    for(U64 i=0;i<q_limit*72;i++) {
+        result.lookup_hash^=in.source_records[i];result.lookup_hash*=1099511628211ull;
+    }
+    const auto covered=[&](unsigned slot,U64 offset,U64 bytes) {
+        return offset<=b[slot].bytes && bytes<=b[slot].bytes-offset &&
+               offset<=b[slot].bound && bytes<=b[slot].bound-offset;
+    };
+    for(U64 q=0;q<q_limit;q++) {
+        uint32_t j;std::memcpy(&j,in.source_records.data()+q*72+64,4);indices[q]=j;
+        if(j==0xffffffffu)continue;
+        if(U64{j}*168+24>(U64{1}<<32) || !covered(2,U64{j}*168,24))
+            return reject("lookup record bounds");
+        ++result.valid_roots;
+        result.maximum_records+=std::min<U64>(in.divisor,n-q*in.divisor);
+    }
+    if(U64{in.counter}+result.maximum_records>0xffffffffu)
+        return reject("counter overflow");
+    const U64 output_start=U64{in.counter}*8;
+    const U64 output_bytes=result.maximum_records*8;
+    if(!covered(0,output_start,output_bytes))return reject("output capacity");
+    result.output_begin=b[0].base+output_start;result.output_end=result.output_begin+output_bytes;
+    const auto disjoint=[&](unsigned slot,U64 offset,U64 bytes) {
+        return covered(slot,offset,bytes) && (!output_bytes ||
+            Disjoint(b[slot].base+offset,bytes,result.output_begin,output_bytes));
+    };
+    for(U64 q=0;q<q_limit;q++) {
+        if(!disjoint(1,q*72+64,4))return reject("source-index/output overlap");
+        if(indices[q]==0xffffffffu)continue;
+        if(!disjoint(1,q*72,32))return reject("source-transform/output overlap");
+        if(!disjoint(2,U64{indices[q]}*168,24))return reject("lookup/output overlap");
+        const U64 lanes=std::min<U64>(in.divisor,n-q*in.divisor);
+        if(!disjoint(3,0,lanes*16) || !disjoint(3,96,lanes*16))
+            return reject("vector-table/output overlap or bounds");
+    }
+    result.safe=true;result.reason="proved disjoint";return result;
+}
+} // namespace Alias252
diff --git a/src/video_core/renderer_vulkan/alias252_runtime.inl b/src/video_core/renderer_vulkan/alias252_runtime.inl
new file mode 100644
index 0000000000000000000000000000000000000000..0d061739634a8dc514153ff4fdd2a7228d199e4d
--- /dev/null
+++ b/src/video_core/renderer_vulkan/alias252_runtime.inl
@@ -0,0 +1,128 @@
+#include "common/dreams_title.h"
+#include "alias252_proof.h"
+#include <openssl/sha.h>
+
+namespace Alias252Runtime {
+struct Proof {
+    Scheduler* scheduler{};
+    Alias252::Result result;
+    u32 counter{}, roots{}, divisor{};
+    bool injected_overlap{};
+    std::vector<std::unique_ptr<VideoCore::Buffer>> storage;
+    ~Proof() {
+        // Capture fences can rotate ticks before Replay. These buffers are not
+        // ring allocations: keep ownership through the final submission.
+        if(scheduler && !storage.empty())
+            scheduler->DeferOperation([keep=std::move(storage)]{});
+    }
+    std::string Text() const {
+        return fmt::format("accepted\t{}\nreason\t{}\nR\t{}\nD\t{}\ncounter\t{}\n"
+            "max_records\t{}\nlookup_hash\t{}\noutput_begin\t{}\noutput_end\t{}\n"
+            "private_input_snapshots\t{}\ninjected_overlap\t{}\n",
+            result.safe,result.reason,roots,divisor,counter,result.maximum_records,
+            result.lookup_hash,result.output_begin,result.output_end,storage.size(),injected_overlap);
+    }
+};
+
+static std::unique_ptr<Proof> Prepare(const Shader::Info& cs,const auto& regs,
+    const Instance& instance,Scheduler& scheduler,VideoCore::BufferCache& cache,
+    auto& bindings,const auto& writes,const Shader::PushData& push,std::span<const u32> spirv) {
+    auto proof=std::make_unique<Proof>();proof->scheduler=&scheduler;
+    const auto reject=[&](const char* why){proof->result.reason=why;return std::move(proof);};
+    if(cs.pgm_hash!=0x252ccde6 || Common::ElfInfo::Instance().GameSerial()!= ::Common::DreamsTitleId{} ||
+       !Shader::DreamsCompat::UseAdditionalExactOrderedCountReplay(cs.pgm_hash))
+        return reject("252 proof disabled");
+    if(!instance.IsSubgroupSize64Supported() || regs.num_thread_x.full!=64 ||
+       regs.num_thread_y.full!=1 || regs.num_thread_z.full!=1 ||
+       !regs.dim_x || regs.dim_x>65536 || regs.dim_y!=1 || regs.dim_z!=1 ||
+       regs.start_x || regs.start_y || regs.start_z || regs.settings.tgid_enable!=1 ||
+       !Shader::DreamsCompat::HasOrderedWaveLaunch(regs.dispatch_initiator))
+        return reject("252 unaudited launch");
+    // Pin the audited little-endian SPIR-V by length and SHA-256 instead of shipping guest-derived words.
+    static constexpr std::array<unsigned char, SHA256_DIGEST_LENGTH> audit_digest{
+        0x9f, 0xb9, 0x3a, 0x7e, 0x55, 0xe0, 0x66, 0xe5, 0xca, 0x74, 0x37, 0xab, 0xff, 0xd5, 0x15, 0xab,
+        0x8d, 0xfd, 0xd7, 0xf3, 0x6b, 0x0b, 0x4a, 0xa9, 0xb9, 0x75, 0x84, 0x00, 0xdd, 0x04, 0x2b, 0x55};
+    std::array<unsigned char, SHA256_DIGEST_LENGTH> digest{};
+    if(spirv.size()!=4559 ||
+       !SHA256(reinterpret_cast<const unsigned char*>(spirv.data()),spirv.size_bytes(),digest.data()) ||
+       digest!=audit_digest)
+        return reject("252 unaudited translated binary");
+    if(cs.buffers.size()!=6 || bindings.size()!=6 || !cs.images.empty() ||
+       cs.flattened_ud_buf.size()!=46 || cs.buffers[4].buffer_type!=Shader::BufferType::GdsBuffer ||
+       cs.buffers[5].buffer_type!=Shader::BufferType::Flatbuf || push.buf_offsets[4]!=0)
+        return reject("252 resource layout");
+    Alias252::Input input{};input.groups=regs.dim_x;
+    input.roots=proof->roots=cs.flattened_ud_buf[28];
+    input.divisor=proof->divisor=cs.flattened_ud_buf[29];
+    if(!input.roots || (input.divisor!=3 && input.divisor!=6))
+        return reject("252 unsupported scalar domain");
+    for(u32 i=0;i<4;i++) {
+        const auto& b=cs.buffers[i];
+        if(b.IsSpecial() || b.is_written!=(i==0) || !bindings[i].buffer ||
+           bindings[i].range==VK_WHOLE_SIZE || push.buf_offsets[i]%4 ||
+           bindings[i].range<push.buf_offsets[i]) return reject("252 invalid bound range");
+        const auto sharp=b.GetSharp(cs);
+        input.buffers[i]={u64{sharp.base_address},sharp.GetSize(),
+                         bindings[i].range-push.buf_offsets[i],static_cast<u32>(sharp.stride)};
+    }
+    if(u64{input.roots}*72>input.buffers[1].bytes)
+        return reject("252 root bounds");
+    const u64 q_limit=std::min<u64>(input.roots,(u64{regs.dim_x}*64+input.divisor-1)/input.divisor);
+    const std::array<u32,4> slots{1,2,3,5};
+    const std::array<u64,4> sizes{q_limit*72+push.buf_offsets[1],
+        input.buffers[2].bytes+push.buf_offsets[2],
+        u64{input.divisor}*16+96+push.buf_offsets[3],bindings[5].range};
+    if(bindings[5].range>4096 || bindings[4].buffer!=cache.GetGdsBuffer()->Handle() ||
+       bindings[4].offset!=0 || bindings[4].range<4100) return reject("252 counter/flat binding");
+    for(u32 k=0;k<4;k++)if(!sizes[k] || sizes[k]>8_MB || sizes[k]%4 ||
+        sizes[k]>bindings[slots[k]].range) return reject("252 snapshot bounds");
+    // Verify descriptor writes still refer to these settled VkBufferInfo objects.
+    for(u32 slot:slots) if(!std::ranges::any_of(writes,[&](const auto& w){
+        return w.pBufferInfo==&bindings[slot] && w.descriptorCount==1;
+    })) return reject("252 unresolved descriptor write");
+    auto frozen=std::array<vk::DescriptorBufferInfo,6>{};
+    for(u32 i=0;i<6;i++)frozen[i]=bindings[i];
+    try {
+        scheduler.EndRendering();
+        std::array<vk::BufferMemoryBarrier2,4> pre{},post{};
+        for(u32 k=0;k<4;k++) {
+            const u32 slot=slots[k];
+            proof->storage.push_back(std::make_unique<VideoCore::Buffer>(instance,0,sizes[k],
+                VideoCore::MemoryType::DeviceLocal,"DreamsAlias252Proof"));
+            frozen[slot]={proof->storage.back()->Handle(),0,sizes[k]};
+            pre[k]={.srcStageMask=vk::PipelineStageFlagBits2::eAllCommands|vk::PipelineStageFlagBits2::eHost,
+                .srcAccessMask=vk::AccessFlagBits2::eMemoryWrite|vk::AccessFlagBits2::eHostWrite,
+                .dstStageMask=vk::PipelineStageFlagBits2::eTransfer,
+                .dstAccessMask=vk::AccessFlagBits2::eTransferRead,
+                .buffer=bindings[slot].buffer,.offset=bindings[slot].offset,.size=sizes[k]};
+            post[k]={.srcStageMask=vk::PipelineStageFlagBits2::eTransfer,
+                .srcAccessMask=vk::AccessFlagBits2::eTransferWrite,
+                .dstStageMask=vk::PipelineStageFlagBits2::eComputeShader|vk::PipelineStageFlagBits2::eTransfer,
+                .dstAccessMask=vk::AccessFlagBits2::eShaderStorageRead|vk::AccessFlagBits2::eTransferRead,
+                .buffer=frozen[slot].buffer,.offset=0,.size=sizes[k]};
+        }
+        auto cmd=scheduler.CommandBuffer();
+        cmd.pipelineBarrier2(vk::DependencyInfo{.bufferMemoryBarrierCount=4,.pBufferMemoryBarriers=pre.data()});
+        for(u32 k=0;k<4;k++) {
+            const u32 slot=slots[k];cmd.copyBuffer(bindings[slot].buffer,frozen[slot].buffer,
+                vk::BufferCopy{.srcOffset=bindings[slot].offset,.dstOffset=0,.size=sizes[k]});
+        }
+        cmd.pipelineBarrier2(vk::DependencyInfo{.bufferMemoryBarrierCount=4,.pBufferMemoryBarriers=post.data()});
+        std::vector<u8> records(q_limit*72),flat(cs.flattened_ud_buf.size()*4);
+        std::array<u8,4> counter{};
+        const std::array regions{
+            DreamsBoundBufferCaptureRegion{frozen[1],push.buf_offsets[1],records},
+            DreamsBoundBufferCaptureRegion{frozen[5],push.buf_offsets[5],flat},
+            DreamsBoundBufferCaptureRegion{bindings[4],1024*4,counter}};
+        if(!ReadDreamsBoundBufferRegionsForCapture(scheduler,cache,regions))
+            return reject("252 coherent readback failed");
+        if(std::memcmp(flat.data(),cs.flattened_ud_buf.data(),flat.size())!=0)
+            return reject("252 GPU/host scalar mismatch");
+        std::memcpy(&input.counter,counter.data(),4);proof->counter=input.counter;
+        input.source_records=records;
+        proof->result=Alias252::Check(input);
+        if(proof->result.safe) for(u32 slot:slots)bindings[slot]=frozen[slot];
+        return proof;
+    } catch(const std::exception&) {return reject("252 snapshot allocation/copy failed");}
+}
+} // namespace Alias252Runtime
diff --git a/src/video_core/renderer_vulkan/detail_result_capture.inl b/src/video_core/renderer_vulkan/detail_result_capture.inl
new file mode 100644
index 0000000000000000000000000000000000000000..5d23a7d3e60d0b0ddf68863830f99bb7f74de3af
--- /dev/null
+++ b/src/video_core/renderer_vulkan/detail_result_capture.inl
@@ -0,0 +1,133 @@
+#include "common/dreams_title.h"
+// Private, explicitly armed diagnostic. No shader or guest-data modifications.
+namespace DetailResultCapture {
+struct Window {
+    std::filesystem::path root;
+    std::chrono::steady_clock::time_point deadline;
+    u64 bytes{};
+    u32 epoch{};
+    u32 events{};
+    bool active{};
+};
+static Window window;
+static constexpr u64 MaxBytes = 96_MB;
+static constexpr u64 MaxPrefix = 2_MB;
+static constexpr u32 MaxEvents = 16;
+
+static bool Target(u64 hash) {
+    return hash == 0x61b54af5 || hash == 0x44c189d5 || hash == 0x5650b8f7 ||
+           hash == 0xd049fb84 || hash == 0x16f35a48 || hash == 0x62a348b1 ||
+           hash == 0x8b19605c;
+}
+
+static bool EnabledFor(const Shader::Info& cs) {
+    return Target(cs.pgm_hash) &&
+        DreamsEnvironment<"SHADPS4_DREAMS_DETAIL_RESULT_CAPTURE_DIR">() &&
+        Common::ElfInfo::Instance().GameSerial() == ::Common::DreamsTitleId{};
+}
+
+static bool SaveGds(const std::filesystem::path& path, Scheduler& scheduler,
+                    VideoCore::BufferCache& cache) {
+    const auto* gds = cache.GetGdsBuffer();
+    std::array<u8,45*sizeof(u32)> data{};
+    if (gds->SizeBytes() < 0xc00 + data.size()) return false;
+    // Use the existing GPU copy, memory barriers, fence wait, and mapped-range invalidation.
+    // A bare CPU read of mapped GDS would not establish visibility of the completed write.
+    if (!ReadDreamsBoundBufferForCapture(scheduler,cache,
+            vk::DescriptorBufferInfo{gds->Handle(),0xc00,data.size()},0,data)) return false;
+    u64 hash{};
+    return WriteDreamsCaptureBytes(path,data,hash);
+}
+
+static std::filesystem::path Begin(const Shader::Info& cs, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, std::span<const vk::DescriptorBufferInfo> bindings,
+    std::span<const u32> spirv, std::span<const u8> push,
+    std::array<u32,3> dimensions, VAddr indirect_address,
+    vk::DescriptorBufferInfo indirect_binding) {
+    if (!Target(cs.pgm_hash)) return {};
+    const char* directory = DreamsEnvironment<"SHADPS4_DREAMS_DETAIL_RESULT_CAPTURE_DIR">();
+    if (!directory || Common::ElfInfo::Instance().GameSerial() != ::Common::DreamsTitleId{}) return {};
+    const std::filesystem::path root{directory};
+    std::error_code error;
+    const auto now = std::chrono::steady_clock::now();
+    if (std::filesystem::remove(root/"capture.request",error)) {
+        if (window.epoch >= 4) return {};
+        window.root = root/fmt::format("epoch-{:02}",++window.epoch);
+        window.events = 0;
+        window.bytes = 0;
+        window.deadline = now + std::chrono::seconds{10};
+        window.active = true;
+    }
+    if (!window.active) return {};
+    if (now > window.deadline || window.events >= MaxEvents || window.bytes >= MaxBytes) {
+        window.active = false;
+        WriteDreamsCaptureText(window.root/"window-complete.txt","bounded capture ended\n");
+        return {};
+    }
+    const auto output = window.root/fmt::format("event-{:02}-{:08x}",++window.events,cs.pgm_hash);
+    std::filesystem::create_directories(output,error);
+    if (error) { window.active=false; return {}; }
+    u64 hash{};
+    bool dims_valid = indirect_address == 0;
+    if (indirect_address) {
+        // Capture the exact buffer/offset passed to dispatchIndirect, without resolving the
+        // guest address again and potentially replacing a cached buffer or uploading CPU data.
+        dims_valid = ReadDreamsBoundBufferForCapture(scheduler,cache,indirect_binding,
+            0,std::span<u8>{reinterpret_cast<u8*>(dimensions.data()),sizeof(dimensions)});
+    }
+    bool files_ok = !spirv.empty();
+    files_ok &= WriteDreamsCaptureWords(output/"shader.spv",spirv,hash);
+    files_ok &= WriteDreamsCaptureWords(output/"srt.bin",cs.flattened_ud_buf,hash);
+    files_ok &= WriteDreamsCaptureWords(output/"user-data.bin",cs.user_data,hash);
+    files_ok &= WriteDreamsCaptureBytes(output/"push.bin",push,hash);
+    const bool gds_pre_ok = SaveGds(output/"gds-pre.bin",scheduler,cache);
+    std::string metadata=fmt::format(
+        "shader\t{:#x}\nindirect\t{}\nargs_address\t{:#x}\ndimensions_valid\t{}\n"
+        "dimensions\t{}\t{}\t{}\nmax_buffer_prefix\t{}\nwindow_byte_budget\t{}\n"
+        "shader_changed\tfalse\ninputs_are_prefixes\ttrue\ncompletion_waits_added\ttrue\n"
+        "shader_srt_push_files_ok\t{}\ngds_pre_ok\t{}\n",
+        cs.pgm_hash,indirect_address!=0,indirect_address,dims_valid,
+        dimensions[0],dimensions[1],dimensions[2],MaxPrefix,MaxBytes,files_ok,gds_pre_ok);
+    for (u32 index=0;index<cs.buffers.size() && index<bindings.size();++index) {
+        const auto& desc=cs.buffers[index];
+        const auto& bound=bindings[index];
+        metadata+=fmt::format("binding\t{}\tkind\t{}\twritten\t{}\n",
+            index,static_cast<u32>(desc.buffer_type),desc.is_written);
+        if (desc.IsSpecial()) continue;
+        const auto sharp=desc.GetSharp(cs);
+        const u64 declared=sharp.GetSize();
+        metadata+=fmt::format("buffer\t{}\tguest\t{:#x}\tdeclared\t{}\tstride\t{}\trecords\t{}\n",
+            index,sharp.base_address,declared,sharp.stride,sharp.num_records);
+        if (!declared || !bound.buffer || bound.range==VK_WHOLE_SIZE || bound.range<declared) {
+            metadata+=fmt::format("buffer_skipped\t{}\tinvalid-or-unbounded-descriptor\n",index);
+            continue;
+        }
+        const u64 adjustment=bound.range-declared;
+        const u64 bytes=std::min(declared,MaxPrefix);
+        if (bytes>MaxBytes-window.bytes) {
+            metadata+=fmt::format("buffer_skipped\t{}\twindow-budget\n",index);
+            continue;
+        }
+        std::vector<u8> data(static_cast<size_t>(bytes));
+        bool ok=ReadDreamsBoundBufferForCapture(scheduler,cache,bound,adjustment,data);
+        if (ok) ok=WriteDreamsCaptureBytes(output/fmt::format("buffer-{:02}.bin",index),data,hash);
+        window.bytes+=bytes;
+        metadata+=fmt::format("buffer_read\t{}\tbytes\t{}\tcomplete\t{}\tok\t{}\n",
+            index,bytes,bytes==declared,ok);
+    }
+    WriteDreamsCaptureText(output/"metadata.tsv",metadata);
+    return output;
+}
+
+static void End(const std::filesystem::path& output, Scheduler& scheduler,
+                VideoCore::BufferCache& cache) {
+    if (output.empty()) return;
+    const bool ok=SaveGds(output/"gds-post.bin",scheduler,cache);
+    WriteDreamsCaptureText(output/"dispatch-complete.txt",
+        ok ? "GPU completion waited; post counter copy and file succeeded\n" : "post counter capture failed\n");
+    if (window.events>=MaxEvents || window.bytes>=MaxBytes) {
+        window.active=false;
+        WriteDreamsCaptureText(window.root/"window-complete.txt","bounded capture ended\n");
+    }
+}
+} // namespace DetailResultCapture
diff --git a/src/video_core/renderer_vulkan/dreams_cpu_timing.h b/src/video_core/renderer_vulkan/dreams_cpu_timing.h
new file mode 100644
index 0000000000000000000000000000000000000000..e06bc3e0fc6156a62668cb72b339d2627c47b855
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_cpu_timing.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <string_view>
+#include "common/logging/log.h"
+
+namespace DreamsCpuTiming {
+enum Category { Direct, Indirect, Draw, DrawIndirect, Bind, ComputePipeline, GraphicsPipeline,
+                FindBuffer, SyncBuffer, Wait, Finish, BindBuffers, BindTextures, RefreshResources,
+                DmaSync, Count };
+inline constexpr std::array<const char*, Count> Names{
+    "direct", "indirect", "draw", "draw_indirect", "bind", "compute_pipeline",
+    "graphics_pipeline", "find_buffer", "sync_buffer", "wait", "finish", "bind_buffers",
+    "bind_textures", "refresh_resources", "dma_sync"};
+using Clock = std::chrono::steady_clock;
+struct State {
+    std::array<double, Count> milliseconds{};
+    std::array<unsigned long long, Count> calls{};
+    Clock::time_point report = Clock::now();
+};
+inline thread_local State state;
+struct Scope;
+inline thread_local Scope* current{};
+struct Scope {
+    Category category;
+    bool active;
+    Scope* parent{};
+    Clock::time_point begin{};
+    double children{};
+    explicit Scope(Category category_) : category(category_), active([] {
+        static const bool enabled = [] {
+            const char* value = std::getenv("SHADPS4_DREAMS_CPU_TIMING");
+            return value && std::string_view(value) == "1";
+        }();
+        return enabled;
+    }()) {
+        if (!active) return;
+        parent = current;
+        current = this;
+        begin = Clock::now();
+    }
+    ~Scope() {
+        if (!active) return;
+        const auto now = Clock::now();
+        const double elapsed = std::chrono::duration<double, std::milli>(now - begin).count();
+        state.milliseconds[category] += elapsed - children;
+        ++state.calls[category];
+        current = parent;
+        if (parent) {
+            parent->children += elapsed;
+            return;
+        }
+        const double seconds = std::chrono::duration<double>(now - state.report).count();
+        if (seconds < 1.0) return;
+        for (unsigned i = 0; i < Count; ++i) {
+            if (state.calls[i]) LOG_WARNING(Render_Vulkan,
+                "Dreams CPU timing category={} calls={} self_ms={:.3f} interval_s={:.3f}",
+                Names[i], state.calls[i], state.milliseconds[i], seconds);
+        }
+        state = {};
+    }
+};
+} // namespace DreamsCpuTiming
