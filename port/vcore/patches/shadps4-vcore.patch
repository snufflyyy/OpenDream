@@ -0,0 +1,39 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstddef>
+#include <cstdlib>
+#include <optional>
+#include <string>
+
+namespace Vulkan {
+
+template <std::size_t Size>
+struct DreamsEnvironmentName {
+    char text[Size];
+
+    constexpr DreamsEnvironmentName(const char (&name)[Size]) {
+        for (std::size_t i = 0; i < Size; ++i) {
+            text[i] = name[i];
+        }
+    }
+};
+
+// Launch options do not change during rendering. Cache misses as well as values:
+// even an absent diagnostic variable otherwise scans the CRT environment every
+// draw/dispatch. Own the string so later environment allocation cannot invalidate
+// it. A cached trigger *path* still permits its file to be created/removed live.
+template <DreamsEnvironmentName Name>
+const char* DreamsEnvironment() {
+    static const std::optional<std::string> value = []() -> std::optional<std::string> {
+        if (const char* text = std::getenv(Name.text)) {
+            return std::string{text};
+        }
+        return std::nullopt;
+    }();
+    return value ? value->c_str() : nullptr;
+}
+
+} // namespace Vulkan
diff --git a/src/video_core/renderer_vulkan/dreams_linear_write_bounds.h b/src/video_core/renderer_vulkan/dreams_linear_write_bounds.h
new file mode 100644
index 0000000000000000000000000000000000000000..93f002e084d30df2c8c0622bd120710a94cb99f2
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_linear_write_bounds.h
@@ -0,0 +1,72 @@
+#pragma once
+#include <array>
+#include <algorithm>
+#include <optional>
+#include "common/types.h"
+namespace Vulkan::DreamsLinearWrites {
+struct Context {bool active{};bool code_match{};u32 groups_x{},groups_y{},groups_z{};u32 start_x{},start_y{},start_z{};u32 local_x{},local_y{},local_z{},user_regs{},tgid_enable{};u32 input_count{},output_offset{};};
+inline thread_local Context current;
+inline u64 Fingerprint(const u8* bytes,size_t size){u64 value=14695981039346656037ull;for(size_t i=0;i<size;++i){value^=bytes[i];value*=1099511628211ull;}return value;}
+// The complete c4947c72 guest binary and current IR were audited; all six stores
+// address a linear GlobalInvocationId.x record. Unknown layouts retain full marking.
+inline std::optional<u32> Bound(const Context& c,u64 hash,u32 binding,u32 sharp_idx,u32 stride,
+                                u64 declared_size,bool unusual_addressing,bool formatted){
+    if(!c.active||!c.code_match||(hash!=0xc4947c72&&hash!=0xd9a5eaaf&&hash!=0x82719fa8&&hash!=0x6a7e1109&&hash!=0xe69537e9&&hash!=0x4f493234)||!c.groups_x||c.groups_y!=1||c.groups_z!=1||
+       c.start_x||c.start_y||c.start_z||c.local_x!=64||c.local_y!=1||c.local_z!=1||
+       c.user_regs!=((hash==0xc4947c72||hash==0x4f493234)?7u:hash==0xd9a5eaaf?2u:hash==0x6a7e1109?3u:4u)||!(c.tgid_enable&1)||unusual_addressing||formatted||!declared_size||
+       declared_size%4||declared_size>0xffffffffull)return {};
+    if(hash==0x4f493234){
+        // All 23 stores use the current global-X float4 record, including clears.
+        // Indexed reads and conditional branches cannot expand these output addresses.
+        if((binding!=0&&binding!=1&&binding!=3&&binding!=10&&binding!=11)||
+           sharp_idx!=66+4*binding||stride!=16)return {};
+        const u64 bytes=u64(c.groups_x)*64*16;
+        if(bytes>0xffffffffull)return {};
+        return u32(std::min(bytes,declared_size));
+    }
+    if(hash==0x6a7e1109){
+        // All twelve stores cover three float4 outputs indexed by global X.
+        // The input-count branch can only remove writes from this prefix.
+        if(binding>2||sharp_idx!=88+4*binding||stride!=16)return {};
+        const u64 bytes=u64(c.groups_x)*64*16;
+        if(bytes>0xffffffffull)return {};
+        return u32(std::min(bytes,declared_size));
+    }
+    if(hash==0xe69537e9){
+        // i=global X, j=user_data[3]+i. Outputs use i, j, or user_data[2]+j.
+        // Include the untouched leading records; retain all prior dirty tails.
+        const u32 expected_stride=(binding==1||binding==2)?4:16;
+        if(binding>4||sharp_idx!=36+4*binding||stride!=expected_stride)return {};
+        const u64 lanes=u64(c.groups_x)*64;
+        const u64 end=u64(c.input_count)+c.output_offset+lanes;
+        if(end*16>0xffffffffull)return {}; // No wrapped guest sums or byte indices.
+        const u64 records=binding==0?end:(binding==1||binding==3)?lanes:
+                          u64(c.output_offset)+lanes;
+        return u32(std::min(records*stride,declared_size));
+    }
+    if(hash==0x82719fa8){
+        // Each group reduces its lanes to one record, independent of read indices.
+        const u32 expected_stride = binding == 0 ? 4 : 16;
+        if(binding>3||sharp_idx!=100+4*binding||stride!=expected_stride)return {};
+        const u64 bytes=u64(c.groups_x)*stride;
+        if(bytes>0xffffffffull)return {};
+        return u32(std::min(bytes,declared_size));
+    }
+    if(hash==0xd9a5eaaf){
+        // Four current-IR stores cover one 48-byte record per global X invocation.
+        if(binding!=0||sharp_idx!=53||stride!=48)return {};
+        const u64 bytes=u64(c.groups_x)*64*48;
+        if(bytes>0xffffffffull)return {};
+        return u32(std::min(bytes,declared_size));
+    }
+    struct Entry{u32 binding,sharp_idx,stride;};
+    constexpr std::array<Entry,6> entries{{{0,88,16},{1,92,16},{2,96,12},{3,100,16},{9,124,16},{16,152,16}}};
+    for(const auto& e:entries)if(e.binding==binding){
+        if(sharp_idx!=e.sharp_idx||stride!=e.stride)return {};
+        const u64 bytes=u64(c.groups_x)*64*stride;
+        if(bytes>0xffffffffull)return {}; // Keep guest 32-bit index arithmetic non-wrapping.
+        return u32(std::min(bytes,declared_size)); // Conservatively include vec3 record padding.
+    }
+    return {};
+}
+}
diff --git a/src/video_core/renderer_vulkan/dreams_primary_queue_probe.h b/src/video_core/renderer_vulkan/dreams_primary_queue_probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..e612a688244453bf3ec512359c922501cde431f9
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_primary_queue_probe.h
@@ -0,0 +1,50 @@
+// Private diagnostic only: compare 2bf queue ordering without changing shader arithmetic.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace Vulkan::DreamsPrimaryQueueProbe {
+
+constexpr bool CanOrder(std::uint32_t x, std::uint32_t y, std::uint32_t z,
+                        std::uint32_t tx, std::uint32_t ty, std::uint32_t tz,
+                        std::uint32_t sx, std::uint32_t sy, std::uint32_t sz,
+                        bool wave64, bool ordered_launch) {
+    return x != 0 && x <= 4096 && y == 1 && z == 1 && tx == 64 && ty == 1 && tz == 1 &&
+           sx == 0 && sy == 0 && sz == 0 && wave64 && ordered_launch;
+}
+
+struct QueueAudit {
+    std::uint32_t records{};
+    std::uint32_t duplicate_roots{};
+    std::uint32_t invalid_roots{};
+    std::uint32_t descending_roots{};
+};
+
+// Binding 1 contains (packed-node, original-root-index) pairs. Each accepted input root is
+// appended once; DOC changes its position, not the root ID. Never interpret pairs as sculpt count.
+inline QueueAudit Audit(std::span<const std::uint32_t> queue, std::uint32_t root_count) {
+    QueueAudit result{};
+    if (queue.size() % 2 != 0) {
+        result.invalid_roots = 1;
+        return result;
+    }
+    result.records = static_cast<std::uint32_t>(queue.size() / 2);
+    std::vector<std::uint32_t> roots;
+    roots.reserve(result.records);
+    for (std::size_t i = 1; i < queue.size(); i += 2) {
+        const auto root = queue[i];
+        result.invalid_roots += root >= root_count;
+        result.descending_roots += i > 1 && root < queue[i - 2];
+        roots.push_back(root);
+    }
+    std::ranges::sort(roots);
+    for (std::size_t i = 1; i < roots.size(); ++i) {
+        result.duplicate_roots += roots[i] == roots[i - 1];
+    }
+    return result;
+}
+
+} // namespace Vulkan::DreamsPrimaryQueueProbe
diff --git a/src/video_core/renderer_vulkan/dreams_readback_gpu_span.h b/src/video_core/renderer_vulkan/dreams_readback_gpu_span.h
new file mode 100644
index 0000000000000000000000000000000000000000..85c4acbc3390e6cf9ac959d3843b27ea65c75bab
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_readback_gpu_span.h
@@ -0,0 +1,201 @@
+// Private, bounded diagnostic. The caller retains its existing synchronous Finish.
+// Include after Vulkan types are available. No asynchronous download is instrumented.
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+
+namespace Vulkan::DreamsReadbackGpuSpan {
+using Word = std::uint64_t;
+using Clock = std::chrono::steady_clock;
+inline constexpr std::size_t Capacity = 64;
+
+inline Word Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count();
+}
+inline const std::filesystem::path& Root() {
+    static const auto path = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_READBACK_GPU_SPAN_DIR");
+        return value ? std::filesystem::path{value} : std::filesystem::path{};
+    }();
+    return path;
+}
+inline Word TimestampDelta(Word first, Word last, unsigned bits) {
+    if (!bits || bits > 64) return 0;
+    const Word mask = bits == 64 ? std::numeric_limits<Word>::max() : (Word{1} << bits) - 1;
+    return (last - first) & mask;
+}
+struct Request {
+    Word ns{}, address{}, bytes{}, is_write{}, execute_ns{};
+    Request(Word address, Word bytes, bool is_write)
+        : ns(Root().empty() ? 0 : Now()), address(address), bytes(bytes), is_write(is_write) {}
+    Request() = default;
+};
+inline thread_local Request current_request;
+struct RequestScope {
+    Request previous{current_request};
+    explicit RequestScope(const Request& value) {
+        current_request = value;
+        if (value.ns) current_request.execute_ns = Now();
+    }
+    ~RequestScope() { current_request = previous; }
+};
+struct Entry {
+    Request request{};
+    Word address{}, size{}, padded_bytes{}, copy_count{}, tick{}, known_before{}, known_after{};
+    Word start_ns{}, setup_ns{}, before_finish_ns{}, after_finish_ns{}, collected_ns{};
+    Word gpu_start{}, gpu_end{}, gpu_delta{};
+    int result{};
+    bool available{};
+};
+struct State {
+    vk::UniqueQueryPool pool;
+    vk::Device device;
+    Word owner{};
+    unsigned valid_bits{};
+    double period_ns{};
+    Word next_check{}, deadline{};
+    std::size_t count{};
+    bool active{}, finished{}, in_scope{};
+    std::array<Entry, Capacity> entries{};
+};
+inline thread_local State state;
+
+inline void Report(const char* reason) noexcept {
+    state.finished = true;
+    state.active = false;
+    // Every timestamp submitted by this recorder belongs to a download whose
+    // original Finish has already returned. There are no query commands in a later batch.
+    state.pool.reset();
+    try {
+        std::ofstream out(Root() / "gpu-copy-spans.tsv", std::ios::trunc);
+        out << "id\trequest_ns\texecute_ns\trequest_address\trequest_bytes\tis_write"
+               "\twindow_address\twindow_size\tpadded_bytes\tcopy_count\ttick"
+               "\tknown_before\tknown_after\tstart_ns\tsetup_ns\tbefore_finish_ns"
+               "\tafter_finish_ns\tcollected_ns\tgpu_start\tgpu_end\tgpu_delta\tresult\tavailable\n";
+        for (std::size_t i = 0; i < state.count; ++i) {
+            const auto& e = state.entries[i];
+            out << i + 1 << '\t' << e.request.ns << '\t' << e.request.execute_ns << '\t'
+                << e.request.address << '\t' << e.request.bytes << '\t' << e.request.is_write
+                << '\t' << e.address << '\t' << e.size << '\t' << e.padded_bytes << '\t'
+                << e.copy_count << '\t' << e.tick << '\t' << e.known_before << '\t'
+                << e.known_after << '\t' << e.start_ns << '\t' << e.setup_ns << '\t'
+                << e.before_finish_ns << '\t' << e.after_finish_ns << '\t' << e.collected_ns
+                << '\t' << e.gpu_start << '\t' << e.gpu_end << '\t' << e.gpu_delta
+                << '\t' << e.result << '\t' << e.available << '\n';
+        }
+        out.flush();
+        if (!out) return;
+        std::ofstream done(Root() / "complete.txt", std::ios::trunc);
+        done.precision(17);
+        done << "reason=" << reason << "\nscheduler=" << state.owner << "\nentries=" << state.count
+             << "\ntimestamp_valid_bits=" << state.valid_bits
+             << "\ntimestamp_period_ns=" << state.period_ns
+             << "\nadditional_submissions=0\nadditional_waits=0\n"
+             << "gpu_span_includes_barrier_dependencies_and_may_include_prior_work=true\n"
+             << "gpu_and_cpu_clocks_are_not_calibrated=true\n";
+    } catch (...) {
+        // Recording failure must not change guest execution.
+    }
+}
+
+template <typename Instance, typename Scheduler>
+class Scope {
+public:
+    Scope(const Instance& instance, Scheduler& scheduler, Word address, Word size,
+          Word padded_bytes, Word copy_count, bool allowed)
+        : scheduler(scheduler) {
+        try {
+            if (!allowed || Root().empty() || state.finished || state.in_scope) return;
+            const Word now = Now();
+            if (!state.active) {
+                if (now < state.next_check) return;
+                state.next_check = now + 500'000'000;
+                std::error_code error;
+                if (!std::filesystem::exists(Root() / "arm.request", error)) return;
+                state.device = instance.GetDevice();
+                const auto physical = instance.GetPhysicalDevice();
+                const auto families = physical.getQueueFamilyProperties();
+                const auto family = instance.GetGraphicsQueueFamilyIndex();
+                if (family >= families.size() || !families[family].timestampValidBits) {
+                    Report("timestamps-unsupported");
+                    return;
+                }
+                state.valid_bits = families[family].timestampValidBits;
+                state.period_ns = physical.getProperties().limits.timestampPeriod;
+                auto [result, pool] = state.device.createQueryPoolUnique(vk::QueryPoolCreateInfo{
+                    .queryType = vk::QueryType::eTimestamp, .queryCount = 2});
+                if (result != vk::Result::eSuccess) {
+                    Report("query-allocation-failed");
+                    return;
+                }
+                state.pool = std::move(pool);
+                state.owner = reinterpret_cast<Word>(&scheduler);
+                state.active = true;
+                state.deadline = now + 2'000'000'000;
+            }
+            if (state.owner != reinterpret_cast<Word>(&scheduler)) return;
+            if (now >= state.deadline || state.count == Capacity) {
+                Report("deadline");
+                return;
+            }
+            state.in_scope = true;
+            entry = &state.entries[state.count];
+            *entry = Entry{.request = current_request, .address = address, .size = size,
+                           .padded_bytes = padded_bytes, .copy_count = copy_count,
+                           .start_ns = now, .setup_ns = Now() - now};
+        } catch (...) {
+            // No GPU command has been recorded yet; pool cleanup is safe here.
+            Report("setup-failed");
+        }
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+    void Begin(vk::CommandBuffer commands) {
+        if (!entry) return;
+        entry->tick = scheduler.CurrentTick();
+        commands.resetQueryPool(*state.pool, 0, 2);
+        commands.writeTimestamp(vk::PipelineStageFlagBits::eTopOfPipe, *state.pool, 0);
+    }
+    void End(vk::CommandBuffer commands) {
+        if (entry) commands.writeTimestamp(vk::PipelineStageFlagBits::eBottomOfPipe, *state.pool, 1);
+    }
+    void BeforeFinish() {
+        if (!entry) return;
+        entry->known_before = scheduler.GetWorkSemaphore()->KnownGpuTick();
+        entry->before_finish_ns = Now();
+    }
+    // Call only after the ORIGINAL blocking Finish, never instead of it.
+    void AfterFinish() {
+        if (!entry) return;
+        entry->after_finish_ns = Now();
+        entry->known_after = scheduler.GetWorkSemaphore()->KnownGpuTick();
+        std::array<Word, 4> values{};
+        const auto result = state.device.getQueryPoolResults(*state.pool, 0, 2, sizeof(values),
+            values.data(), sizeof(Word) * 2,
+            vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWithAvailability);
+        entry->result = static_cast<int>(result);
+        entry->available = result == vk::Result::eSuccess && values[1] && values[3];
+        if (entry->available) {
+            entry->gpu_start = values[0];
+            entry->gpu_end = values[2];
+            entry->gpu_delta = TimestampDelta(values[0], values[2], state.valid_bits);
+        }
+        entry->collected_ns = Now();
+        ++state.count;
+        state.in_scope = false;
+        entry = nullptr;
+        if (state.count == Capacity || Now() >= state.deadline)
+            Report(state.count == Capacity ? "capacity" : "deadline");
+    }
+private:
+    Scheduler& scheduler;
+    Entry* entry{};
+};
+} // namespace Vulkan::DreamsReadbackGpuSpan
diff --git a/src/video_core/renderer_vulkan/dreams_stall_trace.h b/src/video_core/renderer_vulkan/dreams_stall_trace.h
new file mode 100644
index 0000000000000000000000000000000000000000..900adf40163ba5f9c62547a0f48ef0d75d5f963a
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_stall_trace.h
@@ -0,0 +1,62 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <string_view>
+#include "common/logging/log.h"
+#include "core/debug_state.h"
+
+namespace DreamsStallTrace {
+using Clock = std::chrono::steady_clock;
+inline bool Enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_STALL_TRACE");
+        return value && std::string_view(value) == "1";
+    }();
+    return enabled;
+}
+inline const auto epoch = Clock::now();
+inline double Milliseconds(Clock::duration duration) {
+    return std::chrono::duration<double, std::milli>(duration).count();
+}
+struct Scope {
+    const char* category;
+    u64 identifier;
+    bool enabled = Enabled();
+    Clock::time_point start{};
+    explicit Scope(const char* name, u64 id = 0) : category(name), identifier(id) {
+        if (enabled) start = Clock::now();
+    }
+    ~Scope() {
+        if (!enabled) return;
+        const auto end = Clock::now();
+        const double elapsed = Milliseconds(end-start);
+        if (elapsed >= 3.0) LOG_WARNING(Render_Vulkan,
+            "Dreams stall category={} id={:#x} elapsed_ms={:.3f} end_ms={:.3f} frame={}",
+            category,identifier,elapsed,Milliseconds(end-epoch),DebugState.GetFrameNum());
+    }
+};
+inline void Frame() {
+    if (!Enabled()) return;
+    static auto previous = Clock::now();
+    static auto report = previous;
+    static std::array<double, 120> samples{};
+    static unsigned count{};
+    const auto now = Clock::now();
+    const double elapsed = Milliseconds(now-previous);
+    previous = now;
+    if (elapsed >= 45.0) LOG_WARNING(Render_Vulkan,
+        "Dreams stall category=frame_gap elapsed_ms={:.3f} end_ms={:.3f} frame={}",
+        elapsed,Milliseconds(now-epoch),DebugState.GetFrameNum());
+    samples[count++] = elapsed;
+    if (Milliseconds(now-report)<1000.0 && count<samples.size()) return;
+    std::sort(samples.begin(),samples.begin()+count);
+    LOG_WARNING(Render_Vulkan,
+        "Dreams frame timing samples={} median_ms={:.3f} p95_ms={:.3f} max_ms={:.3f} end_ms={:.3f} frame={}",
+        count,samples[count/2],samples[(count-1)*95/100],samples[count-1],
+        Milliseconds(now-epoch),DebugState.GetFrameNum());
+    count=0;
+    report=now;
+}
+} // namespace DreamsStallTrace
diff --git a/src/video_core/renderer_vulkan/dreams_submission_span.h b/src/video_core/renderer_vulkan/dreams_submission_span.h
new file mode 100644
index 0000000000000000000000000000000000000000..24ee114eb772bd0c29d5d4ff2d2d8644d7722901
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_submission_span.h
@@ -0,0 +1,201 @@
+// Bounded private diagnostic. Does not change submission order or add render-time waits.
+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <limits>
+
+namespace Vulkan::DreamsSubmissionSpan {
+using Word = std::uint64_t;
+inline constexpr std::size_t Capacity = 512;
+inline Word Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline const std::filesystem::path& Root() {
+    static const auto path = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_SUBMISSION_SPAN_DIR");
+        return value ? std::filesystem::path{value} : std::filesystem::path{};
+    }();
+    return path;
+}
+struct Entry {
+    Word tick{}, begin_ns{}, submit_enter_ns{}, queue_enter_ns{}, queue_return_ns{}, submit_return_ns{};
+    Word known_before{}, known_after{}, wait_count{}, signal_count{};
+    std::array<Word, 2> wait_handles{}, wait_values{};
+    Word gpu_begin{}, gpu_end{};
+    int result{};
+    bool available{};
+};
+struct State {
+    vk::Device device;
+    vk::UniqueQueryPool pool;
+    std::array<Entry, Capacity> entries{};
+    Word owner{}, deadline{}, last_submitted{};
+    std::size_t count{};
+    unsigned valid_bits{};
+    double period_ns{};
+    bool stopped{}, reported{};
+};
+class Recorder {
+public:
+    using Token = Entry*;
+    template <typename Instance>
+    void Begin(const Instance& instance, Word owner, vk::CommandBuffer command,
+               Word tick, bool allowed) {
+        if (!allowed || Root().empty() || (state && state->stopped)) return;
+        try {
+            const Word now = Now();
+            if (!state) {
+                if (now < next_check) return;
+                next_check = now + 100'000'000;
+                std::error_code error;
+                if (!std::filesystem::exists(Root() / "arm.request", error)) return;
+                state = std::make_unique<State>();
+                state->owner = owner;
+                state->device = instance.GetDevice();
+                const auto physical = instance.GetPhysicalDevice();
+                const auto families = physical.getQueueFamilyProperties();
+                const auto family = instance.GetGraphicsQueueFamilyIndex();
+                if (family >= families.size() || !families[family].timestampValidBits) {
+                    state->stopped = true;
+                    Report("timestamps-unsupported");
+                    return;
+                }
+                state->valid_bits = families[family].timestampValidBits;
+                state->period_ns = physical.getProperties().limits.timestampPeriod;
+                auto [result, pool] = state->device.createQueryPoolUnique(vk::QueryPoolCreateInfo{
+                    .queryType = vk::QueryType::eTimestamp, .queryCount = Capacity * 2});
+                if (result != vk::Result::eSuccess) {
+                    state->stopped = true;
+                    Report("allocation-failed");
+                    return;
+                }
+                state->pool = std::move(pool);
+                state->deadline = now + 1'000'000'000;
+            }
+            if (now >= state->deadline || state->count == Capacity) {
+                state->stopped = true;
+                return;
+            }
+            current = &state->entries[state->count];
+            *current = Entry{.tick = tick, .begin_ns = now};
+            command.resetQueryPool(*state->pool, state->count * 2, 2);
+            command.writeTimestamp(vk::PipelineStageFlagBits::eTopOfPipe,
+                                   *state->pool, state->count * 2);
+        } catch (...) {
+            // Allocation / filesystem failure happens before recording query commands.
+            if (state && !state->count) {
+                current = nullptr;
+                state->stopped = true;
+                Report("setup-failed");
+            }
+        }
+    }
+    Token EnterSubmit() {
+        if (current) current->submit_enter_ns = Now();
+        return current;
+    }
+    // Called after the existing EndRendering, before ending this command buffer.
+    void End(vk::CommandBuffer command, Token token) {
+        if (!token) return;
+        command.writeTimestamp(vk::PipelineStageFlagBits::eBottomOfPipe,
+                               *state->pool, state->count * 2 + 1);
+        ++state->count;
+        current = nullptr;
+        if (state->count == Capacity || Now() >= state->deadline) state->stopped = true;
+    }
+    void EnterQueue(Token token, Word known, unsigned waits, unsigned signals,
+                    const vk::Semaphore* handles, const Word* values) {
+        if (!token) return;
+        token->known_before = known;
+        token->wait_count = waits;
+        token->signal_count = signals;
+        for (unsigned i = 0; i < waits && i < token->wait_handles.size(); ++i) {
+            token->wait_handles[i] = reinterpret_cast<Word>(static_cast<VkSemaphore>(handles[i]));
+            token->wait_values[i] = values[i];
+        }
+        token->queue_enter_ns = Now();
+    }
+    void ReturnQueue(Token token, int result) {
+        if (!token) return;
+        token->queue_return_ns = Now();
+        token->result = result;
+        if (result == int(vk::Result::eSuccess)) state->last_submitted = token->tick;
+    }
+    void ReturnSubmit(Token token, Word known) {
+        if (token) {
+            token->submit_return_ns = Now();
+            token->known_after = known;
+        }
+        Collect(known);
+    }
+    // Only consumes already completed queries. No QUERY_RESULT_WAIT or extra semaphore refresh.
+    void Collect(Word known) {
+        if (!state || !state->stopped || state->reported || known < state->last_submitted) return;
+        if (state->pool && state->count) {
+            std::array<Word, Capacity * 4> values{};
+            const auto result = state->device.getQueryPoolResults(*state->pool, 0,
+                state->count * 2, state->count * 4 * sizeof(Word), values.data(), sizeof(Word) * 2,
+                vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWithAvailability);
+            for (std::size_t i = 0; i < state->count; ++i) {
+                auto& e = state->entries[i];
+                e.available = result == vk::Result::eSuccess && values[i * 4 + 1] && values[i * 4 + 3];
+                if (e.available) { e.gpu_begin = values[i * 4]; e.gpu_end = values[i * 4 + 2]; }
+            }
+        }
+        Report("complete");
+    }
+    // Scheduler destruction only: do not free queries while submitted commands still reference them.
+    template <typename Master>
+    void Shutdown(Master& master) {
+        if (!state || !state->pool) return;
+        if (state->last_submitted && !master.IsFree(state->last_submitted)) master.Wait(state->last_submitted);
+        state->stopped = true;
+        // A begun, unsubmitted batch is intentionally excluded from the query count.
+        current = nullptr;
+        Collect(master.KnownGpuTick());
+    }
+#ifdef DREAMS_SUBMISSION_SPAN_TESTING
+    const State* Inspect() const { return state.get(); }
+    void ExpireForTest() { if (state) state->deadline = 0; }
+#endif
+private:
+    void Report(const char* reason) noexcept {
+        state->reported = true;
+        state->pool.reset();
+        try {
+            const auto name = std::to_string(state->owner);
+            std::ofstream out(Root() / ("submissions-" + name + ".tsv"));
+            out << "tick\tbegin_ns\tsubmit_enter_ns\tqueue_enter_ns\tqueue_return_ns\tsubmit_return_ns"
+                   "\tknown_before\tknown_after\twaits\tsignals\twait0\tvalue0\twait1\tvalue1"
+                   "\tgpu_begin\tgpu_end\tresult\tavailable\n";
+            for (std::size_t i = 0; i < state->count; ++i) {
+                const auto& e = state->entries[i];
+                out << e.tick << '\t' << e.begin_ns << '\t' << e.submit_enter_ns << '\t'
+                    << e.queue_enter_ns << '\t' << e.queue_return_ns << '\t' << e.submit_return_ns
+                    << '\t' << e.known_before << '\t' << e.known_after << '\t' << e.wait_count
+                    << '\t' << e.signal_count << '\t' << e.wait_handles[0] << '\t' << e.wait_values[0]
+                    << '\t' << e.wait_handles[1] << '\t' << e.wait_values[1] << '\t' << e.gpu_begin
+                    << '\t' << e.gpu_end << '\t' << e.result << '\t' << e.available << '\n';
+            }
+            out.flush();
+            if (!out) return;
+            std::ofstream done(Root() / ("complete-" + name + ".txt"));
+            done.precision(17);
+            done << "reason=" << reason << "\nentries=" << state->count
+                 << "\ntimestamp_valid_bits=" << state->valid_bits
+                 << "\ntimestamp_period_ns=" << state->period_ns
+                 << "\nadditional_render_submissions=0\nadditional_render_waits=0\n"
+                 << "clocks_calibrated=false\nspans_include_dependency_waits=true\n";
+        } catch (...) {}
+    }
+    std::unique_ptr<State> state;
+    Token current{};
+    Word next_check{};
+};
+} // namespace Vulkan::DreamsSubmissionSpan
diff --git a/src/video_core/renderer_vulkan/dreams_wait_probe.h b/src/video_core/renderer_vulkan/dreams_wait_probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..3fb75481ba328f13de5d7e3c0ce6065090245443
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_wait_probe.h
@@ -0,0 +1,137 @@
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <source_location>
+#include <thread>
+
+namespace Vulkan::DreamsWaitProbe {
+using Clock = std::chrono::steady_clock;
+struct Entry {
+    const char* file{};
+    unsigned line{};
+    const char* kind{};
+    unsigned long long calls{}, nanoseconds{};
+};
+struct Writer { unsigned long long shader{}, base{}, size{}; };
+struct Readback { unsigned long long page{}, shader{}, calls{}, bytes{}; };
+struct State {
+    std::array<Entry, 256> entries{};
+    std::array<Writer, 512> writers{};
+    std::array<Readback, 512> readbacks{};
+    unsigned writer_cursor{};
+    unsigned long long request_address{}, dropped_readbacks{};
+    Clock::time_point next_check{}, deadline{}, next_report{};
+    bool active{}, finished{};
+};
+inline thread_local State state;
+inline std::mutex output_mutex;
+inline const std::filesystem::path& Root() {
+    static const auto path = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_WAIT_PROBE_DIR");
+        return value ? std::filesystem::path(value) : std::filesystem::path{};
+    }();
+    return path;
+}
+inline void Report() {
+    std::scoped_lock lock(output_mutex);
+    std::ofstream out(Root() / "waits.tsv", std::ios::app);
+    std::ofstream addresses(Root() / "readback-addresses.tsv", std::ios::app);
+    for (const auto& readback : state.readbacks) {
+        if (readback.calls) addresses << readback.page << '\t' << readback.shader << '\t'
+            << readback.calls << '\t' << readback.bytes << '\n';
+    }
+    addresses << "dropped\t0\t" << state.dropped_readbacks << "\t0\n";
+    state.readbacks = {};
+    state.dropped_readbacks = 0;
+    for (const auto& entry : state.entries) {
+        if (entry.calls) {
+            out << std::this_thread::get_id() << '\t' << entry.kind << '\t'
+                << entry.file << '\t' << entry.line << '\t' << entry.calls << '\t'
+                << entry.nanoseconds << '\n';
+        }
+    }
+    state.entries = {};
+}
+inline void ObserveWriter(unsigned long long shader, unsigned long long base,
+                          unsigned long long size) {
+    if (!state.active || state.finished) return;
+    state.writers[state.writer_cursor++ % state.writers.size()] = {shader, base, size};
+}
+inline void ObserveDownload(unsigned long long bytes) {
+    if (!state.active || state.finished) return;
+    const auto address = state.request_address;
+    unsigned long long shader{};
+    for (unsigned i = 0; i < state.writers.size(); ++i) {
+        const auto& writer = state.writers[(state.writer_cursor - 1 - i) % state.writers.size()];
+        if (address >= writer.base && address - writer.base < writer.size) {
+            shader = writer.shader;
+            break;
+        }
+    }
+    const auto page = address & ~4095ULL;
+    for (auto& entry : state.readbacks) {
+        if (!entry.calls || (entry.page == page && entry.shader == shader)) {
+            entry.page = page;
+            entry.shader = shader;
+            ++entry.calls;
+            entry.bytes += bytes;
+            return;
+        }
+    }
+    ++state.dropped_readbacks;
+}
+class Scope {
+public:
+    Scope(const char* kind, std::source_location source) : kind(kind), source(source) {
+        if (Root().empty() || state.finished) return;
+        const auto now = Clock::now();
+        if (!state.active && now >= state.next_check) {
+            state.next_check = now + std::chrono::seconds(1);
+            std::error_code error;
+            if (std::filesystem::exists(Root() / "arm.request", error)) {
+                state.active = true;
+                state.deadline = now + std::chrono::seconds(30);
+                state.next_report = now + std::chrono::seconds(5);
+            }
+        }
+        if (!state.active) return;
+        if (now >= state.deadline) {
+            Report();
+            state.finished = true;
+            state.active = false;
+            return;
+        }
+        enabled = true;
+        start = now;
+    }
+    ~Scope() {
+        if (!enabled) return;
+        const auto now = Clock::now();
+        for (auto& entry : state.entries) {
+            if (!entry.file || (entry.file == source.file_name() &&
+                                entry.line == source.line() && entry.kind == kind)) {
+                entry.file = source.file_name();
+                entry.line = source.line();
+                entry.kind = kind;
+                ++entry.calls;
+                entry.nanoseconds += std::chrono::duration_cast<std::chrono::nanoseconds>(now-start).count();
+                break;
+            }
+        }
+        if (now >= state.next_report) {
+            Report();
+            state.next_report = now + std::chrono::seconds(5);
+        }
+    }
+private:
+    const char* kind;
+    std::source_location source;
+    Clock::time_point start{};
+    bool enabled{};
+};
+}
diff --git a/src/video_core/renderer_vulkan/fleck_hierarchy_capture.inl b/src/video_core/renderer_vulkan/fleck_hierarchy_capture.inl
new file mode 100644
index 0000000000000000000000000000000000000000..5e55a7cda9b5d39c7dfb8e3a6a53a05eb2f780b6
--- /dev/null
+++ b/src/video_core/renderer_vulkan/fleck_hierarchy_capture.inl
@@ -0,0 +1,107 @@
+// Observe the reachable hierarchy, including children rejected by the selector.
+// Uses only already-bound GPU buffers; no guest data or selection is changed.
+constexpr u32 MaxHierarchyBricks = 32768;
+
+static std::vector<u32> Hierarchy(Session& session, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, vk::DescriptorBufferInfo children,
+    vk::DescriptorBufferInfo metadata, vk::DescriptorBufferInfo positions,
+    std::span<const u32> roots) {
+    if (roots.empty() || roots.size() > 16 || children.range == VK_WHOLE_SIZE ||
+        metadata.range == VK_WHOLE_SIZE || positions.range == VK_WHOLE_SIZE) {
+        session.ok = false;
+        session.metadata += "hierarchy_failed\tinvalid-roots-or-binding\n";
+        return {};
+    }
+    const u64 capacity = std::min({children.range / 24, metadata.range / 16,
+                                  positions.range / 4, u64{1048576}});
+    std::vector<u8> seen(static_cast<size_t>(capacity));
+    std::vector<u8> levels(static_cast<size_t>(capacity), 16);
+    std::vector<std::pair<u32,u32>> links_to_check;
+    std::vector<u32> all, pending = Unique({roots.begin(), roots.end()});
+    std::vector<u32> parent_level(pending.size(), 16);
+    std::string edges = "parent\tslot\tchild\tparent_level\n";
+    for (u32 depth = 0; !pending.empty() && depth < 16; ++depth) {
+        std::vector<u32> next, next_parent;
+        for (size_t first = 0; first < pending.size(); first += MaxBricks) {
+            const size_t count = std::min<size_t>(MaxBricks, pending.size() - first);
+            const std::span<const u32> batch{pending.data() + first, count};
+            for (u32 id : batch) {
+                if (id >= capacity || all.size() >= MaxHierarchyBricks) {
+                    session.ok = false;
+                    session.metadata += "hierarchy_failed\tinvalid-index-or-node-budget\n";
+                    return {};
+                }
+                all.push_back(id);
+                seen[id] = 1;
+            }
+            const auto prefix = fmt::format("hierarchy-{:02}-{:03}", depth, first / MaxBricks);
+            const auto pos = Records(session, prefix + "-positions", scheduler, cache,
+                                     positions, 0, batch, 4);
+            const auto meta = Records(session, prefix + "-metadata", scheduler, cache,
+                                      metadata, 0, batch, 16);
+            const auto links = Records(session, prefix + "-children", scheduler, cache,
+                                       children, 0, batch, 24);
+            if (pos.size() != count * 4 || meta.size() != count * 16 || links.size() != count * 24)
+                return {};
+            for (size_t n = 0; n < count; ++n) {
+                const u32 level = (Word(pos, n) >> 27) & 15;
+                levels[batch[n]] = static_cast<u8>(level);
+                if (level >= parent_level[first + n]) {
+                    session.ok = false;
+                    session.metadata += "hierarchy_failed\tnon-decreasing-child-level\n";
+                    return {};
+                }
+                if (!level) continue;
+                for (u32 slot = 0; slot < 8; ++slot) {
+                    const size_t at = n * 24 + slot * 3;
+                    const u32 child = u32{links[at]} | (u32{links[at + 1]} << 8) |
+                                      (u32{links[at + 2]} << 16);
+                    if (child & 0x800000) continue; // Same empty-child test as the guest shader.
+                    edges += fmt::format("{}\t{}\t{}\t{}\n", batch[n], slot, child, level);
+                    if (child >= capacity) {
+                        session.ok = false;
+                        session.metadata += "hierarchy_failed\tchild-out-of-range\n";
+                        return {};
+                    }
+                    links_to_check.emplace_back(batch[n], child);
+                    if (!seen[child]) {
+                        if (all.size() + next.size() >= MaxHierarchyBricks) {
+                            session.ok = false;
+                            session.metadata += "hierarchy_failed\tnode-budget\n";
+                            return {};
+                        }
+                        seen[child] = 1;
+                        next.push_back(child);
+                        next_parent.push_back(level);
+                    }
+                }
+            }
+        }
+        pending = std::move(next);
+        parent_level = std::move(next_parent);
+    }
+    if (!pending.empty()) {
+        session.ok = false;
+        session.metadata += "hierarchy_failed\tdepth-budget\n";
+        return {};
+    }
+    for (const auto& [parent, child] : links_to_check) {
+        if (levels[child] >= levels[parent]) {
+            session.ok = false;
+            session.metadata += "hierarchy_failed\tnon-decreasing-shared-child-level\n";
+            return {};
+        }
+    }
+    session.ok &= WriteDreamsCaptureText(session.output / "hierarchy-edges.tsv", edges);
+    session.metadata += fmt::format("hierarchy_complete\t{}\tnodes\t{}\n", session.ok, all.size());
+    return session.ok ? Unique(std::move(all)) : std::vector<u32>{};
+}
+
+static void HierarchyCells(Session& session, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, vk::DescriptorBufferInfo cells, std::span<const u32> ids) {
+    for (size_t first = 0; first < ids.size(); first += MaxBricks) {
+        const auto batch = ids.subspan(first, std::min<size_t>(MaxBricks, ids.size() - first));
+        if (Records(session, fmt::format("hierarchy-cell-nibbles-{:03}", first / MaxBricks),
+            scheduler, cache, cells, 0, batch, 172).size() != batch.size() * 172) return;
+    }
+}
diff --git a/src/video_core/renderer_vulkan/fleck_producer_capture.inl b/src/video_core/renderer_vulkan/fleck_producer_capture.inl
new file mode 100644
index 0000000000000000000000000000000000000000..7a024cfa56a3a2969f2f520112b2fa5ae5e88c29
--- /dev/null
+++ b/src/video_core/renderer_vulkan/fleck_producer_capture.inl
@@ -0,0 +1,397 @@
+// Private, bounded, read-only capture of the surface-sample -> fleck-geometry handoff.
+namespace FleckProducerCapture {
+constexpr u64 Selector = 0x34267ace, Geometry = 0x3b03fcbe, BrickSelector = 0x4bc902cf;
+constexpr u64 MaxBytes = 96_MB;
+constexpr u32 MaxBricks = 4096, MaxSamples = 65536;
+struct Window {
+    std::filesystem::path root;
+    std::chrono::steady_clock::time_point deadline;
+    u32 epoch{};
+    u32 brick_pass{};
+    u64 bytes{};
+    bool active{};
+    bool hierarchy_requested{};
+    std::vector<u32> hierarchy_ids;
+};
+static Window window;
+struct Session {
+    std::filesystem::path output;
+    u64 shader{};
+    vk::DescriptorBufferInfo output_binding{};
+    u64 output_size{};
+    vk::DescriptorBufferInfo queue_binding{}, args_binding{};
+    std::string metadata;
+    bool ok{true};
+};
+
+static bool EnabledFor(const Shader::Info& cs) {
+    return (cs.pgm_hash == Selector || cs.pgm_hash == Geometry || cs.pgm_hash == BrickSelector) &&
+        DreamsEnvironment<"SHADPS4_DREAMS_FLECK_PRODUCER_CAPTURE_DIR">() &&
+        Common::ElfInfo::Instance().GameSerial() == ::Common::DreamsTitleId{};
+}
+
+static u32 Word(std::span<const u8> bytes, size_t index) {
+    u32 value{};
+    if (index < bytes.size()/sizeof(u32)) std::memcpy(&value,bytes.data()+index*sizeof(u32),sizeof(value));
+    return value;
+}
+
+static bool Reserve(u64 size) {
+    if (size > MaxBytes-window.bytes) return false;
+    window.bytes += size;
+    return true;
+}
+
+static std::vector<u8> Read(Session& session, std::string_view name, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, vk::DescriptorBufferInfo binding, u64 offset, u64 size) {
+    if (!size) return {};
+    std::vector<u8> data;
+    bool ok = size <= 16_MB && binding.buffer && binding.range != VK_WHOLE_SIZE &&
+        offset <= binding.range && size <= binding.range-offset && Reserve(size);
+    if (ok) {
+        data.resize(size);
+        ok = ReadDreamsBoundBufferForCapture(scheduler,cache,binding,offset,data);
+        u64 hash{};
+        if (ok) ok = WriteDreamsCaptureBytes(session.output/(std::string(name)+".bin"),data,hash);
+    }
+    session.metadata += fmt::format("read\t{}\toffset\t{}\tbytes\t{}\tok\t{}\n",name,offset,size,ok);
+    session.ok &= ok;
+    if (!ok) data.clear();
+    return data;
+}
+
+static std::vector<u32> Unique(std::vector<u32> ids) {
+    std::ranges::sort(ids);
+    ids.erase(std::unique(ids.begin(),ids.end()),ids.end());
+    return ids;
+}
+
+static std::vector<u8> Records(Session& session, std::string_view name, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, vk::DescriptorBufferInfo binding, u64 adjustment,
+    std::span<const u32> ids, u32 stride) {
+    std::vector<u8> data;
+    const u64 bytes = u64{ids.size()}*stride;
+    bool valid = ids.size() <= MaxBricks && stride && bytes <= 16_MB &&
+        binding.buffer && binding.range != VK_WHOLE_SIZE && adjustment <= binding.range;
+    for (u32 id : ids) {
+        const u64 offset = u64{id}*stride;
+        valid &= offset <= binding.range-adjustment &&
+            stride <= binding.range-adjustment-std::min(offset,binding.range-adjustment);
+    }
+    if (!valid || !Reserve(bytes)) {
+        session.metadata += fmt::format("sparse_failed\t{}\tinvalid-or-budget\n",name);
+        session.ok=false; return {};
+    }
+    data.resize(bytes);
+    std::vector<DreamsBoundBufferCaptureRegion> regions;
+    std::string index="record\tguest_offset\tfile_offset\tbytes\n";
+    for (size_t i=0;i<ids.size();++i) {
+        regions.push_back({binding,adjustment+u64{ids[i]}*stride,
+            std::span<u8>{data}.subspan(i*stride,stride)});
+        index += fmt::format("{}\t{}\t{}\t{}\n",ids[i],u64{ids[i]}*stride,i*stride,stride);
+    }
+    bool ok=ReadDreamsBoundBufferRegionsForCapture(scheduler,cache,regions);
+    u64 hash{};
+    if (ok) ok=WriteDreamsCaptureBytes(session.output/(std::string(name)+".bin"),data,hash);
+    ok &= WriteDreamsCaptureText(session.output/(std::string(name)+".tsv"),index);
+    session.metadata+=fmt::format("sparse\t{}\tcount\t{}\tstride\t{}\tok\t{}\n",name,ids.size(),stride,ok);
+    session.ok &= ok;
+    if (!ok) data.clear();
+    return data;
+}
+
+#include "common/dreams_title.h"
+#include "video_core/renderer_vulkan/fleck_hierarchy_capture.inl"
+
+static void Images(Session& session, Scheduler& scheduler, VideoCore::BufferCache& cache,
+    auto& textures, const auto& bindings, std::span<const u32> bricks) {
+    for (size_t index=0; index<bindings.size(); ++index) {
+        const auto& [id,desc]=bindings[index];
+        if (!id) {session.ok=false;continue;}
+        auto& image=textures.GetImage(id);
+        const auto& info=image.info;
+        const auto& view=desc.view_info;
+        session.metadata+=fmt::format("image\t{}\tguest\t{:#x}\tformat\t{}\tdimensions\t{}\t{}\t{}\tlevels\t{}\tlayers\t{}\tview_base\t{}\tview_levels\t{}\n",
+            index,info.guest_address,vk::to_string(info.pixel_format),info.size.width,info.size.height,info.size.depth,
+            info.resources.levels,info.resources.layers,view.range.base.level,view.range.extent.levels);
+        // Large density atlases are sparse; small lookup textures and the depth pyramid
+        // are captured in full, including every mip. Preserve the descriptor separately.
+        const bool valid = !info.props.is_block && !info.props.is_depth &&
+            info.num_bits && info.num_bits%8==0 && info.num_samples==1 &&
+            info.resources.layers==1 && info.resources.levels>=1 && info.resources.levels<=16 &&
+            view.range.base.layer==0 && view.range.extent.layers==1;
+        if (!valid) {session.metadata+="image_skipped\tunsupported-view\n";session.ok=false;continue;}
+        std::vector<vk::BufferImageCopy> copies;
+        u64 bytes{};
+        u64 full_bytes{};
+        for (u32 level=0;level<info.resources.levels;++level) {
+            full_bytes=(full_bytes+3)&~u64{3};
+            full_bytes+=u64{std::max(1u,info.size.width>>level)}*
+                std::max(1u,info.size.height>>level)*std::max(1u,info.size.depth>>level)*(info.num_bits/8u);
+        }
+        std::string rows="brick\tlevel\tx\ty\tz\twidth\theight\tdepth\tfile_offset\tbytes\n";
+        if (full_bytes>16_MB && info.size.depth>1 && info.resources.levels==1 && view.range.base.level==0) {
+            if (bricks.size()>MaxBricks) {session.ok=false;continue;}
+            for (u32 brick:bricks) {
+                const u32 x=(brick&255u)*8u,y=((brick>>8)&255u)*8u,z=(brick>>16)*8u;
+                if (info.size.width<8 || info.size.height<8 || info.size.depth<8 ||
+                    x>info.size.width-8 || y>info.size.height-8 || z>info.size.depth-8) {
+                    session.metadata+=fmt::format("image_brick_skipped\t{}\t{}\tout-of-bounds\n",index,brick);
+                    session.ok=false;continue;
+                }
+                const u64 size=512u*(info.num_bits/8u);
+                copies.push_back(vk::BufferImageCopy{.bufferOffset=bytes,
+                    .imageSubresource={vk::ImageAspectFlagBits::eColor,0,0,1},
+                    .imageOffset={static_cast<s32>(x),static_cast<s32>(y),static_cast<s32>(z)},.imageExtent={8,8,8}});
+                rows+=fmt::format("{}\t0\t{}\t{}\t{}\t8\t8\t8\t{}\t{}\n",brick,x,y,z,bytes,size);
+                bytes+=size;
+            }
+        } else if(full_bytes<=16_MB) {
+            for (u32 level=0;level<info.resources.levels;++level) {
+                const u32 x=std::max(1u,info.size.width>>level),y=std::max(1u,info.size.height>>level),z=std::max(1u,info.size.depth>>level);
+                bytes=(bytes+3)&~u64{3};
+                const u64 size=u64{x}*y*z*(info.num_bits/8u);
+                copies.push_back(vk::BufferImageCopy{.bufferOffset=bytes,
+                    .imageSubresource={vk::ImageAspectFlagBits::eColor,level,0,1},.imageExtent={x,y,z}});
+                rows+=fmt::format("all\t{}\t0\t0\t0\t{}\t{}\t{}\t{}\t{}\n",level,x,y,z,bytes,size);
+                bytes+=size;
+            }
+        }
+        if (!bytes || bytes>16_MB || !Reserve(bytes)) {session.ok=false;continue;}
+        scheduler.EndRendering();
+        auto& download=DreamsDownloadBuffer();
+        const auto [data,offset]=download.Map(bytes,16);
+        if (!data) {session.ok=false;continue;}
+        download.Commit();
+        for(auto& copy:copies) copy.bufferOffset+=offset;
+        const auto saved=image.backing->state;
+        const auto saved_subresources=image.backing->subresource_states;
+        if (!saved_subresources.empty() && saved_subresources.size()!=info.resources.levels) {session.ok=false;continue;}
+        DreamsDownloadImage(image, copies, download, offset, bytes);
+        const auto restore=[&](const auto& state,auto range) {
+            const auto barriers=DreamsImageBarriers(image, state.layout,state.access_mask,state.pl_stage,range);
+            if (!barriers.empty()) scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+                .imageMemoryBarrierCount=static_cast<u32>(barriers.size()),.pImageMemoryBarriers=barriers.data()});
+        };
+        if (saved_subresources.empty()) restore(saved,std::optional<VideoCore::SubresourceRange>{});
+        else for(u32 level=0;level<saved_subresources.size();++level)
+            restore(saved_subresources[level],std::optional{VideoCore::SubresourceRange{
+                .base={.level=static_cast<u16>(level),.layer=0},.extent={.levels=1,.layers=1}}});
+        image.backing->state=saved;
+        image.backing->subresource_states=saved_subresources;
+        const vk::BufferMemoryBarrier2 host{
+            .srcStageMask=vk::PipelineStageFlagBits2::eTransfer,.srcAccessMask=vk::AccessFlagBits2::eTransferWrite,
+            .dstStageMask=vk::PipelineStageFlagBits2::eHost,.dstAccessMask=vk::AccessFlagBits2::eHostRead,
+            .buffer=download.Handle(),.offset=offset,.size=bytes};
+        scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{.bufferMemoryBarrierCount=1,.pBufferMemoryBarriers=&host});
+        scheduler.Finish();download.InvalidateMappedRange(offset,bytes);
+        u64 hash{};
+        const auto prefix=fmt::format("image-{:02}",index);
+        bool ok=WriteDreamsCaptureBytes(session.output/(prefix+".bin"),{data,static_cast<size_t>(bytes)},hash);
+        ok &= WriteDreamsCaptureText(session.output/(prefix+".tsv"),rows);
+        session.ok &= ok;
+        session.metadata+=fmt::format("image_read\t{}\tbytes\t{}\tregions\t{}\tok\t{}\n",index,bytes,copies.size(),ok);
+    }
+}
+
+static constexpr bool BrickQueueRange(u32 first,u32 count,u64 range) {
+    return count<=MaxBricks && range!=VK_WHOLE_SIZE &&
+        u64{first}*8<=range && u64{count}*8<=range-u64{first}*8;
+}
+
+static std::unique_ptr<Session> Begin(const Shader::Info& cs, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, auto& textures, const auto& images,
+    std::span<const vk::DescriptorBufferInfo> bindings, std::span<const u32> spirv,
+    std::span<const u8> push, std::array<u32,3> dims, VAddr indirect,
+    vk::DescriptorBufferInfo args) {
+    if (!EnabledFor(cs)) return {};
+    const std::filesystem::path root{DreamsEnvironment<"SHADPS4_DREAMS_FLECK_PRODUCER_CAPTURE_DIR">()};
+    const auto now=std::chrono::steady_clock::now();
+    std::error_code error;
+    if (window.active && now>window.deadline) {
+        window.active=false;WriteDreamsCaptureText(window.root/"incomplete.txt","handoff timeout\n");
+    }
+    if (!window.active && cs.pgm_hash==BrickSelector && window.epoch<4 &&
+        std::filesystem::remove(root/"capture.request",error)) {
+        window.root=root/fmt::format("epoch-{:02}",++window.epoch);
+        window.hierarchy_ids.clear();
+        window.hierarchy_requested=std::filesystem::remove(root/"hierarchy.request",error);
+        window.bytes=0;window.brick_pass=0;window.deadline=now+std::chrono::seconds{20};window.active=true;
+    }
+    if (!window.active) return {};
+    if (cs.pgm_hash==BrickSelector && window.brick_pass>=16) {
+        window.active=false;
+        WriteDreamsCaptureText(window.root/"incomplete.txt","Upstream pass budget exceeded.\n");
+        return {};
+    }
+    const auto output=cs.pgm_hash==BrickSelector
+        ? window.root/"4bc902cf"/fmt::format("pass-{:03}",window.brick_pass++)
+        : window.root/fmt::format("{:08x}",cs.pgm_hash);
+    if (std::filesystem::exists(output,error)) return {};
+    std::filesystem::create_directories(output,error);
+    if (error) {window.active=false;return {};}
+    auto s=std::make_unique<Session>();s->output=output;s->shader=cs.pgm_hash;
+    s->metadata="schema\t1\nshader_modified\tfalse\nguest_modified\tfalse\ncapture_adds_waits\ttrue\n";
+    u64 hash{};
+    s->ok &= WriteDreamsCaptureWords(output/"shader.spv",spirv,hash);
+    s->ok &= WriteDreamsCaptureWords(output/"srt.bin",cs.flattened_ud_buf,hash);
+    s->ok &= WriteDreamsCaptureWords(output/"user-data.bin",cs.user_data,hash);
+    s->ok &= WriteDreamsCaptureBytes(output/"push.bin",push,hash);
+    if (indirect) {
+        const auto raw=Read(*s,"indirect",scheduler,cache,args,0,12);
+        if (raw.size()==12) std::memcpy(dims.data(),raw.data(),12);else dims={};
+    }
+    s->metadata+=fmt::format("shader\t{:#x}\ndimensions\t{}\t{}\t{}\n",cs.pgm_hash,dims[0],dims[1],dims[2]);
+    const auto* gds=cache.GetGdsBuffer();
+    const auto counters=Read(*s,"gds-pre",scheduler,cache,{gds->Handle(),0,gds->SizeBytes()},0,4096);
+    const u32 input_count=cs.pgm_hash==BrickSelector?Word(counters,516):cs.pgm_hash==Selector?dims[0]:std::min(Word(counters,514),cs.flattened_ud_buf.size()>70?cs.flattened_ud_buf[70]:0u);
+    if (!dims[0] || dims[1]!=1 || dims[2]!=1 ||
+        input_count>(cs.pgm_hash==Geometry?MaxSamples:MaxBricks) || counters.size()!=4096) {
+        s->ok=false;s->metadata+="input_skipped\tinvalid-dimensions-or-count\n";return s;
+    }
+    std::vector<vk::DescriptorBufferInfo> exact(bindings.begin(),bindings.end());
+    for (size_t i=0;i<cs.buffers.size() && i<exact.size();++i) {
+        const auto& desc=cs.buffers[i];
+        if (desc.IsSpecial()) continue;
+        const auto sharp=desc.GetSharp(cs);
+        s->metadata+=fmt::format("buffer\t{}\tguest\t{:#x}\tbytes\t{}\tstride\t{}\n",i,sharp.base_address,sharp.GetSize(),sharp.stride);
+        if (exact[i].range==VK_WHOLE_SIZE || exact[i].range<sharp.GetSize()) {exact[i]={};continue;}
+        exact[i].offset+=exact[i].range-sharp.GetSize();exact[i].range=sharp.GetSize();
+    }
+    const auto read_numeric = [&](size_t index) {
+        if (index>=cs.buffers.size() || cs.buffers[index].IsSpecial()) {s->ok=false;return;}
+        const auto sharp=cs.buffers[index].GetSharp(cs);
+        const u64 address=sharp.base_address;
+        // These shaders read sixteen words, despite the descriptor's nominal 4 GiB.
+        // Only observe an already registered buffer; do not upload guest backing.
+        if (!address || address>=(u64{1}<<40) || sharp.stride!=0 || sharp.GetSize()<64 ||
+            !cache.IsRegionRegistered(address,1)) {s->ok=false;return;}
+        auto& buffer=*DreamsResidentBuffer(cache, address,1).first;
+        if (!buffer.IsInBounds(address,64)) {s->ok=false;return;}
+        Read(*s,"numeric-table",scheduler,cache,{buffer.Handle(),buffer.Offset(address),64},0,64);
+        s->metadata+=fmt::format("numeric_table\t{:#x}\tbytes\t64\n",address);
+    };
+    if (cs.pgm_hash==BrickSelector) {
+        if (exact.size()<8 || !BrickQueueRange(Word(counters,515),input_count,exact[2].range)) {
+            s->ok=false;s->metadata+="input_skipped\tinvalid-brick-queue-range\n";return s;
+        }
+        const u32 first=Word(counters,515);
+        s->queue_binding=exact[2];s->args_binding=exact[0];
+        s->output_binding=exact[1];s->output_size=exact[1].range;
+        s->metadata+=fmt::format("input_first\t{}\ninput_count\t{}\n",first,input_count);
+        const auto input=Read(*s,"input-records",scheduler,cache,exact[2],u64{first}*8,u64{input_count}*8);
+        std::vector<u32> bricks,objects;
+        for(size_t i=0;i<input.size()/8;++i) {
+            bricks.push_back(Word(input,i*2)&0xffffffu);objects.push_back(Word(input,i*2+1));
+        }
+        bricks=Unique(std::move(bricks));objects=Unique(std::move(objects));
+        Records(*s,"brick-children",scheduler,cache,exact[3],0,bricks,24);
+        Records(*s,"brick-metadata",scheduler,cache,exact[4],0,bricks,16);
+        Records(*s,"objects",scheduler,cache,exact[5],0,objects,432);
+        Records(*s,"brick-positions",scheduler,cache,exact[6],0,bricks,4);
+        if (window.hierarchy_requested && window.brick_pass==1)
+            window.hierarchy_ids=Hierarchy(*s,scheduler,cache,exact[3],exact[4],exact[6],bricks);
+        read_numeric(7);
+        for (size_t i=0;i<cs.images.size();++i) {
+            const auto sharp=cs.images[i].GetSharp(cs);
+            s->ok &= WriteDreamsCaptureBytes(output/fmt::format("image-{:02}-descriptor.bin",i),
+                {reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},hash);
+        }
+        for (size_t i=0;i<cs.samplers.size();++i) {
+            const auto sharp=cs.samplers[i].GetSharp(cs);
+            s->ok &= WriteDreamsCaptureBytes(output/fmt::format("sampler-{:02}.bin",i),
+                {reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},hash);
+        }
+        Images(*s,scheduler,cache,textures,images,bricks);
+        WriteDreamsCaptureText(output/"metadata-pre.tsv",s->metadata);
+        return s;
+    }
+    if (exact.size()<(cs.pgm_hash==Selector?5u:8u)) {s->ok=false;return s;}
+    const u32 input_binding=cs.pgm_hash==Selector?2:7, output_binding=cs.pgm_hash==Selector?0:1;
+    s->output_binding=exact[output_binding];s->output_size=exact[output_binding].range;
+    const u32 input_stride=cs.pgm_hash==Selector?8:16;
+    const auto input=Read(*s,"input-records",scheduler,cache,exact[input_binding],0,u64{input_count}*input_stride);
+    std::vector<u32> bricks,objects;
+    for (u32 i=0;i<input.size()/input_stride;++i) {
+        bricks.push_back(Word(input,i*(input_stride/4)) & (cs.pgm_hash==Selector?0xffffffu:0xffffffffu));
+        objects.push_back(Word(input,i*(input_stride/4)+1) & (cs.pgm_hash==Selector?0xffffffffu:0xffffu));
+    }
+    bricks=Unique(std::move(bricks));objects=Unique(std::move(objects));
+    if (bricks.size()>MaxBricks || objects.size()>MaxBricks) {s->ok=false;return s;}
+    if (cs.pgm_hash==Selector) {
+        Records(*s,"cell-nibbles",scheduler,cache,exact[1],0,bricks,172);
+        if (window.hierarchy_requested && !window.hierarchy_ids.empty())
+            HierarchyCells(*s,scheduler,cache,exact[1],window.hierarchy_ids);
+        Records(*s,"brick-positions",scheduler,cache,exact[3],0,bricks,4);
+        Records(*s,"objects",scheduler,cache,exact[4],0,objects,432);
+        // The only dynamic scalar table is sixteen words. Verify its existing BDA mapping
+        // before observing it; never register, upload, or substitute a missing guest page.
+        const u64 address=cs.user_data.size()>=4?(u64{cs.user_data[2]}|(u64{cs.user_data[3]}<<32)):0;
+        constexpr u64 PageSize=DreamsCachingPageSize;
+        bool valid=address && address<(u64{1}<<40) && (address&(PageSize-1))+64<=PageSize && cache.IsRegionRegistered(address,64);
+        if (valid) {
+            const auto* table=cache.GetBdaPageTableBuffer();
+            const auto raw=Read(*s,"numeric-table-page",scheduler,cache,{table->Handle(),0,table->SizeBytes()},(address/PageSize)*8,8);
+            u64 page{};if(raw.size()==8) std::memcpy(&page,raw.data(),8);
+            auto& buffer=*DreamsResidentBuffer(cache, address,64).first;
+            const u64 offset=buffer.Offset(address);
+            valid=page && buffer.IsInBounds(address,64) && buffer.BufferDeviceAddress()+offset==page+(address&(PageSize-1));
+            if (valid) Read(*s,"numeric-table",scheduler,cache,{buffer.Handle(),offset,64},0,64);
+        }
+        s->ok &= valid;
+        s->metadata+=fmt::format("numeric_table\t{:#x}\tvalid\t{}\n",address,valid);
+    } else {
+        Records(*s,"objects",scheduler,cache,exact[2],0,objects,432);
+        read_numeric(3);
+        Read(*s,"materials",scheduler,cache,exact[4],0,exact[4].range);
+        Records(*s,"brick-positions",scheduler,cache,exact[6],0,bricks,4);
+        const auto neighbors=Records(*s,"neighbors",scheduler,cache,exact[5],0,bricks,84);
+        for(size_t i=0;i+2<neighbors.size();i+=3) {
+            const u32 packed=u32{neighbors[i]}|(u32{neighbors[i+1]}<<8)|(u32{neighbors[i+2]}<<16);
+            bricks.push_back(packed&0x1fffffu);
+        }
+        bricks=Unique(std::move(bricks));
+    }
+    for (size_t i=0;i<cs.images.size();++i) {
+        const auto sharp=cs.images[i].GetSharp(cs);
+        s->ok &= WriteDreamsCaptureBytes(output/fmt::format("image-{:02}-descriptor.bin",i),
+            {reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},hash);
+    }
+    for (size_t i=0;i<cs.samplers.size();++i) {
+        const auto sharp=cs.samplers[i].GetSharp(cs);
+        s->ok &= WriteDreamsCaptureBytes(output/fmt::format("sampler-{:02}.bin",i),
+            {reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},hash);
+    }
+    Images(*s,scheduler,cache,textures,images,bricks);
+    WriteDreamsCaptureText(output/"metadata-pre.tsv",s->metadata);
+    return s;
+}
+
+static void End(const std::unique_ptr<Session>& s, Scheduler& scheduler, VideoCore::BufferCache& cache) {
+    if (!s) return;
+    const auto* gds=cache.GetGdsBuffer();
+    const auto counters=Read(*s,"gds-post",scheduler,cache,{gds->Handle(),0,gds->SizeBytes()},0,4096);
+    const u32 count=Word(counters,s->shader==BrickSelector?517:s->shader==Selector?514:160);
+    const u32 stride=s->shader==BrickSelector?8:s->shader==Selector?16:128;
+    if (counters.size()==4096 && count<=MaxSamples && s->output_binding.buffer &&
+        u64{count}*stride<=s->output_size) {
+        Read(*s,"output-records",scheduler,cache,s->output_binding,0,u64{count}*stride);
+    } else {s->ok=false;}
+    if (s->shader==BrickSelector) {
+        const u32 first=Word(counters,515), next=Word(counters,516);
+        if (counters.size()==4096 && s->queue_binding.buffer &&
+            BrickQueueRange(first,next,s->queue_binding.range)) {
+            Read(*s,"next-queue",scheduler,cache,s->queue_binding,u64{first}*8,u64{next}*8);
+        } else s->ok=false;
+        Read(*s,"dispatch-args",scheduler,cache,s->args_binding,0,96);
+        s->metadata+=fmt::format("next_first\t{}\nnext_count\t{}\n",first,next);
+    }
+    s->metadata+=fmt::format("output_count\t{}\noutput_stride\t{}\ncomplete\t{}\nepoch_bytes\t{}\n",count,stride,s->ok,window.bytes);
+    WriteDreamsCaptureText(s->output/"metadata.tsv",s->metadata);
+    if (s->shader==Geometry) {
+        window.active=false;
+        WriteDreamsCaptureText(window.root/"window-complete.txt","Both producer boundaries recorded; inspect each metadata completeness flag.\n");
+    }
+    LOG_WARNING(Render_Vulkan,"Private fleck producer capture shader={:#x} output_count={} complete={} bytes={}",s->shader,count,s->ok,window.bytes);
+}
+} // namespace FleckProducerCapture
diff --git a/src/video_core/renderer_vulkan/host_passes/dreams_native_volume_pass.h b/src/video_core/renderer_vulkan/host_passes/dreams_native_volume_pass.h
