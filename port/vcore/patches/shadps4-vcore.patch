+inline bool ForceB535FirstGateFailure() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_B535_FORCE_FIRST_GATE_FAILURE");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
