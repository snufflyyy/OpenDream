+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// vcore: bounded-iteration guard for translated loops.
+//
+// Each invocation keeps one Function-storage u32 counter. Every guarded back edge increments it
+// and only repeats while the counter is below the limit, so a loop that would never terminate
+// exits after `limit` iterations instead of hanging the GPU ring. Nested loops share the counter
+// (the budget bounds the whole loop nest); it is reset when an outermost loop exits, so separate
+// top-level loops each get the full budget and the counter is uniform again afterwards.
+//
+// When the guard trips, the invocation adds 1 to its shader's slot in the report buffer and
+// writes the shader hash next to it (shader_recompiler/loop_guard.h). The buffer address is a
+// u64 specialization constant: the SPIR-V stays address independent (cacheable), and pipelines
+// that don't specialize it keep the sentinel default, which disables the report (not the guard).
+
+#include "common/assert.h"
+#include "shader_recompiler/backend/spirv/emit_spirv_loop_guard.h"
+#include "shader_recompiler/backend/spirv/spirv_emit_context.h"
+#include "shader_recompiler/loop_guard.h"
+
+namespace Shader::Backend::SPIRV {
+
+bool PrepareLoopGuard(EmitContext& ctx, bool has_loops) {
+    const u32 limit = LoopGuard::Limit();
+    if (limit == 0 || !has_loops) {
+        ctx.loop_guard_limit = 0;
+        return false;
+    }
+    ctx.loop_guard_limit = limit;
+    // Reports go through a physical storage buffer pointer.
+    ctx.SetMemoryModel(spv::AddressingModel::PhysicalStorageBuffer64, spv::MemoryModel::GLSL450);
+    ctx.AddCapability(spv::Capability::PhysicalStorageBufferAddresses);
+    ctx.AddExtension("SPV_KHR_physical_storage_buffer");
+    // A unique value keeps Sirit's constant deduplication from sharing this id with a real
+    // constant; PatchLoopGuardSpecConstant turns it into OpSpecConstant.
+    ctx.loop_guard_address = ctx.Constant(ctx.U64, LoopGuard::AddressSentinel);
+    ctx.Decorate(ctx.loop_guard_address, spv::Decoration::SpecId, LoopGuard::AddressSpecId);
+    return true;
+}
+
+void DeclareLoopGuardCounter(EmitContext& ctx) {
+    if (ctx.loop_guard_limit == 0) {
+        return;
+    }
+    const Id pointer_type = ctx.TypePointer(spv::StorageClass::Function, ctx.U32[1]);
+    ctx.loop_guard_counter =
+        ctx.AddLocalVariable(pointer_type, spv::StorageClass::Function, ctx.u32_zero_value);
+    ctx.Name(ctx.loop_guard_counter, "vcore_loop_guard");
+}
+
+void ResetLoopGuardCounter(EmitContext& ctx) {
+    if (ctx.loop_guard_limit == 0 || !Sirit::ValidId(ctx.loop_guard_counter)) {
+        return;
+    }
+    ctx.OpStore(ctx.loop_guard_counter, ctx.u32_zero_value);
+}
+
+Id GuardLoopBackEdge(EmitContext& ctx, Id repeat_cond) {
+    if (ctx.loop_guard_limit == 0 || !Sirit::ValidId(ctx.loop_guard_counter)) {
+        return repeat_cond;
+    }
+    const Id count = ctx.OpLoad(ctx.U32[1], ctx.loop_guard_counter);
+    const Id next = ctx.OpIAdd(ctx.U32[1], count, ctx.u32_one_value);
+    ctx.OpStore(ctx.loop_guard_counter, next);
+    const Id within = ctx.OpULessThan(ctx.U1[1], next, ctx.ConstU32(ctx.loop_guard_limit));
+
+    // Report: only when this back edge wanted to repeat but the budget is exhausted, and a report
+    // buffer was specialized in.
+    const Id address = ctx.loop_guard_address;
+    const Id address_high = ctx.OpUConvert(
+        ctx.U32[1], ctx.OpShiftRightLogical(ctx.U64, address, ctx.ConstU32(32u)));
+    const Id has_buffer =
+        ctx.OpINotEqual(ctx.U1[1], address_high, ctx.ConstU32(LoopGuard::AddressSentinelHigh));
+    const Id tripped = ctx.OpLogicalAnd(
+        ctx.U1[1], ctx.OpLogicalAnd(ctx.U1[1], repeat_cond, ctx.OpLogicalNot(ctx.U1[1], within)),
+        has_buffer);
+
+    const Id report_label = ctx.OpLabel();
+    const Id merge_label = ctx.OpLabel();
+    ctx.OpSelectionMerge(merge_label, spv::SelectionControlMask::MaskNone);
+    ctx.OpBranchConditional(tripped, report_label, merge_label);
+
+    ctx.AddLabel(report_label);
+    const u64 slot_offset =
+        static_cast<u64>(LoopGuard::SlotOf(ctx.info.pgm_hash)) * LoopGuard::SlotBytes;
+    const Id pointer_type = ctx.TypePointer(spv::StorageClass::PhysicalStorageBuffer, ctx.U32[1]);
+    const Id scope = ctx.ConstU32(static_cast<u32>(spv::Scope::Device));
+    const Id semantics = ctx.u32_zero_value;
+    const auto word_pointer = [&](u32 word) {
+        const Id word_address =
+            ctx.OpIAdd(ctx.U64, address, ctx.Constant(ctx.U64, slot_offset + word * 4ULL));
+        return ctx.OpConvertUToPtr(pointer_type, word_address);
+    };
+    ctx.OpAtomicIAdd(ctx.U32[1], word_pointer(0), scope, semantics, ctx.u32_one_value);
+    ctx.OpAtomicExchange(ctx.U32[1], word_pointer(1), scope, semantics,
+                         ctx.ConstU32(static_cast<u32>(ctx.info.pgm_hash)));
+    ctx.OpAtomicExchange(ctx.U32[1], word_pointer(2), scope, semantics,
+                         ctx.ConstU32(static_cast<u32>(ctx.info.pgm_hash >> 32)));
+    ctx.OpBranch(merge_label);
+
+    ctx.AddLabel(merge_label);
+    return ctx.OpLogicalAnd(ctx.U1[1], repeat_cond, within);
+}
+
+void PatchLoopGuardSpecConstant(EmitContext& ctx, std::vector<u32>& spirv) {
+    if (ctx.loop_guard_limit == 0 || !Sirit::ValidId(ctx.loop_guard_address)) {
+        return;
+    }
+    bool patched{};
+    for (size_t offset = 5; offset < spirv.size();) {
+        const u32 word_count = spirv[offset] >> 16;
+        const auto opcode = static_cast<spv::Op>(spirv[offset] & 0xffff);
+        ASSERT_MSG(word_count != 0 && offset + word_count <= spirv.size(),
+                   "Malformed SPIR-V instruction at dword {}", offset);
+        if (opcode == spv::Op::OpConstant && word_count == 5 &&
+            spirv[offset + 2] == ctx.loop_guard_address.value) {
+            ASSERT_MSG(!patched, "Loop guard address constant was declared more than once");
+            spirv[offset] = (word_count << 16) | static_cast<u32>(spv::Op::OpSpecConstant);
+            patched = true;
+        }
+        offset += word_count;
+    }
+    ASSERT_MSG(patched, "Loop guard address constant declaration was not found");
+}
+
+} // namespace Shader::Backend::SPIRV
