+                        // Capture their GPU backing as well as the flattened SRT.
+                        bool projection_ok = material->user_data.size() >= 5;
+                        VAddr projection_address{};
+                        std::array<u8, 16> projection{};
+                        if (projection_ok) {
+                            constexpr u64 AddressMask = (u64{1} << 48) - 1;
