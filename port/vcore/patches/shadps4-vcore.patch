+void Rasterizer::CaptureDreamsFrameResources(const Shader::Info& stage) {
+    if(!dreams_frame_capture_active || dreams_frame_capture_event>512) return;
+    const bool source_capture = DreamsDensitySourceCaptureDirectory() != nullptr;
+    if (source_capture && (stage.sw_stage != Shader::SwStage::Compute ||
+                           (stage.pgm_hash != 0x7ba4de5d && stage.pgm_hash != 0x9e21bbd7 &&
+                            stage.pgm_hash != 0x32f92899))) return;
+    const bool cache_writer = source_capture && stage.pgm_hash != 0x7ba4de5d;
+    const u64 source_budget = cache_writer ? 384_MB : 256_MB;
+    scheduler.EndRendering();
+    const auto prefix=fmt::format("stage-{}",static_cast<u32>(stage.sw_stage));
+    u64 hash{};std::string meta=fmt::format("hash\t{:#x}\nstage\t{}\n",stage.pgm_hash,static_cast<u32>(stage.sw_stage));
+    WriteDreamsCaptureWords(dreams_frame_capture_event_path/(prefix+".spv"),pipeline_cache.GetCurrentShaderSpirv(stage.sw_stage),hash);
+    WriteDreamsCaptureWords(dreams_frame_capture_event_path/(prefix+"-srt.bin"),stage.flattened_ud_buf,hash);
+    WriteDreamsCaptureBytes(dreams_frame_capture_event_path/"gpu-regs.bin",std::span<const u8>{reinterpret_cast<const u8*>(&liverpool->regs),sizeof(liverpool->regs)},hash);
+    WriteDreamsCaptureWords(dreams_frame_capture_event_path/(prefix+"-user-data.bin"),stage.user_data,hash);
+    WriteDreamsCaptureBytes(dreams_frame_capture_event_path/"push-data.bin",std::span<const u8>{reinterpret_cast<const u8*>(&push_data),sizeof(push_data)},hash);
+    for(u32 index=0;index<stage.buffers.size();++index) {
+        const auto& desc=stage.buffers[index];if(desc.IsSpecial()) continue;
+        const auto sharp=desc.GetSharp(stage);const u64 bytes=sharp.GetSize();
+        meta+=fmt::format("buffer{}\t{:#x}+{}\n",index,sharp.base_address,bytes);
+        if (source_capture && ((!cache_writer && !SourceGenerationCapture::IsInput(index)) || bytes > 64_MB ||
+            dreams_frame_capture_bytes > source_budget || bytes > source_budget - dreams_frame_capture_bytes)) {
+            meta += fmt::format("buffer{}_skipped\tsource-recorder-scope-or-budget\n", index);
+            continue;
+        }
+        if((dreams_frame_capture_event_path.filename()=="post" && !desc.is_written) || !dreams_frame_capture_material || !bytes || bytes>(static_cast<const char*>(nullptr) /* release: DIAGNOSTIC_GENERATION_DIR disabled */ && stage.pgm_hash==0x7ba4de5d?256_MB:(stage.sw_stage==Shader::SwStage::Compute?64_MB:4_MB)) || dreams_frame_capture_bytes+bytes>(static_cast<const char*>(nullptr) /* release: DIAGNOSTIC_GENERATION_DIR disabled */?1024_MB:4096_MB) || !memory->IsValidMapping(sharp.base_address,bytes)) continue;
+        if (source_capture) {
+            // Observe the binding already submitted to this dispatch. Resolving
+            // the guest address again could upload CPU backing or replace it.
+            const bool ok = index < buffer_infos.size() &&
+                SourceGenerationCapture::Save(scheduler, buffer_cache, buffer_infos[index],
+                    bytes, dreams_frame_capture_bytes,
+                    dreams_frame_capture_event_path / fmt::format("{}-buffer{}.bin", prefix, index),
+                    source_budget);
+            meta += fmt::format("buffer{}_read\t{}\nbuffer{}_exact_binding\ttrue\n", index, ok, index);
+            if (ok) WriteDreamsCaptureBytes(dreams_frame_capture_event_path/fmt::format("{}-buffer{}-descriptor.bin",prefix,index),
+                std::span<const u8>{reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},hash);
+            continue;
+        }
+        const auto [source,offset]=buffer_cache.ObtainBuffer(sharp.base_address,static_cast<u32>(bytes));
+        if(!source) continue;
+        std::vector<u8> data(static_cast<size_t>(bytes));
+        bool ok=true;
+        for(u64 chunk=0;chunk<bytes && ok;chunk+=16_MB) {
+            const u64 amount=std::min<u64>(16_MB,bytes-chunk);
+            ok=ReadDreamsBoundBufferForCapture(scheduler,buffer_cache,
+                vk::DescriptorBufferInfo{source->Handle(),offset,bytes},chunk,
+                std::span<u8>{data}.subspan(chunk,amount));
+        }
+        if(ok) WriteDreamsCaptureBytes(dreams_frame_capture_event_path/fmt::format("{}-buffer{}.bin",prefix,index),data,hash);
+        dreams_frame_capture_bytes+=bytes;meta+=fmt::format("buffer{}_read\t{}\n",index,ok);
+    }
+    if (source_capture) {
+        meta += fmt::format("dispatch_dimensions\t{}\t{}\t{}\nindirect\t{}\nsequence\t{}\n",
+            g_dreams_source_capture_dimensions[0], g_dreams_source_capture_dimensions[1],
+            g_dreams_source_capture_dimensions[2], g_dreams_source_capture_indirect,
+            g_compute_dispatch_sequence);
+    }
+    if (cache_writer) {
+        // Preserve the small guest GDS region containing the allocation counters.
+        if (const auto* gds = buffer_cache.GetGdsBuffer()) {
+            const bool ok = SourceGenerationCapture::Save(scheduler, buffer_cache,
+                vk::DescriptorBufferInfo{gds->Handle(), 0, 64_KB}, 64_KB,
+                dreams_frame_capture_bytes, dreams_frame_capture_event_path / "gds-prefix.bin", source_budget);
+            meta += fmt::format("gds_prefix_read\t{}\n", ok);
+        }
+        // Hash seeds are fetched dynamically. Read their registered GPU backing,
+        // requiring agreement with the BDA table; never obtain/upload CPU memory.
+        if (stage.user_data.size() >= 4) {
+            const VAddr address = u64{stage.user_data[2]} | (u64{stage.user_data[3]} << 32);
+            constexpr u64 PageSize = DreamsCachingPageSize;
+            constexpr u64 bytes = 128;
+            bool ok = false;
+            if (address && address < (u64{1} << 40) && bytes <= (u64{1} << 40) - address &&
+                (address & (PageSize - 1)) + bytes <= PageSize && buffer_cache.IsRegionRegistered(address, bytes)) {
+                const auto* table = buffer_cache.GetBdaPageTableBuffer();
+                u64 gpu_page{};
+                const bool mapped = ReadDreamsBoundBufferForCapture(scheduler, buffer_cache,
+                    vk::DescriptorBufferInfo{table->Handle(), 0, table->SizeBytes()},
+                    (address / PageSize) * sizeof(u64),
+                    std::span<u8>{reinterpret_cast<u8*>(&gpu_page), sizeof(gpu_page)});
+                if (mapped && gpu_page) {
+                    auto& source = *DreamsResidentBuffer(buffer_cache, address, bytes).first;
+                    const u64 offset = source.Offset(address);
+                    if (source.IsInBounds(address, bytes) && source.BufferDeviceAddress() + offset ==
+                        gpu_page + (address & (PageSize - 1))) {
+                        ok = SourceGenerationCapture::Save(scheduler, buffer_cache,
+                            vk::DescriptorBufferInfo{source.Handle(), offset, bytes}, bytes,
+                            dreams_frame_capture_bytes, dreams_frame_capture_event_path / "hash-seeds.bin", source_budget);
+                    }
+                }
+            }
+            meta += fmt::format("hash_seeds_address\t{:#x}\nhash_seeds_read\t{}\n", address, ok);
+        }
+    }
+    for(u32 index=0;index<stage.samplers.size();++index) {
+        const auto sharp=stage.samplers[index].GetSharp(stage);
+        WriteDreamsCaptureBytes(dreams_frame_capture_event_path/fmt::format("{}-sampler{}.bin",prefix,index),
+            std::span<const u8>{reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},hash);
+    }
+    for(u32 index=0;index<num_image_bindings;++index) {
+        const auto& entry=image_bindings[index];if(!entry.image_id) continue;
+        auto& image=texture_cache.GetImage(entry.image_id);
+        meta+=fmt::format("image{}\tguest={:#x};{}x{}x{};format={}\n",index,image.info.guest_address,
+            image.info.size.width,image.info.size.height,image.info.size.depth,vk::to_string(image.info.pixel_format));
+        const bool saved=dreams_frame_capture_material && CaptureDreamsFrameImage(entry.image_id,dreams_frame_capture_event_path/fmt::format("{}-image{}.bin",prefix,index));
+        meta+=fmt::format("image{}_saved\t{}\n",index,saved);
+    }
+    if (source_capture && dreams_frame_capture_event_path.filename() == "post") {
+        bool density_ok = false;
+        const auto recent = g_recent_compute_dispatches[(g_recent_compute_dispatch_index - 1) %
+                                                        g_recent_compute_dispatches.size()];
+        if (recent.hash == 0x7ba4de5d && recent.dim_x &&
+            recent.dim_x <= SourceDensityOutput::MaxGroups && recent.dim_y == 1 && recent.dim_z == 1 &&
+            stage.flattened_ud_buf.size() > 96 && stage.buffers.size() > 6 &&
+            !stage.buffers[6].IsSpecial() && buffer_infos.size() > 6 &&
+            num_image_bindings > 1 && image_bindings[1].image_id) {
+            const auto sharp = stage.buffers[6].GetSharp(stage);
+            const auto binding = buffer_infos[6];
+            const u64 declared = sharp.GetSize();
+            if (sharp.stride == 2 && declared && declared <= 64 * 1024 && declared % 2 == 0 &&
+                binding.buffer && binding.range != VK_WHOLE_SIZE && binding.range >= declared) {
+                std::vector<u16> lookup(static_cast<size_t>(declared / 2));
+                if (ReadDreamsBoundBufferForCapture(scheduler, buffer_cache, binding,
+                        binding.range - declared, std::span<u8>{
+                            reinterpret_cast<u8*>(lookup.data()), static_cast<size_t>(declared)})) {
+                    density_ok = SourceDensityOutput::Save(scheduler, buffer_cache,
+                        texture_cache.GetImage(image_bindings[1].image_id), lookup,
+                        stage.flattened_ud_buf[96], recent.dim_x, dreams_frame_capture_bytes,
+                        dreams_frame_capture_event_path);
+                }
+            }
+        }
+        meta += fmt::format("generated_density_captured\t{}\ngeneration_sequence\t{}\n",
+                            density_ok, g_compute_dispatch_sequence);
+    }
+    WriteDreamsCaptureText(dreams_frame_capture_event_path/(prefix+"-resources.tsv"),meta);
+    WriteDreamsCaptureText(dreams_frame_capture_root/"progress.tsv",dreams_frame_capture_log);
+}
