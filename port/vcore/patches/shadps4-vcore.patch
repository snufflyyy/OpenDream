+                const u32 end = std::min<u32>(start + stride_dwords, num_dwords);
+                bool nonzero = false;
+                for (u32 i = start; i < end; ++i) {
+                    nonzero |= words[i] != 0;
+                }
+                if (!nonzero) {
+                    continue;
+                }
+                ++scan.nonzero_records;
+                if (scan.first_record == std::numeric_limits<u32>::max()) {
+                    scan.first_record = record;
+                    for (u32 i = 0; i < scan.first_record_values.size() && start + i < end; ++i) {
+                        scan.first_record_values[i] = words[start + i];
+                    }
+                }
+            }
+            return scan;
+        };
+        const auto queue_scan = scan_buffer(1, 64_KB);
+        const auto transform_scan = scan_buffer(2, std::numeric_limits<u64>::max());
+        const auto input_scan = scan_buffer(3, std::numeric_limits<u64>::max());
+        const auto material_scan = scan_buffer(4, std::numeric_limits<u64>::max());
+        const auto log_scan = [](const char* name, const BufferScan& scan) {
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams producer {} scan nonzero_dw={} first_dw={} value={:#x} "
+                        "nonzero_records={} first_record={} sample={:#x},{:#x},{:#x},{:#x},"
+                        "{:#x},{:#x},{:#x},{:#x}",
+                        name, scan.nonzero_dwords, scan.first_dword, scan.first_value,
+                        scan.nonzero_records, scan.first_record, scan.first_record_values[0],
+                        scan.first_record_values[1], scan.first_record_values[2],
+                        scan.first_record_values[3], scan.first_record_values[4],
+                        scan.first_record_values[5], scan.first_record_values[6],
+                        scan.first_record_values[7]);
+        };
+        log_scan("queue", queue_scan);
+        log_scan("transforms", transform_scan);
+        log_scan("input", input_scan);
+        log_scan("material", material_scan);
+
+        std::array<u32, 32> srt_values{};
+        VAddr srt_address{};
+        if (cs.user_data.size() >= 2) {
+            srt_address = (u64{cs.user_data[0]} | (u64{cs.user_data[1]} << 32)) & 0xFFFFFFFFFFFFULL;
+        }
+        if (srt_address != 0 && memory->IsValidMapping(srt_address, sizeof(srt_values))) {
+            buffer_cache.ReadMemory(srt_address, sizeof(srt_values));
+            std::memcpy(srt_values.data(), std::bit_cast<const void*>(srt_address),
+                        sizeof(srt_values));
+        }
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams producer SRT={:#x} c2={} c6={} c20-29={:#x},{:#x},{:#x},{:#x},"
+                    "{:#x},{:#x},{:#x},{:#x},{:#x},{:#x}",
+                    srt_address, srt_values[2], srt_values[6], srt_values[20], srt_values[21],
+                    srt_values[22], srt_values[23], srt_values[24], srt_values[25], srt_values[26],
+                    srt_values[27], srt_values[28], srt_values[29]);
+    }
+    if (profile) {
+        scheduler.Finish();
+    }
+    if (trace_dreams_csg_replay_setup) {
+        scheduler.Finish();
+        std::array<u32, 3> args{};
+        std::array<u32, 11> state{};
+        read_dreams_csg_direct_state(args, state);
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams CSG setup post args={:#x} dims={}x{}x{} state={:#x} "
+                    "d576-586={},{},{},{},{},{},{},{},{},{},{}",
+                    dreams_csg_args_address, args[0], args[1], args[2], dreams_csg_state_address,
+                    state[0], state[1], state[2], state[3], state[4], state[5], state[6], state[7],
+                    state[8], state[9], state[10]);
+    }
+    if (dreams_csg_builder_trace.enabled) {
+        scheduler.Finish();
+        const auto* gds = buffer_cache.GetGdsBuffer();
+        std::array<u32, 2> gds_after{};
+        std::memcpy(&gds_after[0], gds->mapped_data.data() + 14 * sizeof(u32), sizeof(u32));
+        std::memcpy(&gds_after[1], gds->mapped_data.data() + 18 * sizeof(u32), sizeof(u32));
+        LOG_WARNING(Render_Vulkan, "Dreams CSG builder post #{} gds14={}->{} gds18={}->{}",
+                    dreams_csg_builder_trace.ordinal, dreams_csg_builder_trace.gds_before[0],
+                    gds_after[0], dreams_csg_builder_trace.gds_before[1], gds_after[1]);
+        for (u32 index = 0; index < std::min<u32>(2, cs.buffers.size()); ++index) {
+            const auto& desc = cs.buffers[index];
+            if (desc.IsSpecial()) {
+                continue;
+            }
+            const auto sharp = desc.GetSharp(cs);
+            const u64 read_size = std::min<u64>(sharp.GetSize(), 1_MB) & ~u64{3};
+            if (sharp.base_address == 0 || read_size == 0 ||
+                !memory->IsValidMapping(sharp.base_address, read_size)) {
+                continue;
+            }
+            buffer_cache.ReadMemory(sharp.base_address, read_size);
+            const auto* words = std::bit_cast<const u32*>(sharp.base_address);
+            u32 nonzero{};
+            u32 first_nonzero = std::numeric_limits<u32>::max();
+            u32 first_value{};
+            for (u32 word = 0; word < read_size / sizeof(u32); ++word) {
+                if (words[word] == 0) {
+                    continue;
+                }
+                ++nonzero;
+                if (first_nonzero == std::numeric_limits<u32>::max()) {
+                    first_nonzero = word;
+                    first_value = words[word];
+                }
+            }
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams CSG builder output #{} index={} base={:#x}+{:#x} stride={} "
+                        "nonzero={} first={} value={:#x}",
+                        dreams_csg_builder_trace.ordinal, index, sharp.base_address,
+                        sharp.GetSize(), sharp.stride, nonzero, first_nonzero, first_value);
+        }
+    }
+    if (cs.pgm_hash == Shader::DreamsCompat::GatherVoxelsShader &&
+        g_dreams_7ba_provenance_capture.active &&
+        g_dreams_7ba_provenance_capture.producer_sequence == g_compute_dispatch_sequence) {
+        auto& capture = g_dreams_7ba_provenance_capture;
+        const auto& b0 = capture.producer_buffers[0];
+        const auto& b1 = capture.producer_buffers[1];
+        const auto& b2 = capture.producer_buffers[2];
+        const auto& b3 = capture.producer_buffers[3];
+        const auto byte_span = []<typename T>(T& value) {
+            return std::span<u8>{reinterpret_cast<u8*>(&value), sizeof(value)};
+        };
+        const auto append_region = [&](std::vector<DreamsBoundBufferCaptureRegion>& regions,
+                                       const DreamsBoundBufferIdentity& buffer, u64 byte_offset,
+                                       std::span<u8> destination) {
+            if (!buffer.valid || byte_offset > buffer.guest_size ||
+                destination.size() > buffer.guest_size - byte_offset ||
+                byte_offset > std::numeric_limits<u64>::max() - buffer.logical_base_offset) {
+                return false;
+            }
+            regions.push_back({
+                .source = buffer.descriptor,
+                .relative_offset = buffer.logical_base_offset + byte_offset,
+                .destination = destination,
+            });
+            return true;
+        };
+
+        bool valid = true;
+        std::vector<DreamsBoundBufferCaptureRegion> regions;
+        regions.reserve(static_cast<u64>(capture.rows.size()) * 4);
+        for (u32 row_index = 0; valid && row_index < capture.rows.size(); ++row_index) {
+            auto& row = capture.rows[row_index];
+            if (row.owner_row != row_index) {
+                continue;
+            }
+            valid &= append_region(regions, b0,
+                                   static_cast<u64>(row.packed_row) * b0.stride,
+                                   byte_span(row.buffer0_post));
+            valid &= append_region(regions, b1,
+                                   static_cast<u64>(row.packed_row) * b1.stride,
+                                   byte_span(row.buffer1_post));
+            valid &= append_region(regions, b2,
+                                   static_cast<u64>(row.packed_row) * b2.stride,
+                                   byte_span(row.buffer2_post));
+            valid &= append_region(regions, b3,
+                                   static_cast<u64>(row.packed_row) * row.record_post.size(),
+                                   byte_span(row.record_post));
+        }
+        if (valid) {
+            valid = ReadDreamsBoundBufferRegionsForCapture(scheduler, buffer_cache, regions);
+        }
+        if (valid) {
+            for (u32 row_index = 0; row_index < capture.rows.size(); ++row_index) {
+                auto& row = capture.rows[row_index];
+                if (row.owner_row == row_index) {
+                    continue;
+                }
+                const auto& owner = capture.rows[row.owner_row];
+                row.buffer0_post = owner.buffer0_post;
+                row.buffer1_post = owner.buffer1_post;
+                row.buffer2_post = owner.buffer2_post;
+                row.record_post = owner.record_post;
+            }
+            constexpr std::array<u32, 2> GdsIndices{64, 122};
+            auto* gds = buffer_cache.GetGdsBuffer();
+            for (u32 index = 0; index < GdsIndices.size(); ++index) {
+                const u64 offset = static_cast<u64>(GdsIndices[index]) * sizeof(u32);
+                if (offset + sizeof(u32) <= gds->mapped_data.size()) {
+                    gds->InvalidateMappedRange(offset, sizeof(u32));
+                    std::memcpy(&capture.gds_post[index], gds->mapped_data.data() + offset,
+                                sizeof(u32));
+                }
+            }
+        }
+        if (!valid) {
+            FailDreams7baProvenance("full-dispatch output post-readback was incomplete");
+        } else {
+            const auto pass_output = capture.output_dir /
+                fmt::format("pass-{:02}", capture.producer_pass_count);
+            std::error_code pass_error;
+            std::filesystem::create_directories(pass_output, pass_error);
+            std::ofstream rows{pass_output / "7ba-rows.tsv", std::ios::trunc};
+            rows << "producer_sequence\tworkgroup_x\tinput_index\tinput_key\tlogical_row\t"
+                    "lookup_index\tlookup_value\tpacked_row\towner_row\tclassification\t"
+                    "buffer0_pre\tbuffer0_post\tbuffer1_pre_0\tbuffer1_pre_1\t"
+                    "buffer1_pre_2\tbuffer1_pre_3\tbuffer1_post_0\tbuffer1_post_1\t"
+                    "buffer1_post_2\tbuffer1_post_3\tbuffer2_pre\tbuffer2_post\t"
+                    "record_pre_hash\trecord_post_hash\trecord_changed_bytes\n";
+            u32 accepted_transition_count{};
+            u32 accepted_or_preexisting_count{};
+            for (const auto& row : capture.rows) {
+                const std::string_view classification = ClassifyDreams7baProvenanceRow(row);
+                accepted_transition_count += classification == "accepted_transition";
+                accepted_or_preexisting_count += classification == "accepted_or_preexisting";
+                u32 record_changed_bytes{};
+                for (u32 index = 0; index < row.record_pre.size(); ++index) {
+                    record_changed_bytes += row.record_pre[index] != row.record_post[index];
+                }
+                rows << fmt::format(
+                    "{}\t{}\t{}\t{:#010x}\t{}\t{}\t{}\t{}\t{}\t{}\t{:#010x}\t"
+                    "{:#010x}\t{:#010x}\t{:#010x}\t{:#010x}\t{:#010x}\t{:#010x}\t"
+                    "{:#010x}\t{:#010x}\t{:#010x}\t{:#010x}\t{:#010x}\t{:#018x}\t"
+                    "{:#018x}\t{}\n",
+                    capture.producer_sequence, row.workgroup_x, row.input_index, row.input_key,
+                    row.logical_row, row.lookup_index, row.lookup_value, row.packed_row,
+                    row.owner_row, classification, row.buffer0_pre, row.buffer0_post,
+                    row.buffer1_pre[0], row.buffer1_pre[1], row.buffer1_pre[2],
+                    row.buffer1_pre[3], row.buffer1_post[0], row.buffer1_post[1],
+                    row.buffer1_post[2], row.buffer1_post[3], row.buffer2_pre, row.buffer2_post,
+                    HashDreamsTraceBytes(row.record_pre), HashDreamsTraceBytes(row.record_post),
+                    record_changed_bytes);
+            }
+            std::vector<u8> records_pre;
+            std::vector<u8> records_post;
+            records_pre.reserve(static_cast<u64>(capture.rows.size()) * 172);
+            records_post.reserve(static_cast<u64>(capture.rows.size()) * 172);
+            for (const auto& row : capture.rows) {
+                records_pre.insert(records_pre.end(), row.record_pre.begin(), row.record_pre.end());
+                records_post.insert(records_post.end(), row.record_post.begin(),
+                                    row.record_post.end());
+            }
+            u64 records_pre_hash{};
+            u64 records_post_hash{};
+            const bool records_written =
+                WriteDreamsCaptureBytes(pass_output / "7ba-buffer3-records-pre.bin",
+                                        records_pre, records_pre_hash) &&
+                WriteDreamsCaptureBytes(pass_output / "7ba-buffer3-records.bin",
+                                        records_post, records_post_hash);
+            std::string resources = fmt::format(
+                "producer_sequence\tdispatch_base_x\tdispatch_x\tdispatch_y\tdispatch_z\t"
+                "input_base_index\tlogical_base\tgds64_pre\tgds64_post\tgds122_pre\t"
+                "gds122_post\taccepted_transition\taccepted_or_preexisting\t"
+                "records_pre_hash\trecords_post_hash\n{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t"
+                "{}\t{}\t{}\t{}\t{}\t{:#018x}\t{:#018x}\n\nrole\tbinding\tguest_base\t"
+                "guest_size\tstride\trecords\t"
+                "vk_buffer\tdescriptor_offset\tdescriptor_range\tlogical_base_offset\t"
+                "raw0\traw1\traw2\traw3\n",
+                capture.producer_sequence, capture.dispatch_base_x, capture.dispatch_x,
+                capture.dispatch_y, capture.dispatch_z, capture.input_base_index,
+                capture.logical_base, capture.gds_pre[0], capture.gds_post[0],
+                capture.gds_pre[1], capture.gds_post[1], accepted_transition_count,
+                accepted_or_preexisting_count, records_pre_hash, records_post_hash);
+            for (const u32 binding : {0u, 1u, 2u, 3u, 6u, 14u}) {
+                const auto& buffer = capture.producer_buffers[binding];
+                resources += fmt::format(
+                    "producer\t{}\t{:#x}\t{:#x}\t{}\t{}\t{:#x}\t{:#x}\t{:#x}\t{:#x}"
+                    "\t{:#010x}\t{:#010x}\t{:#010x}\t{:#010x}\n",
+                    binding, buffer.guest_base, buffer.guest_size, buffer.stride,
+                    buffer.num_records, buffer.backing_handle,
+                    static_cast<u64>(buffer.descriptor.offset),
+                    static_cast<u64>(buffer.descriptor.range), buffer.logical_base_offset,
+                    buffer.raw_descriptor[0], buffer.raw_descriptor[1],
+                    buffer.raw_descriptor[2], buffer.raw_descriptor[3]);
+            }
+            resources +=
+                "\nproducer_image_binding\tbacking\tdescriptor_base\tguest_base\tguest_size\t"
+                "descriptor_width\tdescriptor_height\tdescriptor_depth\tpitch\tview_type\t"
+                "view_format\tbase_level\tlevels\tbase_layer\tlayers\traw0\traw1\traw2\t"
+                "raw3\n";
+            for (u32 binding = 0; binding < capture.producer_images.size(); ++binding) {
+                const auto& image = capture.producer_images[binding];
+                resources += fmt::format(
+                    "{}\t{:#x}\t{:#x}\t{:#x}\t{:#x}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t"
+                    "{}\t{}\t{:#018x}\t{:#018x}\t{:#018x}\t{:#018x}\n",
+                    binding, image.backing_handle, image.descriptor_base, image.guest_base,
+                    image.guest_size, image.descriptor_width, image.descriptor_height,
+                    image.descriptor_depth, image.descriptor_pitch, image.view_type,
+                    image.view_format, image.base_level, image.levels, image.base_layer,
+                    image.layers, image.raw_descriptor[0], image.raw_descriptor[1],
+                    image.raw_descriptor[2], image.raw_descriptor[3]);
+            }
+            const bool metadata_written =
+                WriteDreamsCaptureText(pass_output / "resources.tsv", resources);
+            constexpr u32 MaxProducerPasses = 16;
+            const bool pass_summary_written = AppendDreamsCaptureText(
+                capture.output_dir / "producer-passes.tsv",
+                fmt::format("{}\t{}\t{}\t{}\t{:#018x}\n", capture.producer_pass_count,
+                            capture.producer_sequence, accepted_transition_count,
+                            accepted_or_preexisting_count, records_post_hash));
+            ++capture.producer_pass_count;
+            if (!rows || !records_written || !metadata_written || !pass_summary_written) {
+                FailDreams7baProvenance("failed to write producer capture files");
+            } else if (accepted_transition_count == 0 && accepted_or_preexisting_count == 0) {
+                if (capture.producer_pass_count >= MaxProducerPasses) {
+                    FailDreams7baProvenance(fmt::format(
+                        "no accepted 7ba rows after {} consecutive producer passes",
+                        capture.producer_pass_count));
+                } else {
+                    capture.active = false;
+                    capture.retry_next_producer = true;
+                    LOG_WARNING(Render_Vulkan,
+                                "Dreams 7ba provenance producer sequence={} pass={} had no "
+                                "accepted rows; retaining the one-shot capture for the next "
+                                "producer pass",
+                                capture.producer_sequence, capture.producer_pass_count - 1);
+                }
+            } else {
+                capture.active = false;
+                capture.waiting_for_consumer = true;
+                LOG_WARNING(Render_Vulkan,
+                            "Dreams 7ba provenance producer complete sequence={} rows={} "
+                            "accepted_transition={} accepted_or_preexisting={} "
+                            "records_post_hash={:#x}; waiting for matching 84aa",
+                            capture.producer_sequence, capture.rows.size(),
+                            accepted_transition_count, accepted_or_preexisting_count,
+                            records_post_hash);
+            }
+        }
+    }
+    if (profile) {
+        const auto elapsed = std::chrono::duration<double, std::milli>(
+                                 std::chrono::steady_clock::now() - profile_start)
+                                 .count();
+        LOG_WARNING(Render_Vulkan, "Compute profile hash={:#x} dims={}x{}x{} elapsed={:.3f}ms",
+                    cs.pgm_hash, cs_program.dim_x, cs_program.dim_y, cs_program.dim_z, elapsed);
+    }
+    if (DreamsDensitySourceCaptureDirectory() &&
+        (cs.pgm_hash == 0x7ba4de5d || cs.pgm_hash == 0x9e21bbd7 || cs.pgm_hash == 0x32f92899) &&
+        dreams_frame_capture_active && dreams_frame_capture_event == 1 &&
+        cs.sw_stage == Shader::SwStage::Compute) {
+        const auto input_path = dreams_frame_capture_event_path;
+        dreams_frame_capture_event_path /= "post";
+        std::error_code capture_error;
+        std::filesystem::create_directories(dreams_frame_capture_event_path, capture_error);
+        CaptureDreamsFrameResources(cs);
+        dreams_frame_capture_event_path = input_path;
+        CaptureDreamsFrameEnd();
+    }
+    DetailResultCapture::End(detail_result_capture,scheduler,buffer_cache);
+    FleckProducerCapture::End(fleck_producer_capture,scheduler,buffer_cache);
+    DebugState.IncDispatch();
+    if (dreams_performance_profiler) {
+        dreams_performance_profiler->CountDispatch();
+    }
+
+    if (!primary_probe_directory.empty()) {
+        std::array<u32, 384> post{};
+        primary_probe_files_ok &= ReadPrimaryQueueProbeGds(scheduler, buffer_cache, post);
+        u64 ignored_hash{};
+        primary_probe_files_ok &= WriteDreamsCaptureWords(
+            primary_probe_directory / "gds-post.bin", post, ignored_hash);
+        const u32 begin = primary_probe_gds_pre[322];
+        const u32 end = post[322];
+        const bool interval_valid = end >= begin && end - begin <= primary_probe_root_count;
+        std::vector<u32> queue;
+        std::vector<u32> args;
+        bool queue_valid = false;
+        if (interval_valid && cs.buffers.size() > 1 && !cs.buffers[1].IsSpecial()) {
+            const auto sharp = cs.buffers[1].GetSharp(cs);
+            const u64 bytes = u64{end - begin} * sizeof(u32) * 2;
+            queue_valid = sharp.stride == 8 && bytes <= 2_MB &&
+                read_dreams_producer_gpu_words(1, sharp, u64{begin} * 8, bytes, queue);
+        }
+        const bool args_valid = !cs.buffers.empty() && !cs.buffers[0].IsSpecial() &&
+            read_dreams_producer_gpu_words(0, cs.buffers[0].GetSharp(cs), 0, 12, args);
+        primary_probe_files_ok &= queue_valid && args_valid;
+        primary_probe_files_ok &= WriteDreamsCaptureWords(
+            primary_probe_directory / "queue.bin", queue, ignored_hash);
+        primary_probe_files_ok &= WriteDreamsCaptureWords(
+            primary_probe_directory / "args.bin", args, ignored_hash);
+        const auto audit = DreamsPrimaryQueueProbe::Audit(queue, primary_probe_root_count);
+        const std::string summary = fmt::format(
+            "sequence\t{}\nmode\t{}\nrequested_ordered\t{}\nshape_supported\t{}\n"
+            "groups\t{}\nthreads\t{}\nroot_count\t{}\npre_counter\t{}\n"
+            "post_counter\t{}\npublished_count\t{}\nqueue_base\t{}\n"
+            "interval_valid\t{}\nqueue_valid\t{}\nargs_valid\t{}\n"
+            "duplicate_roots\t{}\ninvalid_roots\t{}\ndescending_roots\t{}\n"
+            "files_ok\t{}\n",
+            g_compute_dispatch_sequence, order_primary_queue ? "ordered" : "native",
+            primary_probe.ordered, primary_probe_shape, cs_program.dim_x,
+            cs_program.num_thread_x.full, primary_probe_root_count, begin, end, post[321],
+            post[320], interval_valid, queue_valid, args_valid, audit.duplicate_roots,
+            audit.invalid_roots, audit.descending_roots, primary_probe_files_ok);
+        primary_probe_files_ok &= WriteDreamsCaptureText(
+            primary_probe_directory / "summary.tsv", summary);
+        primary_probe.pending_tail = primary_probe_directory;
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams primary queue capture mode={} groups={} roots={} counter={}->{} "
+                    "published={} duplicates={} invalid={} descending={} files_ok={} dir={}",
+                    order_primary_queue ? "ordered" : "native", cs_program.dim_x,
+                    primary_probe_root_count, begin, end, post[321], audit.duplicate_roots,
+                    audit.invalid_roots, audit.descending_roots, primary_probe_files_ok,
+                    primary_probe_directory.string());
+    } else if (cs.pgm_hash == 0x77179b49 && !primary_probe.pending_tail.empty()) {
+        std::array<u32, 384> tail{};
+        bool ok = ReadPrimaryQueueProbeGds(scheduler, buffer_cache, tail);
+        u64 ignored_hash{};
+        ok &= WriteDreamsCaptureWords(primary_probe.pending_tail / "gds-frame-tail.bin",
+                                     tail, ignored_hash);
+        ok &= WriteDreamsCaptureText(primary_probe.pending_tail / "tail-sequence.txt",
+                                    fmt::format("{}\n", g_compute_dispatch_sequence));
+        WriteDreamsCaptureText(primary_probe.pending_tail / "tail-complete.txt",
+                              ok ? "complete\n" : "failed\n");
+        primary_probe.pending_tail.clear();
+    }
+    ResetBindings(true);
+}
