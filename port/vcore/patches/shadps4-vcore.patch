new file mode 100644
index 0000000000000000000000000000000000000000..4d8c676d33c0145ebcac0d11b8bfc2094d86bd5b
--- /dev/null
+++ b/src/common/dreams_frame_fence_read.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstring>
+#include <limits>
+#include "common/arch.h"
+#include "common/types.h"
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace Common {
+// Complete only four verified ordinary MOV loads in Dreams' completion loop. The caller
+// must serialize the read and refuse bytes modified by the GPU or image aliases.
+inline bool TryHandleDreamsFrameFenceRead(void* context, VAddr fault_address,
+                                        uintptr_t guest_base, void* userdata,
+                                        bool (*read)(void*, VAddr, void*, u32), u32* handled_site = nullptr) {
+#if defined(_WIN32) && defined(ARCH_X86_64)
+    constexpr uintptr_t CodeOffset = 0xc54455;
+    constexpr uintptr_t SecondOffset = 0xc54470;
+    constexpr uintptr_t IndexedOffset = 0xc543fb;
+    constexpr uintptr_t FieldOffset = 0xc5450c;
+    if (!context || !read || !guest_base ||
+        guest_base > std::numeric_limits<uintptr_t>::max() - FieldOffset) return false;
+    const auto* exception = static_cast<EXCEPTION_POINTERS*>(context);
+    if (!exception->ExceptionRecord || !exception->ContextRecord ||
+        exception->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION ||
+        exception->ExceptionRecord->NumberParameters < 2 ||
+        exception->ExceptionRecord->ExceptionInformation[0] != 0) return false;
+    auto& registers = *exception->ContextRecord;
+    const bool indexed = registers.Rip == guest_base + IndexedOffset;
+    const bool field = registers.Rip == guest_base + FieldOffset;
+    if (indexed || field) {
+        constexpr std::array<u8,16> IndexedSignature = {0x4b,0x8b,0x4,0x26,0x4c,0x39,0xe8,0x74,0x59,0x4d,0x1,0xe6,0x4c,0x8d,0xbc,0x24};
+        constexpr std::array<u8,16> FieldSignature = {0x8b,0x80,0x40,0x12,0x0,0x0,0x89,0x5,0x40,0x57,0xdd,0x6,0x74,0xc,0xe8,0xe1};
+        const auto& expected = indexed ? IndexedSignature : FieldSignature;
+        if (std::memcmp(reinterpret_cast<const void*>(registers.Rip), expected.data(), expected.size()) != 0) return false;
+        const u64 base = indexed ? registers.R14 : registers.Rax;
+        const u64 offset = indexed ? registers.R12 : 0x1240;
+        if (base > std::numeric_limits<u64>::max() - offset) return false;
+        const VAddr address = base + offset;
+        const u32 size = indexed ? 8 : 4;
+        if (address >= (u64{1} << 40) || address % size || fault_address < address ||
+            fault_address - address >= size) return false;
+        u64 value{};
+        if (!read(userdata, address, &value, size)) return false;
+        registers.Rax = indexed ? value : static_cast<u32>(value); // EAX zero-extends.
+        registers.Rip += indexed ? 4 : 6;
+        if (handled_site) *handled_site = indexed ? 3 : 4;
+        return true;
+    }
+    const bool second = registers.Rip == guest_base + SecondOffset;
+    if (!second && registers.Rip != guest_base + CodeOffset) return false;
+    constexpr std::array<u8, 16> Signature = {0x49, 0x8b, 0x06, 0x4c, 0x39, 0xe8, 0x75, 0xc3, 0x4c, 0x03, 0x25, 0xf4, 0x24, 0xc4, 0x06, 0x66};
+    constexpr std::array<u8, 16> SecondSignature = {0x49, 0x8b, 0x04, 0x24, 0x4c, 0x39, 0xe8, 0x75, 0xf7, 0xe8, 0xf2, 0x39, 0x9a, 0x00, 0x48, 0x01};
+    const auto& expected = second ? SecondSignature : Signature;
+    if (std::memcmp(reinterpret_cast<const void*>(registers.Rip), expected.data(),
+                    Signature.size()) != 0) return false;
+    const VAddr address = second ? registers.R12 : registers.R14;
+    if (address >= (u64{1} << 40) || address % 8 || fault_address < address ||
+        fault_address - address >= sizeof(u64)) return false;
+    u64 value{};
+    if (!read(userdata, address, &value, sizeof(value))) return false;
+    // MOV preserves flags and all registers except its destination.
+    registers.Rax = value;
+    registers.Rip += second ? 4 : 3;
+    if (handled_site) *handled_site = second ? 2 : 1;
+    return true;
+#else
+    return false;
+#endif
+}
+} // namespace Common
diff --git a/src/common/dreams_title.h b/src/common/dreams_title.h
new file mode 100644
index 0000000000000000000000000000000000000000..59b4f1b28e20e4007901f47edca493bf9bedffee
--- /dev/null
+++ b/src/common/dreams_title.h
@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstdlib>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Common {
+
+// The Dreams-ShadPS4 fork gated its Dreams-only paths on the serial CUSA04301 (the copy it was
+// tested with, VERSION 02.64). Other Dreams releases use other serials. This helper accepts the
+// known ones plus any listed in SHADPS4_DREAMS_TITLE_IDS (comma separated).
+// NOTE: accepting a serial only enables the code paths. Most of them are additionally keyed on
+// shader hashes or exact guest instruction bytes captured from CUSA04301 02.64, which differ
+// across game builds, so those stay inert until remapped for the build actually in use.
+inline bool IsDreamsSerial(std::string_view serial) {
+    if (serial == "CUSA04301" || serial == "CUSA08010") {
+        return true;
+    }
+    static const std::vector<std::string> extra = [] {
+        std::vector<std::string> ids;
+        if (const char* env = std::getenv("SHADPS4_DREAMS_TITLE_IDS")) {
+            std::string_view list{env};
+            while (!list.empty()) {
+                const auto comma = list.find(',');
+                const auto item = list.substr(0, comma);
+                if (!item.empty()) {
+                    ids.emplace_back(item);
+                }
+                if (comma == std::string_view::npos) {
+                    break;
+                }
+                list.remove_prefix(comma + 1);
+            }
+        }
+        return ids;
+    }();
+    for (const auto& id : extra) {
+        if (serial == id) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Comparison token so existing `serial == ::Common::DreamsTitleId{}` checks can read
+// `serial == Common::DreamsTitleId{}` without restructuring the expression.
+struct DreamsTitleId {};
+inline bool operator==(std::string_view serial, DreamsTitleId) {
+    return IsDreamsSerial(serial);
+}
+
+} // namespace Common
