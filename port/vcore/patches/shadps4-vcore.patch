+    files_ok &=
+        write_bytes("upstream-dispatches.tsv",
+                    std::span<const u8>{reinterpret_cast<const u8*>(upstream_dispatches.data()),
+                                        upstream_dispatches.size()});
+    std::string b535_b4_writers =
+        "rank_newest\twriter_sequence\tdispatch_sequence\tdispatch_age\tshader_hash\tstage\t"
+        "kind\tbinding\tdeclared_write\tbase\tsize\tstride\tsource\toverlap_base\t"
+        "overlap_size\texact_base\texact_range\tdescriptor_target_mask\t"
+        "descriptor_target_count\n";
+    for (u32 rank = 0; rank < capture.traversal_pass0_b4_writers.size(); ++rank) {
+        const auto& match = capture.traversal_pass0_b4_writers[rank];
+        const auto& writer = match.writer;
+        const VAddr overlap_base = std::max(capture.traversal_pass0_b4_base, writer.base);
+        const VAddr overlap_end =
+            std::min(capture.traversal_pass0_b4_base + capture.traversal_pass0_b4_size,
